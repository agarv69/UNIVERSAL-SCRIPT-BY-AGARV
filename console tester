local VERSION = 160

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local DELETE_RADIUS = 24
local monitoring = true

print("Delete Detector Running [ID "..VERSION.."]")

local function holdingDelete(player)
	local char = player.Character
	if not char then return false end
	for _, obj in pairs(char:GetChildren()) do
		if obj:IsA("Tool") and obj.Name:lower():find("delete") then
			return true
		end
	end
	return false
end

local function getBrickOwner(brick)
	if not brick:IsDescendantOf(workspace.Bricks) then
		return nil
	end
	
	local parent = brick.Parent
	if not parent then return nil end
	
	if parent.Parent == workspace.Bricks then
		return parent.Name
	end
	
	return nil
end

workspace.DescendantRemoving:Connect(function(obj)
	if not monitoring then return end
	if not obj:IsA("BasePart") then return end
	if obj.Name ~= "Brick" then return end
	
	local ownerName = getBrickOwner(obj)
	if not ownerName then return end
	
	local pos = obj.Position
	local closest = nil
	local closestDist = DELETE_RADIUS
	
	for _, player in pairs(Players:GetPlayers()) do
		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local dist = (char.HumanoidRootPart.Position - pos).Magnitude
			if dist <= closestDist and holdingDelete(player) then
				closestDist = dist
				closest = player
			end
		end
	end
	
	if closest and closest.Name ~= ownerName then
		print(closest.Name .. " griefed " .. ownerName)
	end
end)

LocalPlayer.Chatted:Connect(function(msg)
	if msg == ";stop" then
		monitoring = false
		print("Stopped [ID "..VERSION.."]")
	end
end)
