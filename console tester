local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local bricksFolder = workspace:WaitForChild("Bricks")

local monitoring = true
local DETECTION_DISTANCE = 30

print("Delete Detector Running")

LocalPlayer.Chatted:Connect(function(msg)
	if msg:lower() == ";stop" then
		monitoring = false
		print("Stopped")
	end
end)

local function holdingDelete(player)
	local char = player.Character
	if not char then return false end
	
	local tool = char:FindFirstChild("Delete")
	if tool and tool:IsA("Tool") then
		return true
	end
	
	return false
end

local function closestDeleteHolder(position)
	local closest = nil
	local closestDist = math.huge
	
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				if holdingDelete(player) then
					local dist = (char.HumanoidRootPart.Position - position).Magnitude
					if dist < closestDist then
						closestDist = dist
						closest = player
					end
				end
			end
		end
	end
	
	return closest, closestDist
end

workspace.DescendantRemoving:Connect(function(obj)
	if not monitoring then return end
	
	if obj:IsA("BasePart") and obj.Name == "Brick" and obj:IsDescendantOf(bricksFolder) then
		
		local lastPosition = obj.Position
		
		task.wait(0.03)
		
		local player, distance = closestDeleteHolder(lastPosition)
		
		if player and distance <= DETECTION_DISTANCE then
			print(player.Name .. " detected")
		end
		
	end
end)
