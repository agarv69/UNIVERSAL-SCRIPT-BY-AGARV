local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local LocalPlayer = Players.LocalPlayer

local isRunning = false
local stopped = false
local jumpConn = nil

-- ============================================================
-- SYSTEM MESSAGE HELPER
-- ============================================================
local function systemMessage(text)
	local existing = LocalPlayer.PlayerGui:FindFirstChild("SystemMsg_" .. text)
	if existing then return end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SystemMsg_" .. text
	screenGui.ResetOnSpawn = false
	screenGui.Parent = LocalPlayer.PlayerGui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 30)
	label.Position = UDim2.new(0, 0, 0.85, 0)
	label.BackgroundTransparency = 1
	label.Text = "[System]: " .. text
	label.TextColor3 = Color3.fromRGB(255, 255, 0)
	label.TextSize = 16
	label.Font = Enum.Font.GothamSemibold
	label.ZIndex = 999
	label.Parent = screenGui

	task.delay(5, function()
		screenGui:Destroy()
	end)
end

-- ============================================================
-- STOP
-- ============================================================
local function stop()
	if stopped then return end
	stopped = true
	isRunning = false
	if jumpConn then
		jumpConn:Disconnect()
		jumpConn = nil
	end
	systemMessage("Stopped")
end

-- ============================================================
-- START JUMP SPAM
-- ============================================================
local function start()
	if stopped or isRunning then return end
	isRunning = true

	jumpConn = RunService.Heartbeat:Connect(function()
		if not isRunning then return end
		local char = LocalPlayer.Character
		if not char then return end
		local hum = char:FindFirstChildWhichIsA("Humanoid")
		if not hum then return end
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end)
end

-- ============================================================
-- CHAT COMMANDS
-- ============================================================
-- try new chat system first
local ok = pcall(function()
	TextChatService.OnIncomingMessage = function(msg)
		if msg.TextSource and msg.TextSource.UserId == LocalPlayer.UserId then
			local text = msg.Text:lower()
			if text == ";fling" then
				if not stopped then start() end
			elseif text == ";stop" then
				stop()
			end
		end
		return nil
	end
end)

-- fallback to old chat system
if not ok then
	LocalPlayer.Chatted:Connect(function(msg)
		local cmd = msg:lower()
		if cmd == ";fling" then
			if not stopped then start() end
		elseif cmd == ";stop" then
			stop()
		end
	end)
end

-- ============================================================
-- ON EXECUTE
-- ============================================================
systemMessage("Executed (3)")
