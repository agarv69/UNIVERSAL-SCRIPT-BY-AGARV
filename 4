local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local toolsToEquip = {
	"Build",
	"Delete",
	"Paint",
	"Shape",
	"Shovel",
	"Sign"
}

local function shouldEquip(toolName)
	for _, name in pairs(toolsToEquip) do
		if toolName == name then
			return true
		end
	end
	return false
end

local function equipAllTools()
	if not LocalPlayer.Character then return end
	
	for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
		if tool:IsA("Tool") and shouldEquip(tool.Name) then
			tool.Parent = LocalPlayer.Character
		end
	end
end

-- Equip existing tools
equipAllTools()

-- Auto-equip when new tools are added to backpack
LocalPlayer.Backpack.ChildAdded:Connect(function(tool)
	if tool:IsA("Tool") and shouldEquip(tool.Name) then
		task.wait(0.1)
		tool.Parent = LocalPlayer.Character
	end
end)

-- Re-equip when character respawns
LocalPlayer.CharacterAdded:Connect(function(character)
	task.wait(1) -- Wait for backpack to load
	
	equipAllTools()
	
	-- Listen for new tools after respawn
	LocalPlayer.Backpack.ChildAdded:Connect(function(tool)
		if tool:IsA("Tool") and shouldEquip(tool.Name) then
			task.wait(0.1)
			tool.Parent = LocalPlayer.Character
		end
	end)
end)

print("Auto-equip all script loaded! Will equip all: Build, Delete, Paint, Shape, Shovel, Sign")
