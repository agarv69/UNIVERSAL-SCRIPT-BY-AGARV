-- Make UI draggable
local dragging = false
local dragInput, mousePos, framePos

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        mousePos = input.Position
        framePos = mainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - mousePos
        mainFrame.Position = UDim2.new(
            framePos.X.Scale,
            framePos.X.Offset + delta.X,
            framePos.Y.Scale,
            framePos.Y.Offset + delta.Y
        )
    end
end)

-- Function to send message in chat
local function sendChatMessage(message)
    local success, err = pcall(function()
        -- Try new TextChatService first (newer Roblox)
        local TextChatService = game:GetService("TextChatService")
        local textChannels = TextChatService:WaitForChild("TextChannels", 2)
        
        if textChannels then
            local generalChannel = textChannels:FindFirstChild("RBXGeneral")
            if generalChannel then
                generalChannel:SendAsync(message)
                return
            end
        end
        
        -- Fallback to legacy chat
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local chatEvents = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 2)
        if chatEvents then
            local sayMessage = chatEvents:WaitForChild("SayMessageRequest", 2)
            if sayMessage then
                sayMessage:FireServer(message, "All")
            end
        end
    end)
    
    if not success then
        warn("Failed to send chat message:", err)
    else
        print("Sent '67' in chat")
    end
end

-- Function to get a different server
local function getRandomServer()
    local placeId = game.PlaceId
    local currentJobId = game.JobId
    
    -- Get server list
    local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Desc&limit=100"
    
    local servers
    if request then
        -- Use request if available (better compatibility)
        local response = request({Url = url})
        servers = HttpService:JSONDecode(response.Body).data
    else
        -- Fallback to HttpGet
        servers = HttpService:JSONDecode(game:HttpGet(url)).data
    end
    
    -- Find a server that's not full and not the current one
    if servers then
        for i, server in pairs(servers) do
            if type(server) == "table" and server.id and server.maxPlayers and server.playing then
                if server.id ~= currentJobId and tonumber(server.playing) < tonumber(server.maxPlayers) then
                    return server.id
                end
            end
        end
    end
    
    return nil
end

