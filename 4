		if isGodModeOn() then
			btnLabel.Text = "Disable God Mode to Reset"
			btnLabel.TextColor3 = WHITE
			btnLabel.TextScaled = true
			btnLabel.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
			btnLabel.BackgroundTransparency = 0
			btnLabel.BorderSizePixel = 0
			local stroke = btnLabel:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke", btnLabel)
			stroke.Color = Color3.fromRGB(57, 57, 57)
			stroke.Thickness = 1
			holding = false
			return
		end
	
		holding = true
		progress = 0
		btnLabel.Text = "Hold to Reset..."
		fillBar.BackgroundColor3 = GREY
	
		connection = RunService.RenderStepped:Connect(function(dt)
			if not holding then return end
			progress = progress + (dt / HOLD_TIME)
			progress = math.clamp(progress, 0, 1)
			fillBar.Size = UDim2.new(progress, 0, 1, 0)
	
			if progress >= 1 then
				btnLabel.Text = "Resetting..."
				stopHold()
				task.wait(0.1)
				reset()
			end
		end)
	end)
	
	ResetButton.MouseButton1Up:Connect(function()
		stopHold()
	end)
	
	ResetButton.MouseLeave:Connect(function()
		stopHold()
	end)
end;
