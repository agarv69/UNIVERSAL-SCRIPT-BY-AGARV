				TweenService:Create(notifData.frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = UDim2.new(0, 0, yOffset, 0)  -- Changed from 10 to 0 (no left gap)
				}):Play()
	
