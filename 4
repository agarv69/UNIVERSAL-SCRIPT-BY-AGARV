	local bangAnim = nil
	local bang = nil
	local bangDied = nil
	local bangLoop = nil
	local isBanging = false
	
	-- ============================================================
	-- FIND MONKEYTITLE
	-- ============================================================
	local function getScreenGui()
		local p = script.Parent
		while p do
			if p:IsA("ScreenGui") then
				return p
			end
			p = p.Parent
		end
	end
	
	local function findDescendant(name)
		local ScreenGui = getScreenGui()
		if not ScreenGui then return nil end
		for _, v in pairs(ScreenGui:GetDescendants()) do
			if v.Name == name then
				return v
			end
		end
	end
	
	local MonkeyTitle = findDescendant("MonkeyTitle")
	
	local function isNoclipped(player)
		local character = player.Character
		if not character then return false end
	
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end
	
		return hrp.CollisionGroup == "NoClip"
	end
	
	local function isFrozen(player)
		local character = workspace:FindFirstChild(player.Name)
		if not character then return false end
	
		return character:FindFirstChild("Hielo") ~= nil
	end
	
	local function isAdmin(player)
		return player.Team and player.Team.Name == "Chosen"
	end
	
	local function getAdmins()
		local admins = {}
		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and isAdmin(player) then
				table.insert(admins, player)
			end
		end
		return admins
	end
	
	local function getTorso(character)
		character = character or LocalPlayer.Character
		return character:FindFirstChild("Torso") 
			or character:FindFirstChild("UpperTorso") 
			or character:FindFirstChild("LowerTorso") 
			or character:FindFirstChild("HumanoidRootPart")
	end
	
	local function stopBang()
		if bangDied then bangDied:Disconnect() end
		if bang then bang:Stop() end
		if bangAnim then bangAnim:Destroy() end
		if bangLoop then bangLoop:Disconnect() end
		bangDied = nil
