local function C_b()
local script = G2L["b"];
	-- ADD OR REMOVE FRAMES HERE
	local framesToScale = {
		script.Parent.MainFrame,
	}
	
	-- Configuration
	local BASE_WIDTH = 500
	local BASE_HEIGHT = 350
	local MAX_WIDTH = 550
	local MAX_HEIGHT = 400
	
	-- Store original transparencies
	local originalData = {}
	
	local function storeAndHide(obj)
		originalData[obj] = {}
	
		if obj:IsA("GuiObject") then
			originalData[obj].BackgroundTransparency = obj.BackgroundTransparency
			obj.BackgroundTransparency = 1
		end
	
		if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
			originalData[obj].TextTransparency = obj.TextTransparency
			obj.TextTransparency = 1
		end
	
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			originalData[obj].ImageTransparency = obj.ImageTransparency
			obj.ImageTransparency = 1
		end
	end
	
	-- Hide MainFrame and all descendants
	storeAndHide(script.Parent.MainFrame)
	for _, descendant in pairs(script.Parent.MainFrame:GetDescendants()) do
		storeAndHide(descendant)
	end
	
	-- Convert all children to Scale
	local function convertToScale(frame)
		local baseWidth = frame.AbsoluteSize.X
		local baseHeight = frame.AbsoluteSize.Y
	
		for _, child in pairs(frame:GetDescendants()) do
			if child:IsA("GuiObject") and child ~= frame then
				if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
					child:SetAttribute("OriginalTextSize", child.TextSize)
				end
	
				local pixelWidth = child.AbsoluteSize.X
				local pixelHeight = child.AbsoluteSize.Y
				child.Size = UDim2.new(pixelWidth / baseWidth, 0, pixelHeight / baseHeight, 0)
	
				local pixelX = child.AbsolutePosition.X - frame.AbsolutePosition.X
				local pixelY = child.AbsolutePosition.Y - frame.AbsolutePosition.Y
				child.Position = UDim2.new(pixelX / baseWidth, 0, pixelY / baseHeight, 0)
			end
		end
	
		frame:SetAttribute("OriginalWidth", frame.AbsoluteSize.X)
		frame:SetAttribute("AspectRatio", frame.AbsoluteSize.X / frame.AbsoluteSize.Y)
	end
	
	local function rescaler()
		local viewportSize = workspace.CurrentCamera.ViewportSize
		local screenX = viewportSize.X
		local screenY = viewportSize.Y
		local isMobile = screenX < 600
	
		for _, frame in pairs(framesToScale) do
			local aspectRatio = frame:GetAttribute("AspectRatio")
			local newWidth
	
			if isMobile then
				newWidth = math.clamp(screenX * 0.55, 280, 320)
			else
				newWidth = math.clamp(screenX * 0.35, 450, MAX_WIDTH)
			end
	
			local newHeight = newWidth / aspectRatio
	
			frame.AnchorPoint = Vector2.new(0.5, 0.5)
			frame.Size = UDim2.new(0, newWidth, 0, newHeight)
			frame.Position = UDim2.new(0.5, 0, 0.52, 0)
	
			local scaleFactor = newWidth / frame:GetAttribute("OriginalWidth")
			for _, descendant in pairs(frame:GetDescendants()) do
				if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
					local originalSize = descendant:GetAttribute("OriginalTextSize")
					if originalSize then
						descendant.TextSize = math.floor(originalSize * scaleFactor)
					end
				end
			end
		end
	end
	
	for _, frame in pairs(framesToScale) do
		convertToScale(frame)
	end
	
	rescaler()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescaler)
	
	-- Fade in everything
	local TweenService = game:GetService("TweenService")
	
	for obj, data in pairs(originalData) do
		local tweenProps = {}
	
		if data.BackgroundTransparency then
			tweenProps.BackgroundTransparency = data.BackgroundTransparency
		end
		if data.TextTransparency then
			tweenProps.TextTransparency = data.TextTransparency
		end
		if data.ImageTransparency then
			tweenProps.ImageTransparency = data.ImageTransparency
		end
	
		if next(tweenProps) then
			TweenService:Create(obj, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), tweenProps):Play()
		end
	end
end;
