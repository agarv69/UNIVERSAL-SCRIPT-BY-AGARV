local Player = game:GetService("Players").LocalPlayer
local RunService = game:GetService("RunService")

local radius = 5
local speed = 2
local heightOffset = 0
local angle = 0

-- Set simulation radius
pcall(function()
    sethiddenproperty(Player, "SimulationRadius", 9999)
end)

local function startOrbit()
	local Character = Player.Character
	if not Character then return end
	
	local rootPart = Character:FindFirstChild("HumanoidRootPart")
	local boombox = Character:FindFirstChild("SuperFlyGoldBoombox")
	
	if not boombox or not rootPart then return end
	
	local handle = boombox:FindFirstChild("Handle")
	if not handle then return end
	
	-- Destroy grip weld
	for _, child in pairs(handle:GetChildren()) do
		if child:IsA("Weld") then
			child:Destroy()
		end
	end
	
	-- Set physics properties
	handle.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 0, 0, 0)
	handle.CanCollide = false
	handle.CanTouch = false
	
	-- Create BodyPosition
	local bp = Instance.new("BodyPosition")
	bp.Name = "bp"
	local m = handle:GetMass()
	bp.P = m / 0.64e-5
	bp.D = m / 0.64e-3
	bp.MaxForce = Vector3.new(m / 0.64e-6, m / 0.64e-6, m / 0.64e-6)
	bp.Parent = handle
	
	-- Orbit loop
	RunService.Heartbeat:Connect(function()
		if not boombox or not handle or not rootPart then return end
		if boombox.Parent ~= Character then return end
		
		angle = angle + (speed * RunService.Heartbeat:Wait())
		
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		
		bp.Position = rootPart.Position + Vector3.new(x, heightOffset, z)
	end)
end

-- Wait for boombox to be equipped
Player.CharacterAdded:Connect(function(character)
	character.ChildAdded:Connect(function(child)
		if child.Name == "SuperFlyGoldBoombox" then
			task.wait(0.2)
			startOrbit()
		end
	end)
end)

if Player.Character then
	local boombox = Player.Character:FindFirstChild("SuperFlyGoldBoombox")
	if boombox then
		startOrbit()
	end
	
	Player.Character.ChildAdded:Connect(function(child)
		if child.Name == "SuperFlyGoldBoombox" then
			task.wait(0.2)
			startOrbit()
		end
	end)
end
