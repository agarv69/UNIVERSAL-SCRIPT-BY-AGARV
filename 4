local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local toolsToEquip = {
	"Build",
	"Delete",
	"Paint",
	"Shape",
	"Shovel",
	"Sign"
}

local function shouldEquip(toolName)
	for _, name in pairs(toolsToEquip) do
		if toolName == name then
			return true
		end
	end
	return false
end

local function equipTool(tool)
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
		LocalPlayer.Character.Humanoid:EquipTool(tool)
	end
end

-- Check existing tools in backpack
for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
	if tool:IsA("Tool") and shouldEquip(tool.Name) then
		equipTool(tool)
	end
end

-- Auto-equip when new tools are added to backpack
LocalPlayer.Backpack.ChildAdded:Connect(function(tool)
	if tool:IsA("Tool") and shouldEquip(tool.Name) then
		task.wait(0.1) -- Small delay to ensure it's fully loaded
		equipTool(tool)
	end
end)

-- Re-equip when character respawns
LocalPlayer.CharacterAdded:Connect(function(character)
	character:WaitForChild("Humanoid")
	
	task.wait(1) -- Wait for backpack to load
	
	for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
		if tool:IsA("Tool") and shouldEquip(tool.Name) then
			equipTool(tool)
		end
	end
	
	-- Listen for new tools after respawn
	LocalPlayer.Backpack.ChildAdded:Connect(function(tool)
		if tool:IsA("Tool") and shouldEquip(tool.Name) then
			task.wait(0.1)
			equipTool(tool)
		end
	end)
end)

print("Auto-equip script loaded! Will auto-equip: Build, Delete, Paint, Shape, Shovel, Sign")
