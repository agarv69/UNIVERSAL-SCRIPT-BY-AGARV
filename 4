	local function watchToxifyFolder(folder)
		folder.ChildAdded:Connect(function(child)
			if child.Name ~= "Brick" then return end
	
			child:GetPropertyChangedSignal("Material"):Connect(function()
				if child.Material ~= Enum.Material.Neon then return end
	
				local paintedAt = tick()
				local brickPos = child.Position
				local ownerName = folder.Name
	
				task.delay(MAX_DELAY, function()
					if not Enabled then return end
	
					local player = getBestCandidate(recentPaintSound, paintedAt)
					if not player then return end
	
					local isSelf = player.Name == ownerName
					if isSelf then return end
	
					local hrp = getHRP(player)
					local magNum = hrp and (hrp.Position - brickPos).Magnitude or 0
					local count = getCount(player.UserId, "toxify", paintedAt)
	
					checkAuraExploit(player, count, magNum, "toxify")
				end)
			end)
		end)
