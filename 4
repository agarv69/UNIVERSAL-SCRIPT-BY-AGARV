		["exploit"]  = "GRIEF AURA",
	}
	
	local alertMessages = {
		["delete"]   = "⚠️%s IS GRIEVING",
		["toxify"]   = "⚠️%s IS SPAMMING TOXIFY",
		["unanchor"] = "⚠️%s IS SPAMMING UNANCHOR",
		["build"]    = "⚠️%s IS SPAMMING BLOCKS",
