					if not player then return end
	
					local isSelf = player.Name == ownerName
					if isSelf then return end
	
					local hrp = getHRP(player)
					local magNum = hrp and (hrp.Position - brickPos).Magnitude or 0
					local count = getCount(player.UserId, "unanchor", unanchoredAt)
	
