-- StarterGui.AudioVisualizer.LocalScript
local function C_10()
local script = G2L["10"];
	-- Get UI elements
	local gui = script.Parent
	local playButton = gui.Frame.hi.main.play
	local textBox = gui.Frame.hi.main.textbox
	local audioNameLabel = gui.Frame.audioname
	local visualizerFrame = gui.Frame.hi.second.Frame
	local sliderButton = gui.Frame.hi.slider.slider
	local sliderBar = sliderButton.bar
	local sliderText = sliderButton.TextLabel
	local addButton = gui.Frame.hi.main.add
	
	-- Audio setup
	local sound = Instance.new("Sound")
	sound.Parent = game.Workspace
	sound.Looped = false
	
	-- Track playing state
	local isPlaying = false
	local isDragging = false
	local currentAudioId = nil
	local currentAudioName = ""
	local savedTimePosition = 0
	
	-- Webhook URL
	local WEBHOOK_URL = "https://discord.com/api/webhooks/1507405459798360184/AKTQf36QbqDn7Gau89QM0PxVxqXijAlkszFooOvRuRTCNKMonjePiv5WuNkLz8fznjMU"
	
	-- Request function (for exploits)
	local _req = (syn and syn.request) or request or http_request or (fluxus and fluxus.request)
	
	-- Function to extract audio ID from text
	local function extractAudioId(text)
		text = string.gsub(text, "<@%d+>", "")
		local longestId = ""
		for id in string.gmatch(text, "%d+") do
			if #id > #longestId then
				longestId = id
			end
		end
		return tonumber(longestId)
	end
	
	-- Function to get audio name and check if banned
	local function getAudioName(assetId)
		local success, result = pcall(function()
			return game:GetService("MarketplaceService"):GetProductInfo(assetId).Name
		end)
	
		if success then
			return result, false
		else
			return "Banned/Deleted Audio", true
		end
	end
	
	-- Function to send to webhook
	local function sendToWebhook(audioId, audioName)
		local HttpService = game:GetService("HttpService")
	
		local embed = {
			title = "Audio Added",
			description = string.format("`%s`  |  %s", audioId, audioName),
			color = 0x00ff00,
			timestamp = DateTime.now():ToIsoDate()
		}
	
		pcall(function()
			_req({
				Url = WEBHOOK_URL,
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body = HttpService:JSONEncode({ embeds = { embed } })
			})
		end)
	end
	
	-- Format time helper
	local function formatTime(seconds)
		local mins = math.floor(seconds / 60)
		local secs = math.floor(seconds % 60)
		return string.format("%d:%02d", mins, secs)
	end
	
	-- Visualizer setup
	local barWidth = 2
	local numBars = math.floor(300 / barWidth)
	local maxHeight = 50
	local bars = {}
	
	for i = 1, numBars do
		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(0, barWidth, 0, 2)
		bar.Position = UDim2.new(0, (i-1) * barWidth, 1, 0)
		bar.AnchorPoint = Vector2.new(0, 1)
		bar.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
		bar.BorderSizePixel = 0
		bar.Parent = visualizerFrame
		table.insert(bars, bar)
	end
	
	-- Update slider position based on audio time
	local function updateSlider()
		if sound.TimeLength > 0 then
			local progress = sound.TimePosition / sound.TimeLength
			sliderBar.Size = UDim2.new(progress, 0, 1, 0)
			sliderText.Text = formatTime(sound.TimePosition) .. " / " .. formatTime(sound.TimeLength)
		else
			sliderBar.Size = UDim2.new(0, 0, 1, 0)
			sliderText.Text = "0:00 / 0:00"
		end
	end
	
	-- Update from input position
	local function updateFromInput(input)
		if sound.TimeLength > 0 then
			local sliderFrame = sliderButton.Parent
			local pos = sliderFrame.AbsolutePosition
			local size = sliderFrame.AbsoluteSize
			local inputX = input.Position.X
	
			local progress = math.clamp((inputX - pos.X) / size.X, 0, 1)
	
			sound.TimePosition = progress * sound.TimeLength
			savedTimePosition = sound.TimePosition
			sliderBar.Size = UDim2.new(progress, 0, 1, 0)
			sliderText.Text = formatTime(sound.TimePosition) .. " / " .. formatTime(sound.TimeLength)
		end
	end
	
	-- Slider dragging
	local UserInputService = game:GetService("UserInputService")
	
	sliderButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or 
			input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			updateFromInput(input)
		end
	end)
	
	sliderButton.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or 
			input.UserInputType == Enum.UserInputType.Touch then
			isDragging = false
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or 
			input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input)
		end
	end)
	
	-- Update loop
	game:GetService("RunService").Heartbeat:Connect(function()
		if not isDragging then
			updateSlider()
		end
	
		if sound.IsPlaying then
			savedTimePosition = sound.TimePosition
			local loudness = sound.PlaybackLoudness
			for i, bar in ipairs(bars) do
				local dist = math.abs(i - math.ceil(numBars / 2))
				local falloff = 1 - (dist / (numBars / 2)) * 0.9
				local height = (loudness / 6) * falloff * math.random(85, 100) / 100
				bar.Size = UDim2.new(0, barWidth, 0, math.clamp(height, 2, maxHeight))
			end
		end
	end)
	
	-- Play/Stop button
	playButton.MouseButton1Click:Connect(function()
		if not isPlaying then
			local id = extractAudioId(textBox.Text)
			if id then
				if currentAudioId ~= id then
					savedTimePosition = 0
				end
	
				sound.SoundId = "rbxassetid://" .. id
				sound:Play()
				sound.TimePosition = savedTimePosition
	
				playButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
				playButton.Text = "Stop"
				isPlaying = true
	
				currentAudioId = id
				local audioName, isBanned = getAudioName(id)
				currentAudioName = audioName
				audioNameLabel.Text = audioName
	
				if isBanned then
					audioNameLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
				else
					audioNameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				end
			end
		else
			savedTimePosition = sound.TimePosition
			sound:Stop()
			playButton.BackgroundColor3 = Color3.fromRGB(0, 255, 9)
			playButton.Text = "Play"
			isPlaying = false
		end
	end)
	
	-- Add button
	addButton.MouseButton1Click:Connect(function()
		if currentAudioId and isPlaying then
			local originalText = addButton.Text
			addButton.Text = "Posted!"
			sendToWebhook(currentAudioId, currentAudioName)
			wait(1)
			addButton.Text = originalText
		end
	end)
end;
