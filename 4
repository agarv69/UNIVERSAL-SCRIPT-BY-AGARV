	local function setupButtonHover(button)
		local textLabel = button:FindFirstChild("Text")
		if not textLabel then return end
	
		local originalTextColor = textLabel.TextColor3
	
		button.MouseEnter:Connect(function()
			TweenService:Create(textLabel, TweenInfo.new(0.2), {
				TextColor3 = accentColor
			}):Play()
		end)
	
		button.MouseLeave:Connect(function()
			TweenService:Create(textLabel, TweenInfo.new(0.2), {
				TextColor3 = originalTextColor
			}):Play()
		end)
	
		button.MouseButton1Click:Connect(function()
			local shrink = TweenService:Create(button, TweenInfo.new(0.1), {
				Size = UDim2.new(0.95, 0, 0.95, 0)
			})
			shrink:Play()
	
			shrink.Completed:Connect(function()
				TweenService:Create(button, TweenInfo.new(0.1), {
					Size = UDim2.new(1, 0, 1, 0)
				}):Play()
			end)
		end)
	end
	
	-- Apply hover to existing buttons
	for _, child in pairs(keybindFrameMain:GetChildren()) do
		if child:IsA("TextButton") and (child.Name == "Drag" or child.Name == "HideGui" or child.Name == "LockGui" or child.Name == "More") then
			setupButtonHover(child)
		end
	end
	
	local function rescaler()
		local viewportSize = workspace.CurrentCamera.ViewportSize
		local screenX = viewportSize.X
		local screenY = viewportSize.Y
		local isMobile = screenX < 600
	
		local newWidth
		if isMobile then
			newWidth = math.clamp(screenX * 0.4, 150, 200)
		else
			newWidth = math.clamp(screenX * 0.15, 180, 250)
		end
	
		local newHeight = newWidth / ASPECT_RATIO
	
		keybindFrame.AnchorPoint = Vector2.new(1, 0)
		keybindFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
		keybindFrame.Position = UDim2.new(1, -PADDING_FROM_EDGE, 0, PADDING_FROM_EDGE)
	
		task.wait()
		arrangeButtonsInGrid()
		scaleAllText()
	end
	
	local viewportSize = workspace.CurrentCamera.ViewportSize
	local startWidth = math.clamp(viewportSize.X * 0.15, 180, 250)
	local startHeight = startWidth / ASPECT_RATIO
	
	keybindFrame.AnchorPoint = Vector2.new(1, 0)
	keybindFrame.Size = UDim2.new(0, startWidth, 0, startHeight)
	keybindFrame.Position = UDim2.new(1, 300, 0, PADDING_FROM_EDGE)
	
	arrangeButtonsInGrid()
	scaleAllText()
	
	local slideIn = TweenService:Create(
		keybindFrame,
		TweenInfo.new(1.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
		{Position = UDim2.new(1, -PADDING_FROM_EDGE, 0, PADDING_FROM_EDGE)}
	)
	slideIn:Play()
	
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescaler)
	keybindFrameMain:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		arrangeButtonsInGrid()
		scaleAllText()
	end)
	
	keybindFrame.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
			task.wait()
			if not descendant:GetAttribute("OriginalTextSize") then
				descendant:SetAttribute("OriginalTextSize", descendant.TextSize)
			end
			scaleAllText()
		end
	
		-- Setup hover for newly added buttons
		if descendant:IsA("TextButton") and descendant.Parent == keybindFrameMain then
			setupButtonHover(descendant)
		end
	end)
end;
