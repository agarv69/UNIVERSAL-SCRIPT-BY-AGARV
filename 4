-- Boombox Orbit Script (Working)
local RunService = game:GetService("RunService")
local player = game.Players.LocalPlayer

local radius = 5
local speed = 2
local heightOffset = 0
local angle = 0
local orbiting = false

local function startOrbit()
	local character = player.Character
	if not character then return end
	
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local boombox = character:FindFirstChild("SuperFlyGoldBoombox")
	
	if not boombox or not rootPart then return end
	
	local handle = boombox:FindFirstChild("Handle")
	if not handle then return end
	
	-- Destroy ALL attachments/welds
	for _, child in pairs(handle:GetDescendants()) do
		if child:IsA("Weld") or child:IsA("Motor6D") or child:IsA("Attachment") then
			child:Destroy()
		end
	end
	
	for _, child in pairs(handle:GetChildren()) do
		if child:IsA("Weld") or child:IsA("Motor6D") then
			child:Destroy()
		end
	end
	
	-- Make it physics-free
	handle.Massless = true
	handle.CanCollide = false
	handle.Anchored = false
	
	task.wait(0.1)
	
	if orbiting then return end
	orbiting = true
	
	RunService.Heartbeat:Connect(function(dt)
		if not boombox or boombox.Parent ~= character then
			orbiting = false
			return
		end
		
		if not handle or not rootPart then
			orbiting = false
			return
		end
		
		angle = angle + (speed * dt)
		
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		
		handle.CFrame = rootPart.CFrame * CFrame.new(x, heightOffset, z)
	end)
end

-- Wait for boombox to be equipped
player.CharacterAdded:Connect(function(character)
	character.ChildAdded:Connect(function(child)
		if child.Name == "SuperFlyGoldBoombox" then
			task.wait(0.5)
			startOrbit()
		end
	end)
end)

-- Check if already equipped
if player.Character then
	local boombox = player.Character:FindFirstChild("SuperFlyGoldBoombox")
	if boombox then
		task.wait(0.5)
		startOrbit()
	end
	
	player.Character.ChildAdded:Connect(function(child)
		if child.Name == "SuperFlyGoldBoombox" then
			task.wait(0.5)
			startOrbit()
		end
	end)
end
