-- Debug Script - Logs EVERYTHING that happens
local function logChange(changeType, object, details)
	local path = object:GetFullName()
	print(string.format("[%s] %s | %s", changeType, path, details or ""))
end

-- Watch for new instances added
game.DescendantAdded:Connect(function(obj)
	logChange("ADDED", obj, "ClassName: " .. obj.ClassName)
end)

-- Watch for instances removed
game.DescendantRemoving:Connect(function(obj)
	logChange("REMOVED", obj, "ClassName: " .. obj.ClassName)
end)

-- Watch for ancestry changes (moved to different parent)
game.DescendantAdded:Connect(function(obj)
	obj.AncestryChanged:Connect(function(child, parent)
		if parent then
			logChange("MOVED", obj, "New Parent: " .. parent:GetFullName())
		end
	end)
end)

-- Watch for property changes on ALL instances
local function watchProperties(obj)
	-- Common properties to watch
	local properties = {
		"Parent", "Name", "Position", "CFrame", "Size", "Text", 
		"Value", "Transparency", "Color", "BrickColor", "Material",
		"Anchored", "CanCollide", "Velocity", "Health", "WalkSpeed"
	}
	
	for _, prop in pairs(properties) do
		pcall(function()
			obj:GetPropertyChangedSignal(prop):Connect(function()
				local newValue = tostring(obj[prop])
				logChange("PROPERTY", obj, prop .. " = " .. newValue)
			end)
		end)
	end
end

-- Apply property watchers to everything
for _, obj in pairs(game:GetDescendants()) do
	watchProperties(obj)
end

-- Watch new objects for property changes too
game.DescendantAdded:Connect(function(obj)
	watchProperties(obj)
end)

print("[DEBUG] Logging all changes - check console!")
