-- Method 2: Delayed batch delete
local method2Active = true
task.spawn(function()
	while task.wait(0.05) do
		if not method2Active then continue end
		
		pcall(function()
			if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
			if not LocalPlayer.Character:FindFirstChild("Delete") then return end
			
			local deleteScript = LocalPlayer.Character.Delete:FindFirstChild("Script")
			if not deleteScript or not deleteScript:FindFirstChild("Event") then return end
			
			local myPos = LocalPlayer.Character.HumanoidRootPart.Position
			
			for _, block in pairs(workspace.Bricks:GetDescendants()) do
				if block:IsA("BasePart") and block.Name == "Brick" then
					local distance = (block.Position - myPos).Magnitude
					
					if distance <= deleteRange then
						task.spawn(function()
							pcall(function()
								-- Just use the actual block, not ReplicatedStorage.Brick
								deleteScript.Event:FireServer(block, block.Position)
							end)
						end)
					end
				end
			end
		end)
	end
end)

-- Method 3: Slower, batched deletes
local method3Active = true
task.spawn(function()
	while task.wait(0.2) do
		if not method3Active then continue end
		
		pcall(function()
			if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
			if not LocalPlayer.Character:FindFirstChild("Delete") then return end
			
			local deleteScript = LocalPlayer.Character.Delete:FindFirstChild("Script")
			if not deleteScript or not deleteScript:FindFirstChild("Event") then return end
			
			local myPos = LocalPlayer.Character.HumanoidRootPart.Position
			local blocksToDelete = {}
			
			for _, block in pairs(workspace.Bricks:GetDescendants()) do
				if block:IsA("BasePart") and block.Name == "Brick" then
					local distance = (block.Position - myPos).Magnitude
					if distance <= deleteRange then
						table.insert(blocksToDelete, {block, block.Position})
					end
				end
			end
			
			-- Delete in batches
			for i, data in ipairs(blocksToDelete) do
				if i > 50 then break end -- Limit to 50 per cycle
				
				local block = data[1]
				local pos = data[2]
				
				task.spawn(function()
					pcall(function()
						deleteScript.Event:FireServer(block, pos)
					end)
				end)
				
				task.wait(0.01)
			end
		end)
	end
end)

print("3 methods running simultaneously!")
print("Method 1: Every frame with coroutines")
print("Method 2: Every 0.05s with task.spawn")
print("Method 3: Every 0.2s, batched 50 blocks with delays")
print("Range: " .. deleteRange .. " studs")
