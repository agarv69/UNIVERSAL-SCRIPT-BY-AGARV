local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local isDeleting = true

-- Infinite range delete aura (TRUE infinite range, no tool equip needed)
task.spawn(function()
	while isDeleting do
		task.wait(0.05) -- Main loop delay
		
		-- Get delete tool from backpack OR character (doesn't matter)
		local deleteTool = LocalPlayer.Backpack:FindFirstChild("Delete") or 
		                   (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Delete"))
		
		if not deleteTool then continue end
		
		local deleteScript = deleteTool:FindFirstChild("Script")
		if not deleteScript or not deleteScript:FindFirstChild("Event") then continue end
		
		-- Get ALL blocks in the entire workspace
		for _, block in pairs(workspace.Bricks:GetDescendants()) do
			if block:IsA("BasePart") and block.Name == "Brick" then
				-- Fire delete event (server doesn't check range or if tool is equipped)
				pcall(function()
					deleteScript.Event:FireServer(block, block.Position)
				end)
			end
		end
	end
end)

print("True Infinite Delete Aura loaded!")
print("No range limit! Tool doesn't need to be equipped!")
