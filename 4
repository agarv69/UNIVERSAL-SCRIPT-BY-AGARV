				if player ~= LocalPlayer then
					-- Skip if already flinged
					if flingedPlayers[player] then
						continue
					end
	
					-- Don't fling players with NoClip
					if isNoclipped(player) then
						continue
					end
	
					-- Don't fling players with Hielo (frozen)
					if isFrozen(player) then
						continue
					end
	
					hasFlingTargets = true
	
					-- Stop banging if we have targets to fling
					if isBanging then
						stopBang()
					end
	
					-- Fling the player
					local success = flingPlayer(player)
	
					if success then
						flingedPlayers[player] = true
					end
				end
			end
	
			-- If no one to fling, bang admin
			if not hasFlingTargets then
				local character = LocalPlayer.Character
				if character then
					local rootPart = character:FindFirstChild("HumanoidRootPart")
					if rootPart then
						for _, obj in pairs(rootPart:GetChildren()) do
							if obj:IsA("BodyVelocity") then
								obj:Destroy()
							end
						end
	
						rootPart.Velocity = Vector3.new()
						rootPart.RotVelocity = Vector3.new()
					end
	
					local humanoid = character:FindFirstChildOfClass("Humanoid")
					if humanoid then
						humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
					end
				end
	
				local admins = getAdmins()
	
				if #admins > 0 then
					-- Switch admin every 1 second if there are multiple
					if #admins > 1 and tick() - lastAdminSwitchTime >= 1 then
						currentAdminIndex = currentAdminIndex + 1
						if currentAdminIndex > #admins then
							currentAdminIndex = 1
						end
						lastAdminSwitchTime = tick()
	
						if isBanging then
							stopBang()
							task.wait(0.1)
						end
					end
	
					local targetAdmin = admins[currentAdminIndex]
	
					if not isBanging then
						startBang(targetAdmin)
					end
				else
					if isBanging then
						stopBang()
					end
				end
			end
	
			task.wait(0.1)
		end
	end
	
