-- StarterGui.ScreenGui.GriefDetectorConsole
local function C_3()
local script = G2L["3"];
	local VERSION = 170
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local RunService = game:GetService("RunService")
	local DELETE_RADIUS = 25
	
	print("Delete Detector Running [ID "..VERSION.."]")
	
	-- ============================================================
	-- ACTIVATE LOGS UI
	-- ============================================================
	local ScreenGui = (function()
		local p = script.Parent
		while p do
			if p:IsA("ScreenGui") then return p end
			p = p.Parent
		end
	end)()
	
	local ActivateLogsTickBox = nil
	local ProtectionAccentColor = nil
	
	for _, desc in pairs(ScreenGui:GetDescendants()) do
		if desc.Name == "ActivateLogsRow" then
			ActivateLogsTickBox = desc:FindFirstChild("ActivateLogsTickBox")
			ProtectionAccentColor = desc.Parent:FindFirstChild("ProtectionAccentColor")
		end
	end
	
	local isActive = false
	
	if ActivateLogsTickBox then
		ActivateLogsTickBox.BackgroundColor3 = Color3.new(0, 0, 0)
		ActivateLogsTickBox.MouseButton1Click:Connect(function()
			isActive = not isActive
			if isActive then
				ActivateLogsTickBox.BackgroundColor3 = ProtectionAccentColor and ProtectionAccentColor.BackgroundColor3 or Color3.fromRGB(0, 170, 255)
				print("Delete Detector Activated")
			else
				ActivateLogsTickBox.BackgroundColor3 = Color3.new(0, 0, 0)
				print("Delete Detector Deactivated")
			end
		end)
	end
	
	-- ============================================================
	-- BRICK AGE TRACKING
	-- ============================================================
	local bricksFolder = workspace:WaitForChild("Bricks")
	
	local brickAge = {}
	
	-- all bricks before i joined = 10000 seconds old
	for _, obj in pairs(bricksFolder:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "Brick" then
			brickAge[obj] = tick() - 10000
		end
	end
	
	shared.GriefLog = ""
	shared.PaintLog = ""
	shared.BuildLog = ""
	shared.BKitLog = ""
	
	-- ============================================================
	-- SPAM BRICK IMMUNITY
	-- spamBricks[ownerName] = {brick = true, ...} 
	-- cleared 60 seconds after spam detected
	-- ============================================================
	local spamBricks = {}
	local spamBrickOwners = {}
	
	local function markSpamBricks(ownerName)
		spamBricks[ownerName] = spamBricks[ownerName] or {}
		local ownerFolder = bricksFolder:FindFirstChild(ownerName)
		if ownerFolder then
			for _, brick in pairs(ownerFolder:GetChildren()) do
				if brick:IsA("BasePart") and brick.Name == "Brick" then
					spamBricks[ownerName][brick] = true
				end
			end
		end
		spamBrickOwners[ownerName] = true
		-- clear immunity after 60 seconds
		task.delay(60, function()
			spamBricks[ownerName] = nil
			spamBrickOwners[ownerName] = nil
		end)
	end
	
	local function isSpamBrick(brick, ownerName)
		if spamBrickOwners[ownerName] then
			local ownerSpam = spamBricks[ownerName]
			if ownerSpam and ownerSpam[brick] then
				return true
			end
		end
		return false
	end
	
	-- Watch ReplicatedStorage.Brick for deletion
	local rs = game:GetService("ReplicatedStorage")
	local rsBrick = rs:FindFirstChild("Brick")
	
	local function holdingDelete(player)
		local char = player.Character
		if not char then return false end
		for _, obj in pairs(char:GetChildren()) do
			if obj:IsA("Tool") and obj.Name:lower():find("delete") then
				return true
			end
		end
		return false
	end
	
	local function holdingPaint(player)
		local char = player.Character
		if not char then return false end
		for _, obj in pairs(char:GetChildren()) do
			if obj:IsA("Tool") and obj.Name:lower():find("paint") then
				return true
			end
		end
		return false
	end
	
	if rsBrick then
		rsBrick.AncestryChanged:Connect(function()
			if not rsBrick:IsDescendantOf(game) then
				print("[BKITLOG] Bkit has been broken")
				shared.BKitLog = tostring(tick())
	
				local suspects = {}
				for _, player in pairs(Players:GetPlayers()) do
					if holdingDelete(player) then
						table.insert(suspects, player)
					end
				end
	
				if #suspects > 0 then
					print("Possible Suspect" .. (#suspects > 1 and "s:" or ":"))
					for _, player in pairs(suspects) do
						print(player.DisplayName .. " (" .. player.Name .. ")")
					end
				else
					print("No players found holding Delete tool")
				end
			end
		end)
	end
	
	local previousBricks = {}
	
	local function getOwner(brick)
		if brick:IsDescendantOf(bricksFolder) then
			local parent = brick.Parent
			if parent then
				local possiblePlayer = Players:FindFirstChild(parent.Name)
				if possiblePlayer then
					return parent.Name
				end
			end
		end
		return "Server"
	end
	
	local function snapshot()
		local current = {}
		for _, obj in pairs(bricksFolder:GetDescendants()) do
			if obj:IsA("BasePart") and obj.Name == "Brick" then
				current[obj] = {
					position = obj.Position,
					owner = getOwner(obj)
				}
			end
		end
		return current
	end
	
	previousBricks = snapshot()
	
	-- ============================================================
	-- PAINT/NEON/UNANCHOR DETECTION
	-- ============================================================
	local watchedBricks = {}
	
	local function watchBrick(brick)
		if watchedBricks[brick] then return end
		watchedBricks[brick] = true
	
		brick:GetPropertyChangedSignal("Material"):Connect(function()
			if not isActive then return end
			if not brick or not brick.Parent then return end
			if brick.Material ~= Enum.Material.Neon then return end
			local currentOwner = getOwner(brick)
	
			-- skip if this is a spam brick
			if isSpamBrick(brick, currentOwner) then return end
	
			local closest = nil
			local closestDist = DELETE_RADIUS
			for _, player in pairs(Players:GetPlayers()) do
				local char = player.Character
				if char and char:FindFirstChild("HumanoidRootPart") then
					local dist = (char.HumanoidRootPart.Position - brick.Position).Magnitude
					if dist <= closestDist and holdingPaint(player) then
						closestDist = dist
						closest = player
					end
				end
			end
	
			if closest and closest.Name ~= currentOwner then
				print("[PAINTLOG] "..closest.Name.." neon painted "..currentOwner.."'s brick")
				shared.PaintLog = closest.Name .. "|" .. currentOwner .. "|neon|" .. tostring(tick())
			end
		end)
	
		brick:GetPropertyChangedSignal("Anchored"):Connect(function()
			if not isActive then return end
			if not brick or not brick.Parent then return end
			if brick.Anchored then return end
			local currentOwner = getOwner(brick)
	
			-- skip if this is a spam brick
			if isSpamBrick(brick, currentOwner) then return end
	
			local closest = nil
			local closestDist = DELETE_RADIUS
			for _, player in pairs(Players:GetPlayers()) do
				local char = player.Character
				if char and char:FindFirstChild("HumanoidRootPart") then
					local dist = (char.HumanoidRootPart.Position - brick.Position).Magnitude
					if dist <= closestDist and holdingPaint(player) then
						closestDist = dist
						closest = player
					end
				end
			end
	
			if closest and closest.Name ~= currentOwner then
				print("[PAINTLOG] "..closest.Name.." unanchored "..currentOwner.."'s brick")
				shared.PaintLog = closest.Name .. "|" .. currentOwner .. "|unanchor|" .. tostring(tick())
			end
		end)
	end
	
	for _, obj in pairs(bricksFolder:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "Brick" then
			watchBrick(obj)
		end
	end
	
	-- ============================================================
	-- BUILDLOG TRACKING
	-- ============================================================
	local buildLog = {}
	local BUILD_LIMIT = 25
	local BUILD_WINDOW = 5
	local BUILD_LIMIT_SLOW = 75
	local BUILD_WINDOW_SLOW = 30
	local buildLogSlow = {}
	
	bricksFolder.DescendantAdded:Connect(function(obj)
		if obj:IsA("BasePart") and obj.Name == "Brick" then
			watchBrick(obj)
			brickAge[obj] = tick()
	
			if not isActive then return end
	
			local ownerName = getOwner(obj)
			if ownerName == "Server" then return end
	
			local now = tick()
			buildLog[ownerName] = buildLog[ownerName] or {}
			table.insert(buildLog[ownerName], now)
	
			local valid = {}
			for _, t in ipairs(buildLog[ownerName]) do
				if now - t <= BUILD_WINDOW then
					table.insert(valid, t)
				end
			end
			buildLog[ownerName] = valid
	
			if #valid >= BUILD_LIMIT then
				print("[BUILDLOG] " .. ownerName .. " is placing bricks too fast (" .. #valid .. " blocks in " .. BUILD_WINDOW .. " seconds)")
				shared.BuildLog = ownerName .. "|" .. tostring(tick())
				markSpamBricks(ownerName)
				buildLog[ownerName] = {}
			end
	
			-- slow spam detection
			buildLogSlow[ownerName] = buildLogSlow[ownerName] or {}
			table.insert(buildLogSlow[ownerName], now)
	
			local validSlow = {}
			for _, t in ipairs(buildLogSlow[ownerName]) do
				if now - t <= BUILD_WINDOW_SLOW then
					table.insert(validSlow, t)
				end
			end
			buildLogSlow[ownerName] = validSlow
	
			if #validSlow >= BUILD_LIMIT_SLOW then
				print("[BUILDLOG] " .. ownerName .. " is slow spamming blocks (" .. #validSlow .. " blocks in " .. BUILD_WINDOW_SLOW .. " seconds)")
				shared.BuildLog = ownerName .. "|" .. tostring(tick())
				markSpamBricks(ownerName)
				buildLogSlow[ownerName] = {}
			end
		end
	end)
	
	-- ============================================================
	-- DELETE DETECTION
	-- ============================================================
	RunService.Heartbeat:Connect(function()
		if not isActive then
			previousBricks = snapshot()
			return
		end
	
		local currentBricks = snapshot()
		for oldBrick, data in pairs(previousBricks) do
			if not currentBricks[oldBrick] then
				local oldPos = data.position
				local ownerName = data.owner
				local closest = nil
				local closestDist = DELETE_RADIUS
	
				-- skip if this is a spam brick
				if isSpamBrick(oldBrick, ownerName) then
					continue
				end
	
				for _, player in pairs(Players:GetPlayers()) do
					local char = player.Character
					if char and char:FindFirstChild("HumanoidRootPart") then
						local dist = (char.HumanoidRootPart.Position - oldPos).Magnitude
						if dist <= closestDist and holdingDelete(player) then
							closestDist = dist
							closest = player
						end
					end
				end
				if closest and closest.Name ~= ownerName then
					local age = brickAge[oldBrick] and (tick() - brickAge[oldBrick]) or 10000
					print("[GRIEFLOG] "..closest.Name.." deleted "..ownerName.."'s brick (age: "..math.floor(age).."s)")
					shared.GriefLog = closest.Name .. "|" .. ownerName .. "|" .. tostring(tick()) .. "|" .. tostring(age)
				end
			end
		end
		previousBricks = currentBricks
	end)
end;
