	local HOLD_TIME = 0.5
	local GREY = Color3.fromRGB(80, 80, 80)
	local RED = Color3.fromRGB(180, 30, 30)
	local WHITE = Color3.new(1, 1, 1)
	
	-- Wait for GUI to be fully loaded
