-- Anti-Fling Detector
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local prevVelocities = {}
local prevPositions = {}

local function getHRP(player)
	local char = player.Character
	if char then
		return char:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

local function magnitude(vec)
	if vec then
		return vec.Magnitude
	end
	return 0
end

-- Thresholds (adjust if too sensitive)
local VELOCITY_SPIKE_THRESHOLD = 50 -- studs/sec sudden spike
local ANGULAR_VELOCITY_THRESHOLD = 50
local BODY_MOVER_THRESHOLD = 30

RunService.Heartbeat:Connect(function(deltaTime)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local hrp = getHRP(player)
			if hrp then
				-- Current velocities
				local vel = hrp.Velocity.Magnitude
				local assemblyVel = hrp.AssemblyLinearVelocity.Magnitude
				local assemblyAng = hrp.AssemblyAngularVelocity.Magnitude

				-- Body movers
				local bodyVel = hrp:FindFirstChildWhichIsA("BodyVelocity")
				local bodyAng = hrp:FindFirstChildWhichIsA("BodyAngularVelocity")
				local bodyForce = hrp:FindFirstChildWhichIsA("BodyForce")
				local bodyThrust = hrp:FindFirstChildWhichIsA("BodyThrust")
				local alignOri = hrp:FindFirstChildWhichIsA("AlignOrientation")

				-- Previous velocity
				local prevVel = prevVelocities[player] or vel
				local deltaVel = math.abs(vel - prevVel)
				prevVelocities[player] = vel

				-- Detect fling criteria
				local flagged = false
				local reasons = {}

				if deltaVel > VELOCITY_SPIKE_THRESHOLD then
					flagged = true
					table.insert(reasons, "Velocity Spike: "..string.format("%.1f", deltaVel))
				end

				if assemblyAng > ANGULAR_VELOCITY_THRESHOLD then
					flagged = true
					table.insert(reasons, "Angular Velocity: "..string.format("%.1f", assemblyAng))
				end

				if (bodyVel and magnitude(bodyVel.Velocity) > BODY_MOVER_THRESHOLD) then
					flagged = true
					table.insert(reasons, "BodyVelocity: "..string.format("%.1f", magnitude(bodyVel.Velocity)))
				end

				if (bodyAng and magnitude(bodyAng.AngularVelocity) > BODY_MOVER_THRESHOLD) then
					flagged = true
					table.insert(reasons, "BodyAngularVelocity: "..string.format("%.1f", magnitude(bodyAng.AngularVelocity)))
				end

				if (bodyForce and magnitude(bodyForce.Force) > BODY_MOVER_THRESHOLD) then
					flagged = true
					table.insert(reasons, "BodyForce: "..string.format("%.1f", magnitude(bodyForce.Force)))
				end

				if (bodyThrust and magnitude(bodyThrust.Thrust) > BODY_MOVER_THRESHOLD) then
					flagged = true
					table.insert(reasons, "BodyThrust: "..string.format("%.1f", magnitude(bodyThrust.Thrust)))
				end

				if alignOri then
					-- small chance AlignOrientation itself can rotate violently
					local rotSpeed = hrp.CFrame.LookVector.Magnitude / deltaTime
					if rotSpeed > 20 then
						flagged = true
						table.insert(reasons, "AlignOrientation rotation spike")
					end
				end

				if flagged then
					print("⚠️ FLING DETECTED - "..player.Name)
					for _, reason in ipairs(reasons) do
						print("   "..reason)
					end
					print("------------------")
				end
			end
		end
	end
end)
