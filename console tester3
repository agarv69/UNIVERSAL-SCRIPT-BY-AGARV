local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- CONFIG
local VELOCITY_THRESHOLD = 50       -- studs/sec to count as a fling
local SUSTAIN_TIME = 0.2            -- minimum time velocity must be sustained
local FLING_RADIUS = 10             -- max distance between flinger and victim

-- TRACKING
local velocityHistory = {}
local lastFlagged = {}

local function getHRP(player)
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

RunService.Heartbeat:Connect(function(deltaTime)
	for _, victim in ipairs(Players:GetPlayers()) do
		if victim ~= LocalPlayer then
			local hrp = getHRP(victim)
			if hrp then
				local vel = hrp.Velocity.Magnitude

				velocityHistory[victim] = velocityHistory[victim] or {time=0, max=0}

				if vel > velocityHistory[victim].max then
					velocityHistory[victim].max = vel
				end

				if vel > VELOCITY_THRESHOLD then
					velocityHistory[victim].time = velocityHistory[victim].time + deltaTime
				else
					velocityHistory[victim].time = 0
					velocityHistory[victim].max = vel
				end

				-- DETECT FLING
				if velocityHistory[victim].time >= SUSTAIN_TIME then
					if not lastFlagged[victim] or os.clock() - lastFlagged[victim].time > 2 then
						-- Find possible flinger
						local flingerName = "Unknown"
						local victimPos = hrp.Position
						for _, p in ipairs(Players:GetPlayers()) do
							if p ~= victim then
								local flingerHRP = getHRP(p)
								if flingerHRP then
									local dist = (flingerHRP.Position - victimPos).Magnitude
									if dist <= FLING_RADIUS then
										flingerName = p.Name
										break
									end
								end
							end
						end

						print("⚠️ PLAYER FLUNG: "..victim.Name.." by "..flingerName)
						print("   Max Velocity: "..string.format("%.1f", velocityHistory[victim].max))
						print("-------------------")

						lastFlagged[victim] = {time=os.clock(), flinger=flingerName}
					end
					-- reset
					velocityHistory[victim].time = 0
					velocityHistory[victim].max = 0
				end
			end
		end
	end
end)
