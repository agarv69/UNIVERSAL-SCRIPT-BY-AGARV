local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DELETE_SOUND_ID = "rbxassetid://9117183621"
local WINDOW = 0.3

local brickTemplate = ReplicatedStorage:WaitForChild("Brick")
local recentDeleteSound = {}
local lastBrickDisappear = 0

--------------------------------------------------
-- TRACK SOUNDS
--------------------------------------------------

local function hookHRP(player, hrp)
	local lastTime = {}

	RunService.Heartbeat:Connect(function()
		if not hrp.Parent then return end
		for _, obj in pairs(hrp:GetDescendants()) do
			if obj:IsA("Sound") and obj.SoundId == DELETE_SOUND_ID then
				if obj.IsPlaying then
					local t = obj.TimePosition
					if not lastTime[obj] then lastTime[obj] = t end
					if t < lastTime[obj] and t < 0.1 then
						recentDeleteSound[player.UserId] = tick()
						print("[SOUND] Detected delete sound for", player.Name, "at", recentDeleteSound[player.UserId])
					end
					lastTime[obj] = t
				else
					lastTime[obj] = 0
				end
			end
		end
	end)
end

local function watchPlayer(player)
	local function setup(char)
		task.wait(0.5)
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then hookHRP(player, hrp) end
	end
	player.CharacterAdded:Connect(setup)
	if player.Character then setup(player.Character) end
end

for _, p in ipairs(Players:GetPlayers()) do
	watchPlayer(p)
end
Players.PlayerAdded:Connect(watchPlayer)

--------------------------------------------------
-- WATCH BRICK TEMPLATE
--------------------------------------------------

brickTemplate.AncestryChanged:Connect(function()
	if brickTemplate:IsDescendantOf(ReplicatedStorage) then return end

	-- Debounce
	if tick() - lastBrickDisappear < 0.5 then return end
	lastBrickDisappear = tick()

	local disappearedAt = tick()
	print(string.format("[BKIT] Brick disappeared at %.5f", disappearedAt))

	task.wait(0.15)

	local best = nil
	local bestDiff = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		local soundTime = recentDeleteSound[player.UserId]
		if soundTime then
			local diff = math.abs(disappearedAt - soundTime)
			print(string.format("[BKIT] %s sound diff: %.4fs", player.Name, diff))
			if diff < WINDOW and diff < bestDiff then
				best = player
				bestDiff = diff
			end
		end
	end

	if best then
		print(string.format("[BKIT EXPLOIT] %s (%s) broke BKit! (diff: %.4fs)", best.DisplayName, best.Name, bestDiff))
	else
		print("[BKIT] No candidate found")
	end
end)

print("[BKIT EXPLOIT DETECTOR] Loaded")
