local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local VELOCITY_THRESHOLD = 50 -- studs/sec
local SUSTAIN_TIME = 0.5      -- seconds velocity must be high
local DETECTION_COOLDOWN = 2  -- seconds before re-flagging same player

local velocityHistory = {}
local lastFlagged = {}

local function getHRP(player)
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

RunService.Heartbeat:Connect(function(deltaTime)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local hrp = getHRP(player)
			if hrp then
				local vel = hrp.Velocity.Magnitude

				-- history buffer
				velocityHistory[player] = velocityHistory[player] or {time=0, max=0}
				if vel > velocityHistory[player].max then
					velocityHistory[player].max = vel
				end

				-- accumulate time above threshold
				if vel > VELOCITY_THRESHOLD then
					velocityHistory[player].time = velocityHistory[player].time + deltaTime
				else
					velocityHistory[player].time = 0
					velocityHistory[player].max = vel
				end

				-- detect sustained fling
				if velocityHistory[player].time >= SUSTAIN_TIME then
					-- cooldown check
					if not lastFlagged[player] or os.clock() - lastFlagged[player] > DETECTION_COOLDOWN then
						print("⚠️ PLAYER FLUNG - "..player.Name)
						print("   Max Velocity: "..string.format("%.1f", velocityHistory[player].max))
						print("------------------")
						lastFlagged[player] = os.clock()
					end
					-- reset timer so it only flags once per event
					velocityHistory[player].time = 0
					velocityHistory[player].max = 0
				end
			end
		end
	end
end)
