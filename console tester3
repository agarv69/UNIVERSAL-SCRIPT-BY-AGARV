local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local LocalPlayer = Players.LocalPlayer

local isRunning = false
local stopped = false
local jumpConn = nil
local hasSentStop = false

-- ============================================================
-- SYSTEM MESSAGE HELPER
-- ============================================================
local function systemMessage(text)
	local existing = LocalPlayer.PlayerGui:FindFirstChild("SystemMsg_" .. text)
	if existing then return end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SystemMsg_" .. text
	screenGui.ResetOnSpawn = false
	screenGui.Parent = LocalPlayer.PlayerGui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 30)
	label.Position = UDim2.new(0, 0, 0.85, 0)
	label.BackgroundTransparency = 1
	label.Text = "[System]: " .. text
	label.TextColor3 = Color3.fromRGB(255, 255, 0)
	label.TextSize = 16
	label.Font = Enum.Font.GothamSemibold
	label.ZIndex = 999
	label.Parent = screenGui

	task.delay(5, function()
		screenGui:Destroy()
	end)
end

-- ============================================================
-- STOP
-- ============================================================
local function stop()
	if stopped then return end
	stopped = true
	isRunning = false
	if jumpConn then
		jumpConn:Disconnect()
		jumpConn = nil
	end
	systemMessage("Stopped")
end

-- ============================================================
-- SEND CHAT (one-shot, no spam)
-- ============================================================
local function sendChat(msg)
	if hasSentStop then return end
	hasSentStop = true
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		if channels then
			local general = channels:FindFirstChild("RBXGeneral")
			if general then
				general:SendAsync(msg)
			end
		end
	end)
end

-- ============================================================
-- FLUNG DETECTION
-- ============================================================
local function isPlayerFlung(TargetPlayer)
	local TChar = TargetPlayer and TargetPlayer.Character
	if not TChar then return true end
	local THum = TChar:FindFirstChildOfClass("Humanoid")
	local TRoot = TChar:FindFirstChild("HumanoidRootPart")
	if THum and THum.Health <= 0 then return true end
	if not TRoot then return true end
	local speed = TRoot.Velocity.Magnitude
	local walkSpeed = THum and THum.WalkSpeed or 16
	if speed > 120 and speed > walkSpeed * 4 then return true end
	if TRoot.RotVelocity.Magnitude > 25 then return true end
	return false
end

-- ============================================================
-- ZERO VELOCITY on all parts
-- ============================================================
local function zeroVelocity(Character)
	if not Character then return end
	for _, x in pairs(Character:GetChildren()) do
		if x:IsA("BasePart") then
			x.Velocity = Vector3.new()
			x.RotVelocity = Vector3.new()
			pcall(function() x.AssemblyLinearVelocity = Vector3.new() end)
			pcall(function() x.AssemblyAngularVelocity = Vector3.new() end)
		end
	end
end

-- ============================================================
-- POST-FLING SAFETY MONITOR
-- After returning to OldPos, watches for up to 1.5 seconds.
-- If we detect we're being launched (speed > 80), it:
--   1. Zeros all velocity immediately
--   2. Teleports back to OldPos again
--   3. Keeps retrying until speed stays low or timeout
-- ============================================================
local function safetyMonitor(savedPos)
	local Character = LocalPlayer.Character
	if not Character then return end
	local root = Character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local deadline = tick() + 1.5
	local LAUNCH_THRESHOLD = 80 -- anything above this after returning = residual fling

	while tick() < deadline do
		RunService.Heartbeat:Wait()

		Character = LocalPlayer.Character
		if not Character then break end
		root = Character:FindFirstChild("HumanoidRootPart")
		if not root then break end

		local speed = root.AssemblyLinearVelocity.Magnitude

		if speed > LAUNCH_THRESHOLD then
			-- Being launched — zero everything and snap back
			zeroVelocity(Character)

			-- Destroy any stray BodyMovers that may still exist
			for _, d in pairs(Character:GetDescendants()) do
				if d:IsA("BodyVelocity") or d:IsA("BodyForce")
					or d:IsA("BodyThrust") or d:IsA("BodyGyro")
					or d:IsA("BodyAngularVelocity") or d:IsA("BodyPosition") then
					pcall(function() d:Destroy() end)
				end
			end

			-- Snap back to saved position
			root.CFrame = savedPos
			Character:SetPrimaryPartCFrame(savedPos)

			-- Zero again immediately after snap
			zeroVelocity(Character)

			-- Extend deadline slightly so we keep checking after each correction
			deadline = tick() + 0.5
		end
	end
end

-- ============================================================
-- FLING — v13 loop exactly
-- ============================================================
local function flingPlayer(TargetPlayer)
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Humanoid and Humanoid.RootPart
	local TCharacter = TargetPlayer.Character
	if not TCharacter then return end

	local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
	local TRootPart = THumanoid and THumanoid.RootPart
	local THead = TCharacter:FindFirstChild("Head")
	local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
	local Handle = Accessory and Accessory:FindFirstChild("Handle")

	if not (Character and Humanoid and RootPart) then return end
	if not TCharacter:FindFirstChildWhichIsA("BasePart") then return end

	if RootPart.Velocity.Magnitude < 50 then
		getgenv().OldPos = RootPart.CFrame
	end

	if THead then
		workspace.CurrentCamera.CameraSubject = THead
	elseif Handle then
		workspace.CurrentCamera.CameraSubject = Handle
	elseif THumanoid and TRootPart then
		workspace.CurrentCamera.CameraSubject = THumanoid
	end

	local TargetBase = TRootPart or THead or Handle
	if not TargetBase then return end

	local savedFPDH = workspace.FallenPartsDestroyHeight
	workspace.FallenPartsDestroyHeight = math.huge

	local BV = Instance.new("BodyVelocity")
	BV.Name = "EpixVel"
	BV.Parent = RootPart
	BV.Velocity = Vector3.new(900000000, 900000000, 900000000)
	BV.MaxForce = Vector3.new(1/0, 1/0, 1/0)

	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

	local TimeToWait = 2
	local Time = tick()
	local Angle = 0
	local flingDetected = false

	repeat
		if not (RootPart and THumanoid and TargetBase) then break end

		local tPos = TargetBase.CFrame
		Angle = Angle + 100

		RootPart.CFrame = tPos * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0)
		Character:SetPrimaryPartCFrame(tPos * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0))
		RootPart.Velocity = Vector3.new(90000000, 90000000 * 10, 90000000)
		RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
		task.wait()

		RootPart.CFrame = tPos * CFrame.new(0, -1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0)
		Character:SetPrimaryPartCFrame(tPos * CFrame.new(0, -1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0))
		RootPart.Velocity = Vector3.new(90000000, 90000000 * 10, 90000000)
		RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
		task.wait()

		RootPart.CFrame = tPos * CFrame.new(2.25, 1.5, -2.25) * CFrame.Angles(math.rad(Angle), 0, 0)
		Character:SetPrimaryPartCFrame(tPos * CFrame.new(2.25, 1.5, -2.25) * CFrame.Angles(math.rad(Angle), 0, 0))
		RootPart.Velocity = Vector3.new(90000000, 90000000 * 10, 90000000)
		RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
		task.wait()

		RootPart.CFrame = tPos * CFrame.new(-2.25, -1.5, 2.25) * CFrame.Angles(math.rad(Angle), 0, 0)
		Character:SetPrimaryPartCFrame(tPos * CFrame.new(-2.25, -1.5, 2.25) * CFrame.Angles(math.rad(Angle), 0, 0))
		RootPart.Velocity = Vector3.new(90000000, 90000000 * 10, 90000000)
		RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
		task.wait()

		if isPlayerFlung(TargetPlayer) then
			flingDetected = true
			break
		end

	until flingDetected
		or (TargetBase.Parent ~= TargetPlayer.Character)
		or (TargetPlayer.Parent ~= Players)
		or THumanoid.Sit
		or (Humanoid.Health <= 0)
		or (tick() > (Time + TimeToWait))

	-- Zero BV before destroying
	BV.Velocity = Vector3.new(0, 0, 0)
	BV.MaxForce = Vector3.new(0, 0, 0)
	zeroVelocity(Character)
	BV:Destroy()

	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	workspace.CurrentCamera.CameraSubject = Humanoid
	workspace.FallenPartsDestroyHeight = savedFPDH

	-- Teleport back to saved position
	if getgenv().OldPos and RootPart and RootPart.Parent then
		zeroVelocity(Character)
		RootPart.CFrame = getgenv().OldPos
		Character:SetPrimaryPartCFrame(getgenv().OldPos)
		zeroVelocity(Character)

		-- Start the safety monitor in background — keeps snapping us back
		-- if residual physics tries to launch us after unfreeze
		task.spawn(safetyMonitor, getgenv().OldPos)
	end

	if flingDetected and isRunning then
		stop()
		sendChat(";flung user")
	end
end

-- ============================================================
-- FIND PLAYER BY NAME (partial match)
-- ============================================================
local function findPlayer(name)
	name = name:lower()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			if p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name then
				return p
			end
		end
	end
	return nil
end

local function getRandomTarget()
	local others = {}
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			table.insert(others, p)
		end
	end
	if #others == 0 then return nil end
	return others[math.random(1, #others)]
end

-- ============================================================
-- TARGET
-- ============================================================
local lockedTarget = nil

-- ============================================================
-- START
-- ============================================================
local function start(target)
	if stopped or isRunning then return end
	isRunning = true
	hasSentStop = false
	lockedTarget = target

	jumpConn = RunService.Heartbeat:Connect(function()
		if not isRunning then return end
		local t = lockedTarget or getRandomTarget()
		if not t or not t.Parent then return end
		task.spawn(function()
			flingPlayer(t)
		end)
	end)
end

-- ============================================================
-- CHAT COMMANDS
-- ;on            = start random
-- ;on username   = start locked target
-- ;stop          = stop
-- ============================================================
local function handleCmd(text)
	text = text:lower()
	if text == ";on" then
		if not stopped then
			start(nil)
		end
	elseif text:sub(1, 4) == ";on " then
		if not stopped then
			local name = text:sub(5)
			local target = findPlayer(name)
			if target then
				start(target)
			else
				systemMessage("User not found: " .. name .. " - flinging random player")
				start(nil)
			end
		end
	elseif text == ";stop" then
		stop()
	end
end

local ok = pcall(function()
	TextChatService.OnIncomingMessage = function(msg)
		if msg.TextSource and msg.TextSource.UserId == LocalPlayer.UserId then
			handleCmd(msg.Text)
		end
		return nil
	end
end)

if not ok then
	LocalPlayer.Chatted:Connect(function(msg)
		handleCmd(msg)
	end)
end

