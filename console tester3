local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local AnimationService = game:GetService("AnimationService") -- not used directly but good ref

local LocalPlayer = Players.LocalPlayer

local isRunning = false
local stopped = false
local jumpConn = nil
local hasSentStop = false

-- ============================================================
-- SYSTEM MESSAGE HELPER
-- ============================================================
local function systemMessage(text)
	local key = "SystemMsg_" .. tostring(text):sub(1, 50)
	local existing = LocalPlayer.PlayerGui:FindFirstChild(key)
	if existing then return end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = key
	screenGui.ResetOnSpawn = false
	screenGui.Parent = LocalPlayer.PlayerGui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 30)
	label.Position = UDim2.new(0, 0, 0.85, 0)
	label.BackgroundTransparency = 1
	label.Text = "[System]: " .. text
	label.TextColor3 = Color3.fromRGB(255, 255, 0)
	label.TextSize = 16
	label.Font = Enum.Font.GothamSemibold
	label.ZIndex = 999
	label.Parent = screenGui

	task.delay(5, function()
		screenGui:Destroy()
	end)
end

-- ============================================================
-- STOP ALL ANIMATIONS on local character
-- Makes the character freeze in a rigid T-pose style stance
-- (no walk cycle, no idle sway, no jump animation)
-- ============================================================
local stoppedAnimTracks = {}

local function stopAllAnims()
	local Character = LocalPlayer.Character
	if not Character then return end
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	if not Humanoid then return end
	local Animator = Humanoid:FindFirstChildOfClass("Animator")
	if not Animator then return end

	for _, track in pairs(Animator:GetPlayingAnimationTracks()) do
		track:Stop(0) -- 0 = instant, no blend out
		table.insert(stoppedAnimTracks, track)
	end
end

local function restoreAnims()
	-- We don't re-play stopped tracks — Roblox will naturally
	-- restart idle/walk anims when movement resumes.
	-- Just clear the table.
	stoppedAnimTracks = {}
end

-- ============================================================
-- FREEZE LOCAL CHARACTER VELOCITY
-- Wipes all forces + zeroes velocity instantly
-- ============================================================
local function wipeVelocity(Character)
	if not Character then return end
	for _, x in pairs(Character:GetChildren()) do
		if x:IsA("BasePart") then
			x.Velocity = Vector3.new()
			x.RotVelocity = Vector3.new()
			pcall(function() x.AssemblyLinearVelocity = Vector3.new() end)
			pcall(function() x.AssemblyAngularVelocity = Vector3.new() end)
		end
	end
	-- Destroy any stray BodyMovers
	for _, d in pairs(Character:GetDescendants()) do
		if d:IsA("BodyVelocity") or d:IsA("BodyForce") or d:IsA("BodyGyro") or d:IsA("BodyPosition") then
			pcall(function() d:Destroy() end)
		end
	end
end

-- Brief anchor/unanchor to cancel server-side physics buildup
local function cancelPhysics(Character)
	if not Character then return end
	local root = Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	wipeVelocity(Character)
	root.Anchored = true
	task.wait(0.04)
	root.Anchored = false
	wipeVelocity(Character)
end

-- ============================================================
-- STOP
-- ============================================================
local function stop()
	if stopped then return end
	stopped = true
	isRunning = false
	if jumpConn then
		jumpConn:Disconnect()
		jumpConn = nil
	end
	-- Cancel built-up physics on us immediately
	task.spawn(function()
		cancelPhysics(LocalPlayer.Character)
		restoreAnims()
	end)
	systemMessage("Stopped")
end

-- ============================================================
-- SEND CHAT MESSAGE (one-shot, no spam)
-- ============================================================
local function sendChat(msg)
	if hasSentStop then return end
	hasSentStop = true

	local sent = false
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		if channels then
			local general = channels:FindFirstChild("RBXGeneral")
			if general then
				general:SendAsync(msg)
				sent = true
			end
		end
	end)
end

-- ============================================================
-- FLING DETECTION
-- Velocity > 120 AND more than 4x their walkspeed, OR ragdoll
-- (RotVelocity spike), OR died, OR character missing
-- ============================================================
local FLUNG_SPEED = 120

local function isPlayerFlung(TargetPlayer)
	local TChar = TargetPlayer and TargetPlayer.Character
	if not TChar then return true end

	local THum = TChar:FindFirstChildOfClass("Humanoid")
	local TRoot = TChar:FindFirstChild("HumanoidRootPart")

	if THum and THum.Health <= 0 then return true end
	if not TRoot then return true end

	local speed = TRoot.Velocity.Magnitude
	local walkSpeed = (THum and THum.WalkSpeed or 16)
	if speed > FLUNG_SPEED and speed > walkSpeed * 4 then return true end

	if TRoot.RotVelocity.Magnitude > 25 then return true end

	return false
end

-- ============================================================
-- FLING CORE
-- Hard teleports into torso each frame — no tweening.
-- Animations stopped = frozen rigid stance.
-- Orientations: upright forward, upright backward,
--               upside-down forward, upside-down backward
-- All done standing straight (no sitting/crouching angles).
-- ============================================================
local function flingPlayer(TargetPlayer)
	if not isRunning then return end

	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Humanoid and Humanoid.RootPart
	if not (Character and Humanoid and RootPart) then return end

	local TCharacter = TargetPlayer.Character
	if not TCharacter then return end

	local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
	local TRootPart = THumanoid and THumanoid.RootPart
	local THead = TCharacter:FindFirstChild("Head")
	local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
	local Handle = Accessory and Accessory:FindFirstChild("Handle")

	if not TCharacter:FindFirstChildWhichIsA("BasePart") then return end

	-- Save old position before we move
	if RootPart.Velocity.Magnitude < 50 then
		getgenv().OldPos = RootPart.CFrame
	end

	local TargetBase = TRootPart or THead or Handle
	if not TargetBase then return end

	-- Camera tracking
	if THead then
		workspace.CurrentCamera.CameraSubject = THead
	elseif THumanoid then
		workspace.CurrentCamera.CameraSubject = THumanoid
	end

	local savedFPDH = workspace.FallenPartsDestroyHeight
	workspace.FallenPartsDestroyHeight = math.huge

	-- Stop all animations instantly — frozen rigid body
	stopAllAnims()

	-- Disable seated state
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
	-- Also lock humanoid states that cause animations
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, false)

	-- Body velocity to push fling force
	local BV = Instance.new("BodyVelocity")
	BV.Name = "EpixVel"
	BV.Parent = RootPart
	BV.Velocity = Vector3.new(900000000, 900000000, 900000000)
	BV.MaxForce = Vector3.new(1/0, 1/0, 1/0)

	local Time = tick()
	local TimeToWait = 2
	-- 4 standing orientations — NO angle increment that causes spinning/sitting look
	-- These are absolute world-space-ish orientations applied relative to target
	-- Y rotations flip forward/backward, X flips upside-down
	local orientIndex = 0
	local orientList = {
		CFrame.Angles(0,             0,           0),   -- upright, facing forward
		CFrame.Angles(0,             math.rad(180), 0), -- upright, facing backward
		CFrame.Angles(math.rad(180), 0,           0),   -- upside-down, facing forward
		CFrame.Angles(math.rad(180), math.rad(180), 0), -- upside-down, facing backward
	}
	-- Slight offsets to centre inside torso (not on top of head)
	local offsetList = {
		CFrame.new(0,  0,   0),
		CFrame.new(0,  0,   0),
		CFrame.new(0,  0,   0),
		CFrame.new(0,  0,   0),
	}

	local flingDetected = false

	repeat
		if not isRunning then break end
		if not (RootPart and THumanoid and TargetBase) then break end

		orientIndex = (orientIndex % #orientList) + 1

		-- HARD TELEPORT — grab the fresh position of the target every frame
		-- No lerp, no tween, no smooth movement. Pure snap.
		local tCF = TargetBase.CFrame
		local destCF = tCF * offsetList[orientIndex] * orientList[orientIndex]

		-- Set CFrame directly on every part to prevent Roblox from interpolating
		RootPart.CFrame = destCF
		Character:SetPrimaryPartCFrame(destCF)

		-- Blast velocity
		RootPart.Velocity = Vector3.new(90000000, 90000000 * 10, 90000000)
		RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)

		-- Stop anim tracks that may have restarted this frame
		local Animator = Humanoid:FindFirstChildOfClass("Animator")
		if Animator then
			for _, track in pairs(Animator:GetPlayingAnimationTracks()) do
				track:Stop(0)
			end
		end

		task.wait() -- one frame

		if isPlayerFlung(TargetPlayer) then
			flingDetected = true
		end

	until flingDetected
		or (TargetBase.Parent ~= TargetPlayer.Character)
		or (TargetPlayer.Parent ~= Players)
		or (Humanoid.Health <= 0)
		or (tick() > (Time + TimeToWait))

	-- Clean up BV
	BV:Destroy()

	-- Re-enable humanoid states
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, true)

	workspace.CurrentCamera.CameraSubject = Humanoid

	-- Return to saved pos + CANCEL residual fling physics immediately
	if getgenv().OldPos then
		RootPart.CFrame = getgenv().OldPos
		Character:SetPrimaryPartCFrame(getgenv().OldPos)
		-- Wipe velocity right away so stored fling force doesn't launch us
		wipeVelocity(Character)
		task.wait(0.04)
		-- Anchor briefly then release — snaps server physics state clean
		RootPart.Anchored = true
		task.wait(0.04)
		RootPart.Anchored = false
		wipeVelocity(Character)
	end

	restoreAnims()
	workspace.FallenPartsDestroyHeight = savedFPDH

	-- Auto stop if flung
	if flingDetected and isRunning then
		stop()
		sendChat(";flung user")
	end
end

-- ============================================================
-- RESPAWN WATCHER — re-fling locked target when they respawn
-- ============================================================
local respawnConn = nil

local function watchForRespawn(target)
	if respawnConn then respawnConn:Disconnect(); respawnConn = nil end
	if not target then return end
	respawnConn = target.CharacterAdded:Connect(function()
		if not isRunning then return end
		task.wait(1.5) -- wait for char to load
		if isRunning then
			hasSentStop = false
			systemMessage("Target respawned — flinging again")
		end
	end)
end

-- ============================================================
-- FIND PLAYER BY NAME (partial match)
-- ============================================================
local function findPlayer(name)
	name = name:lower()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			if p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name then
				return p
			end
		end
	end
	return nil
end

local function getRandomTarget()
	local others = {}
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then table.insert(others, p) end
	end
	if #others == 0 then return nil end
	return others[math.random(1, #others)]
end

local lockedTarget = nil

-- ============================================================
-- START
-- ============================================================
local function start(target)
	if isRunning then return end
	stopped = false
	isRunning = true
	hasSentStop = false
	lockedTarget = target

	watchForRespawn(target)

	jumpConn = RunService.Heartbeat:Connect(function()
		if not isRunning then return end
		local t = lockedTarget or getRandomTarget()
		if not t or not t.Parent then return end
		task.spawn(function()
			flingPlayer(t)
		end)
	end)
end

-- ============================================================
-- CHAT COMMANDS
-- ============================================================
local function handleCmd(text)
	text = text:lower()
	if text == ";fling" then
		if not isRunning then start(nil) end
	elseif text:sub(1, 7) == ";fling " then
		if not isRunning then
			local name = text:sub(8)
			local target = findPlayer(name)
			if target then
				start(target)
			else
				systemMessage("User not found: " .. name .. " - flinging random player")
				start(nil)
			end
		end
	elseif text == ";stop" then
		stop()
	end
end

local ok = pcall(function()
	TextChatService.OnIncomingMessage = function(msg)
		if msg.TextSource and msg.TextSource.UserId == LocalPlayer.UserId then
			handleCmd(msg.Text)
		end
		return nil
	end
end)

if not ok then
	LocalPlayer.Chatted:Connect(function(msg)
		handleCmd(msg)
	end)
end

