local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local LocalPlayer = Players.LocalPlayer

local isRunning = false
local stopped = false
local jumpConn = nil
local hasSentStop = false -- prevents spam/double firing

-- ============================================================
-- SYSTEM MESSAGE HELPER
-- ============================================================
local function systemMessage(text)
	local existing = LocalPlayer.PlayerGui:FindFirstChild("SystemMsg_" .. text)
	if existing then return end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SystemMsg_" .. text
	screenGui.ResetOnSpawn = false
	screenGui.Parent = LocalPlayer.PlayerGui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 30)
	label.Position = UDim2.new(0, 0, 0.85, 0)
	label.BackgroundTransparency = 1
	label.Text = "[System]: " .. text
	label.TextColor3 = Color3.fromRGB(255, 255, 0)
	label.TextSize = 16
	label.Font = Enum.Font.GothamSemibold
	label.ZIndex = 999
	label.Parent = screenGui

	task.delay(5, function()
		screenGui:Destroy()
	end)
end

-- ============================================================
-- STOP
-- ============================================================
local function stop()
	if stopped then return end
	stopped = true
	isRunning = false
	if jumpConn then
		jumpConn:Disconnect()
		jumpConn = nil
	end
	systemMessage("Stopped")
end

-- ============================================================
-- SEND STOP COMMAND IN CHAT (safe, no spam)
-- ============================================================
local function sendStopChat()
	if hasSentStop then return end
	hasSentStop = true

	-- Try modern TextChatService channel first
	local sent = false
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		if channels then
			local general = channels:FindFirstChild("RBXGeneral")
			if general then
				general:SendAsync(";stop")
				sent = true
			end
		end
	end)

	-- Fallback: legacy chat
	if not sent then
		pcall(function()
			local channel = LocalPlayer.PlayerGui:FindFirstChild("Chat")
				or game:GetService("StarterGui")
			-- Use the chat bar's remote if available
			local ChatService = game:GetService("Chat")
			ChatService:Chat(LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head"), ";stop")
		end)
	end
end

-- ============================================================
-- AUTO STOP DETECTION
-- Called after each fling attempt; checks if target was flung
-- ============================================================
local FLUNG_VELOCITY_THRESHOLD = 500 -- studs/s, same as the exit condition in fling loop

local function checkAndAutoStop(TargetPlayer)
	if not isRunning then return end
	local TCharacter = TargetPlayer and TargetPlayer.Character
	if not TCharacter then
		-- Target character gone = likely flung/died
		stop()
		sendStopChat()
		return
	end

	local TRootPart = TCharacter:FindFirstChild("HumanoidRootPart")
	local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")

	if TRootPart and TRootPart.Velocity.Magnitude > FLUNG_VELOCITY_THRESHOLD then
		stop()
		sendStopChat()
		return
	end

	-- Detect ragdoll / fallen state
	if THumanoid and THumanoid.Health <= 0 then
		stop()
		sendStopChat()
		return
	end
end

-- ============================================================
-- FLING
-- ============================================================
local function flingPlayer(TargetPlayer)
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Humanoid and Humanoid.RootPart
	local TCharacter = TargetPlayer.Character
	if not TCharacter then return end

	local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
	local TRootPart = THumanoid and THumanoid.RootPart
	local THead = TCharacter:FindFirstChild("Head")
	local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
	local Handle = Accessory and Accessory:FindFirstChild("Handle")

	if not (Character and Humanoid and RootPart) then return end
	if not TCharacter:FindFirstChildWhichIsA("BasePart") then return end

	if RootPart.Velocity.Magnitude < 50 then
		getgenv().OldPos = RootPart.CFrame
	end

	if THead then
		workspace.CurrentCamera.CameraSubject = THead
	elseif Handle then
		workspace.CurrentCamera.CameraSubject = Handle
	elseif THumanoid and TRootPart then
		workspace.CurrentCamera.CameraSubject = THumanoid
	end

	local TargetBase = TRootPart or THead or Handle
	if not TargetBase then return end

	local savedFPDH = workspace.FallenPartsDestroyHeight
	workspace.FallenPartsDestroyHeight = math.huge

	local BV = Instance.new("BodyVelocity")
	BV.Name = "EpixVel"
	BV.Parent = RootPart
	BV.Velocity = Vector3.new(900000000, 900000000, 900000000)
	BV.MaxForce = Vector3.new(1/0, 1/0, 1/0)

	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

	local TimeToWait = 2
	local Time = tick()
	local Angle = 0
	local flingDetected = false

	repeat
		if not (RootPart and THumanoid and TargetBase) then break end

		local tPos = TargetBase.CFrame
		Angle = Angle + 100

		RootPart.CFrame = tPos * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0)
		Character:SetPrimaryPartCFrame(tPos * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0))
		RootPart.Velocity = Vector3.new(90000000, 90000000 * 10, 90000000)
		RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
		task.wait()

		RootPart.CFrame = tPos * CFrame.new(0, -1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0)
		Character:SetPrimaryPartCFrame(tPos * CFrame.new(0, -1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0))
		RootPart.Velocity = Vector3.new(90000000, 90000000 * 10, 90000000)
		RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
		task.wait()

		RootPart.CFrame = tPos * CFrame.new(2.25, 1.5, -2.25) * CFrame.Angles(math.rad(Angle), 0, 0)
		Character:SetPrimaryPartCFrame(tPos * CFrame.new(2.25, 1.5, -2.25) * CFrame.Angles(math.rad(Angle), 0, 0))
		RootPart.Velocity = Vector3.new(90000000, 90000000 * 10, 90000000)
		RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
		task.wait()

		RootPart.CFrame = tPos * CFrame.new(-2.25, -1.5, 2.25) * CFrame.Angles(math.rad(Angle), 0, 0)
		Character:SetPrimaryPartCFrame(tPos * CFrame.new(-2.25, -1.5, 2.25) * CFrame.Angles(math.rad(Angle), 0, 0))
		RootPart.Velocity = Vector3.new(90000000, 90000000 * 10, 90000000)
		RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
		task.wait()

		-- Check mid-loop if target velocity spiked (flung successfully)
		if TargetBase.Velocity.Magnitude > FLUNG_VELOCITY_THRESHOLD then
			flingDetected = true
		end

	until flingDetected
		or (TargetBase.Parent ~= TargetPlayer.Character)
		or (TargetPlayer.Parent ~= Players)
		or THumanoid.Sit
		or (Humanoid.Health <= 0)
		or (tick() > (Time + TimeToWait))

	BV:Destroy()
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	workspace.CurrentCamera.CameraSubject = Humanoid

	if getgenv().OldPos then
		for _, x in pairs(Character:GetChildren()) do
			if x:IsA("BasePart") then
				x.Velocity = Vector3.new()
				x.RotVelocity = Vector3.new()
				x.AssemblyLinearVelocity = Vector3.new()
				x.AssemblyAngularVelocity = Vector3.new()
			end
		end
		RootPart.CFrame = getgenv().OldPos
		Character:SetPrimaryPartCFrame(getgenv().OldPos)
		task.wait()
		for _, x in pairs(Character:GetChildren()) do
			if x:IsA("BasePart") then
				x.Velocity = Vector3.new()
				x.RotVelocity = Vector3.new()
				x.AssemblyLinearVelocity = Vector3.new()
				x.AssemblyAngularVelocity = Vector3.new()
			end
		end
	end

	workspace.FallenPartsDestroyHeight = savedFPDH

	-- After fling attempt completes, check if player was actually flung
	if flingDetected then
		checkAndAutoStop(TargetPlayer)
	end
end

-- ============================================================
-- FIND PLAYER BY NAME (partial match)
-- ============================================================
local function findPlayer(name)
	name = name:lower()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			if p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name then
				return p
			end
		end
	end
	return nil
end

local function getRandomTarget()
	local others = {}
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			table.insert(others, p)
		end
	end
	if #others == 0 then return nil end
	return others[math.random(1, #others)]
end

-- ============================================================
-- TARGET
-- ============================================================
local lockedTarget = nil

-- ============================================================
-- START FLING LOOP
-- ============================================================
local function start(target)
	if stopped or isRunning then return end
	isRunning = true
	hasSentStop = false -- reset stop-chat guard for new session
	lockedTarget = target

	jumpConn = RunService.Heartbeat:Connect(function()
		if not isRunning then return end
		local t = lockedTarget or getRandomTarget()
		if not t or not t.Parent then return end
		task.spawn(function()
			flingPlayer(t)
		end)
	end)
end

-- ============================================================
-- CHAT COMMANDS
-- ============================================================
local function handleCmd(text)
	text = text:lower()
	if text == ";fling" then
		if not stopped then
			start(nil)
		end
	elseif text:sub(1, 7) == ";fling " then
		if not stopped then
			local name = text:sub(8)
			local target = findPlayer(name)
			if target then
				start(target)
			else
				systemMessage("User not found: " .. name .. " - flinging random player")
				start(nil)
			end
		end
	elseif text == ";stop" then
		stop()
	end
end

local ok = pcall(function()
	TextChatService.OnIncomingMessage = function(msg)
		if msg.TextSource and msg.TextSource.UserId == LocalPlayer.UserId then
			handleCmd(msg.Text)
		end
		return nil
	end
end)

if not ok then
	LocalPlayer.Chatted:Connect(function(msg)
		handleCmd(msg)
	end)
end

