local VERSION = 200

local Players = game:GetService("Players")
local DELETE_RADIUS = 24
local monitoring = true

print("Delete Detector Running [ID "..VERSION.."]")

local bricksFolder = workspace:WaitForChild("Bricks")

local tracked = {}

local function holdingDelete(player)
	local char = player.Character
	if not char then return false end
	for _, obj in pairs(char:GetChildren()) do
		if obj:IsA("Tool") and obj.Name:lower():find("delete") then
			return true
		end
	end
	return false
end

local function snapshot()
	for _, folder in pairs(bricksFolder:GetChildren()) do
		if folder:IsA("Folder") then
			for _, brick in pairs(folder:GetChildren()) do
				if brick:IsA("BasePart") and brick.Name == "Brick" then
					tracked[brick] = {
						owner = folder.Name,
						position = brick.Position
					}
				end
			end
		end
	end
end

snapshot()

while monitoring do
	task.wait(0.2)
	
	for brick, data in pairs(tracked) do
		if not brick or not brick.Parent then
			
			local pos = data.position
			local ownerName = data.owner
			
			local closest = nil
			local closestDist = DELETE_RADIUS
			
			for _, player in pairs(Players:GetPlayers()) do
				local char = player.Character
				if char and char:FindFirstChild("HumanoidRootPart") then
					local dist = (char.HumanoidRootPart.Position - pos).Magnitude
					if dist <= closestDist and holdingDelete(player) then
						closestDist = dist
						closest = player
					end
				end
			end
			
			if closest and closest.Name ~= ownerName then
				print(closest.Name .. " griefed " .. ownerName)
			end
			
			tracked[brick] = nil
		end
	end
	
	snapshot()
end
