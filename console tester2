local VERSION = 140

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local monitoring = true
local DELETE_RADIUS = 24

print("Delete Detector Running [ID "..VERSION.."]")

local bricksFolder = workspace:WaitForChild("Bricks")
local brickOwners = {}

local function holdingDelete(player)
	local char = player.Character
	if not char then return false end
	for _, obj in pairs(char:GetChildren()) do
		if obj:IsA("Tool") and obj.Name:lower():find("delete") then
			return true
		end
	end
	return false
end

local function registerBrick(brick)
	if brick:IsA("BasePart") and brick.Name == "Brick" then
		local parent = brick.Parent
		if parent and parent:IsA("Folder") then
			brickOwners[brick] = parent.Name
		end
	end
end

local function unregisterBrick(brick)
	local owner = brickOwners[brick]
	brickOwners[brick] = nil
	return owner
end

for _, obj in pairs(bricksFolder:GetDescendants()) do
	registerBrick(obj)
end

bricksFolder.DescendantAdded:Connect(function(obj)
	if not monitoring then return end
	registerBrick(obj)
end)

workspace.DescendantRemoving:Connect(function(obj)
	if not monitoring then return end
	if obj:IsA("BasePart") and obj.Name == "Brick" then
		
		local ownerName = unregisterBrick(obj)
		if not ownerName then return end
		
		local pos = obj.Position
		local closest = nil
		local closestDist = DELETE_RADIUS

		for _, player in pairs(Players:GetPlayers()) do
			local char = player.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local dist = (char.HumanoidRootPart.Position - pos).Magnitude
				if dist <= closestDist and holdingDelete(player) then
					closestDist = dist
					closest = player
				end
			end
		end

		if closest and closest.Name ~= ownerName then
			print(closest.Name.." griefed "..ownerName)
		end
	end
end)

LocalPlayer.Chatted:Connect(function(msg)
	if msg == ";stop" then
		monitoring = false
		print("Delete Detector Stopped [ID "..VERSION.."]")
	end
end)
