local VERSION = 140

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local DELETE_RADIUS = 24
local monitoring = true

local brickOwners = {}

print("Grief Detector Running [ID "..VERSION.."]")

local bricksFolder = workspace:WaitForChild("Bricks")

local function registerBrick(brick, ownerName)
	brickOwners[brick] = ownerName
end

local function scanExistingBricks()
	for _, folder in pairs(bricksFolder:GetChildren()) do
		if folder:IsA("Folder") then
			for _, brick in pairs(folder:GetChildren()) do
				if brick:IsA("BasePart") and brick.Name == "Brick" then
					registerBrick(brick, folder.Name)
				end
			end
		end
	end
end

local function holdingDelete(player)
	local char = player.Character
	if not char then return false end
	for _, obj in pairs(char:GetChildren()) do
		if obj:IsA("Tool") and obj.Name:lower():find("delete") then
			return true
		end
	end
	return false
end

scanExistingBricks()

bricksFolder.ChildAdded:Connect(function(folder)
	if folder:IsA("Folder") then
		folder.ChildAdded:Connect(function(brick)
			if brick:IsA("BasePart") and brick.Name == "Brick" then
				registerBrick(brick, folder.Name)
			end
		end)
	end
end)

workspace.DescendantRemoving:Connect(function(obj)
	if not monitoring then return end
	if obj:IsA("BasePart") and obj.Name == "Brick" then
		
		local ownerName = brickOwners[obj]
		brickOwners[obj] = nil
		
		if not ownerName then return end
		
		local pos = obj.Position
		local closest = nil
		local closestDist = DELETE_RADIUS

		for _, player in pairs(Players:GetPlayers()) do
			local char = player.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local dist = (char.HumanoidRootPart.Position - pos).Magnitude
				if dist <= closestDist and holdingDelete(player) then
					if player.Name ~= ownerName then
						closestDist = dist
						closest = player
					end
				end
			end
		end

		if closest then
			print(closest.Name .. " griefed " .. ownerName)
		end
	end
end)

LocalPlayer.Chatted:Connect(function(msg)
	if msg == ";stop" then
		monitoring = false
		print("Stopped [ID "..VERSION.."]")
	end
end)
