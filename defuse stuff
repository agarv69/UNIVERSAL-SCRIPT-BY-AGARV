local player = game:GetService("Players").LocalPlayer
local mouse = player:GetMouse()
local paintUI = player.PlayerGui:WaitForChild("Paint")
local paintEvent = player.Backpack:WaitForChild("Paint").Script.Event

-- Create toggle button
local screenGui = Instance.new("ScreenGui", player.PlayerGui)
local toggleButton = Instance.new("TextButton", screenGui)
toggleButton.Size = UDim2.new(0, 120, 0, 50)
toggleButton.Position = UDim2.new(0, 10, 0, 10)
toggleButton.Text = "Paint: OFF"
toggleButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
toggleButton.TextScaled = true

local paintActive = false

toggleButton.MouseButton1Click:Connect(function()
    paintActive = not paintActive
    toggleButton.Text = paintActive and "Paint: ON" or "Paint: OFF"
    toggleButton.BackgroundColor3 = paintActive and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    paintUI.Enabled = paintActive
end)

-- Paint on click when active (INFINITE RANGE)
mouse.Button1Down:Connect(function()
    if paintActive then
        local target = mouse.Target
        if target and not paintUI.PickerUI.Visible then
            paintEvent:FireServer(
                target,
                mouse.TargetSurface,
                mouse.Hit.Position,
                paintUI.Button.Text,
                paintUI.Color.Value.BackgroundColor3,
                paintUI.Mater.Value.Text,
                paintUI.MaterUI.Spray.Input.Text
            )
        end
    end
end)

print("Infinite range paint bypass with toggle loaded!")
