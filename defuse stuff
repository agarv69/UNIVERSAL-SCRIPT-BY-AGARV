-- ============================================================
-- DELETE RANGE BYPASS (STANDALONE)
-- Removes the 24 stud range limit from the Delete tool
-- ============================================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local isEnabled = false
local originalScript = nil
local modifiedScript = nil

-- ============================================================
-- CREATE UI
-- ============================================================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DeleteRangeBypassUI"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = LocalPlayer.PlayerGui

local frame = Instance.new("Frame")
frame.Name = "MainFrame"
frame.Size = UDim2.new(0, 200, 0, 60)
frame.Position = UDim2.new(0.5, -100, 0, 100)
frame.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
frame.BorderSizePixel = 0
frame.Parent = screenGui

local frameStroke = Instance.new("UIStroke")
frameStroke.Color = Color3.fromRGB(57, 57, 57)
frameStroke.Thickness = 1
frameStroke.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.Position = UDim2.new(0, 0, 0, 0)
title.BackgroundTransparency = 1
title.Text = "Delete Range Bypass"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 14
title.Font = Enum.Font.GothamBold
title.Parent = frame

local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0, 80, 0, 20)
toggleButton.Position = UDim2.new(0.5, -40, 1, -25)
toggleButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
toggleButton.BorderSizePixel = 0
toggleButton.Text = "OFF"
toggleButton.TextColor3 = Color3.new(1, 1, 1)
toggleButton.TextSize = 14
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Parent = frame

local toggleStroke = Instance.new("UIStroke")
toggleStroke.Color = Color3.fromRGB(57, 57, 57)
toggleStroke.Thickness = 1
toggleStroke.Parent = toggleButton

-- Make draggable
local dragging = false
local dragInput, mousePos, framePos

frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		mousePos = input.Position
		framePos = frame.Position
	end
end)

frame.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - mousePos
		frame.Position = UDim2.new(
			framePos.X.Scale,
			framePos.X.Offset + delta.X,
			framePos.Y.Scale,
			framePos.Y.Offset + delta.Y
		)
	end
end)

-- ============================================================
-- FIND DELETE TOOL
-- ============================================================
local function getDeleteTool()
	return LocalPlayer.Backpack:FindFirstChild("Delete")
		or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Delete"))
end

-- ============================================================
-- PATCH DELETE SCRIPT
-- ============================================================
local function patchDeleteScript()
	local deleteTool = getDeleteTool()
	if not deleteTool then
		title.Text = "Delete tool not found!"
		task.wait(1)
		title.Text = "Delete Range Bypass"
		return false
	end

	local deleteScript = deleteTool:FindFirstChild("Script")
	if not deleteScript then
		title.Text = "Script not found!"
		task.wait(1)
		title.Text = "Delete Range Bypass"
		return false
	end

	-- Get the source
	local source = deleteScript.Source

	-- Remove range checks (both instances)
	-- Pattern 1: (v_u_4.Character.HumanoidRootPart.Position - v10).Magnitude < 24
	-- Pattern 2: (v_u_4.Character.HumanoidRootPart.Position - v13).Magnitude < 24
	
	-- Replace the range check with true
	local patched = source:gsub("%([%w_]+%.Character%.HumanoidRootPart%.Position %- [%w_]+%).Magnitude < %d+", "true")
	
	-- Apply the patch
	deleteScript.Source = patched
	
	print("[DeleteRangeBypass] Patched delete tool - infinite range enabled")
	return true
end

-- ============================================================
-- RESTORE DELETE SCRIPT
-- ============================================================
local function restoreDeleteScript()
	local deleteTool = getDeleteTool()
	if not deleteTool then return end

	local deleteScript = deleteTool:FindFirstChild("Script")
	if not deleteScript then return end

	-- The tool will reload when re-equipped, so we just need to drop and pick it up
	if deleteTool.Parent == LocalPlayer.Character then
		deleteTool.Parent = workspace
		task.wait(0.1)
		if deleteTool and deleteTool.Parent == workspace then
			LocalPlayer.Character.Humanoid:EquipTool(deleteTool)
		end
	end
	
	print("[DeleteRangeBypass] Delete tool restored to normal")
end

-- ============================================================
-- ENABLE / DISABLE
-- ============================================================
local function enable()
	if patchDeleteScript() then
		isEnabled = true
		toggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
		toggleButton.Text = "ON"
		title.Text = "Delete Range Bypass (ON)"
	end
end

local function disable()
	isEnabled = false
	toggleButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	toggleButton.Text = "OFF"
	title.Text = "Delete Range Bypass"
	restoreDeleteScript()
end

-- ============================================================
-- TOGGLE BUTTON
-- ============================================================
toggleButton.MouseButton1Click:Connect(function()
	if isEnabled then
		disable()
	else
		enable()
	end
end)

-- ============================================================
-- AUTO-PATCH ON TOOL EQUIP
-- ============================================================
LocalPlayer.Character.ChildAdded:Connect(function(child)
	if isEnabled and child.Name == "Delete" and child:IsA("Tool") then
		task.wait(0.1)
		patchDeleteScript()
	end
end)

LocalPlayer.Backpack.ChildAdded:Connect(function(child)
	if isEnabled and child.Name == "Delete" and child:IsA("Tool") then
		task.wait(0.1)
		patchDeleteScript()
	end
end)

print("[DeleteRangeBypass] Loaded - Click toggle to enable infinite delete range")
