local function C_19()
local script = G2L["19"];
	local Players = game:GetService("Players")
	local TeleportService = game:GetService("TeleportService")
	local LocalPlayer = Players.LocalPlayer
	local PLACE_ID = game.PlaceId
	
	local RejoinNoclip = script.Parent
	local isOn = false
	local cooldown = false
	local lastRejoinTime = 0
	
	local FILE_NAME = "monkeygang_rejoin_state.txt"
	local TIMESTAMP_FILE = "monkeygang_rejoin_timestamp.txt"
	
	-- ============================================================
	-- FIND MONKEYTITLE AND SCREENGUI
	-- ============================================================
	local function getScreenGui()
		local p = script.Parent
		while p do
			if p:IsA("ScreenGui") then
				return p
			end
			p = p.Parent
		end
	end
	
	local function findDescendant(name)
		local ScreenGui = getScreenGui()
		if not ScreenGui then return nil end
		for _, v in pairs(ScreenGui:GetDescendants()) do
			if v.Name == name then
				return v
			end
		end
	end
	
	local MonkeyTitle = findDescendant("MonkeyTitle")
	local ScreenGui = getScreenGui()
	
	-- ============================================================
	-- FILE SAVE/LOAD FUNCTIONS
	-- ============================================================
	local function readFile()
		local success, result = pcall(function()
			return readfile(FILE_NAME)
		end)
		if success and result and result ~= "" then return result end
		return nil
	end
	
	local function writeFile(content)
		pcall(function()
			writefile(FILE_NAME, content)
		end)
	end
	
	local function saveButtonStates()
		if not ScreenGui then return end
	
		local lines = {}
		table.insert(lines, "autoRejoin=true")
	
		-- Find all TextButtons that are toggle buttons (have ON/OFF in text)
		for _, descendant in pairs(ScreenGui:GetDescendants()) do
			if descendant:IsA("TextButton") then
				local text = descendant.Text
				-- Check if it's a toggle button by looking for "ON" or "OFF" in the text
				if text:match(": ON$") or text:match(": OFF$") then
					local isEnabled = descendant.TextColor3 == Color3.fromRGB(0, 255, 0)
					table.insert(lines, descendant.Name .. "=" .. tostring(isEnabled))
				end
			end
		end
	
		writeFile(table.concat(lines, "\n"))
	
		-- Save timestamp of when we triggered the rejoin
		pcall(function()
			writefile(TIMESTAMP_FILE, tostring(tick()))
		end)
	end
	
	local function loadAndApplyStates()
		-- Check if rejoin timestamp exists and is recent (within 30 seconds)
		local timestampData = nil
		pcall(function()
			timestampData = readfile(TIMESTAMP_FILE)
		end)
	
		if not timestampData then 
			-- No timestamp = manual rejoin, don't restore
			return 
		end
	
		local rejoinTime = tonumber(timestampData)
		if not rejoinTime then return end
	
		local timeSinceRejoin = tick() - rejoinTime
	
		-- If more than 30 seconds, this is a manual rejoin
		if timeSinceRejoin > 30 then
			pcall(function()
				delfile(TIMESTAMP_FILE)
			end)
			return
		end
	
		-- This is an auto-rejoin, restore states
		local data = readFile()
		if not data then return end
	
		local states = {}
		for line in data:gmatch("[^\n]+") do
			local key, value = line:match("(.-)=(.+)")
			if key and value then
				states[key] = value
			end
		end
	
		-- Only apply if this was an auto-rejoin
		if states["autoRejoin"] ~= "true" then return end
	
		if not ScreenGui then return end
	
		-- Re-toggle buttons that were ON instantly (no waiting for GUI load)
		for _, descendant in pairs(ScreenGui:GetDescendants()) do
			if descendant:IsA("TextButton") then
				local savedState = states[descendant.Name]
				if savedState == "true" then
					-- Check if button is currently OFF (white text)
					if descendant.TextColor3 == Color3.fromRGB(255, 255, 255) then
						-- Click the button to turn it ON
						pcall(function()
							firesignal(descendant.MouseButton1Click)
						end)
						task.wait(0.1) -- Wait 0.1 seconds before next button
					end
				end
			end
		end
	
		-- Clear the files after restoring
		writeFile("")
		pcall(function()
			delfile(TIMESTAMP_FILE)
		end)
	end
	
	-- ============================================================
	-- AUTO-EXECUTE SETUP
	-- ============================================================
	local function setupAutoExecute()
		local queueFn = queue_on_teleport
			or (syn and syn.queue_on_teleport)
			or (fluxus and fluxus.queue_on_teleport)
	
		if queueFn then
			queueFn([[
				loadstring(game:HttpGet("https://raw.githubusercontent.com/agarv69/UNIVERSAL-SCRIPT-BY-AGARV/refs/heads/main/MonkeyGang"))()
			]])
		end
	end
	
	-- ============================================================
	-- NOCLIP DETECTION AND AUTO REJOIN
	-- ============================================================
	local function checkNoclipAndRejoin()
		while task.wait(0.5) do
			if not isOn then continue end
	
			if cooldown then continue end
	
			if tick() - lastRejoinTime < 10 then continue end
	
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
	
			if hrp and hrp.CollisionGroup == "NoClip" then
				cooldown = true
				lastRejoinTime = tick()
	
				-- Save button states before rejoining
				saveButtonStates()
	
				-- Setup auto-execute
				setupAutoExecute()
	
				-- Rejoin the server
				TeleportService:TeleportToPlaceInstance(PLACE_ID, game.JobId, LocalPlayer)
	
				task.delay(10, function()
					cooldown = false
				end)
			end
		end
	end
	
	-- ============================================================
	-- HOVER EFFECTS
	-- ============================================================
	if MonkeyTitle then
		RejoinNoclip.MouseEnter:Connect(function()
			MonkeyTitle.Text = "REJOIN ON NOCLIP"
		end)
	
		RejoinNoclip.MouseLeave:Connect(function()
			MonkeyTitle.Text = "🔥THE MONKEY GANG GUI🔥"
		end)
	end
	
	-- ============================================================
	-- BUTTON TOGGLE
	-- ============================================================
	RejoinNoclip.MouseButton1Click:Connect(function()
		isOn = not isOn
	
		if isOn then
			RejoinNoclip.Text = "REJOIN ON NOCLIP: ON"
			RejoinNoclip.TextColor3 = Color3.fromRGB(0, 255, 0)
		else
			RejoinNoclip.Text = "REJOIN ON NOCLIP: OFF"
			RejoinNoclip.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end)
	
	-- ============================================================
	-- START NOCLIP MONITORING
	-- ============================================================
	task.spawn(checkNoclipAndRejoin)
	
	-- ============================================================
	-- LOAD STATES ON JOIN (if this was an auto-rejoin)
	-- ============================================================
	task.spawn(loadAndApplyStates)
end;
