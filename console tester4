local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DELETE_SOUND_ID = "rbxassetid://9117183621"
local brickTemplate = ReplicatedStorage:WaitForChild("Brick")

local pendingBrickDisappear = nil

-- Monitor brick template disappearing
brickTemplate.AncestryChanged:Connect(function(child, parent)
    if not brickTemplate:IsDescendantOf(ReplicatedStorage) then
        pendingBrickDisappear = tick()
        print("[BRICK DISAPPEARED] Watching for delete sounds...")
    end
end)

-- Also watch for Parent changes
brickTemplate:GetPropertyChangedSignal("Parent"):Connect(function()
    if brickTemplate.Parent == nil or not brickTemplate:IsDescendantOf(ReplicatedStorage) then
        pendingBrickDisappear = tick()
        print("[BRICK DISAPPEARED] Watching for delete sounds...")
    end
end)

-- Track sound playing on each player
local function monitorPlayer(player)
    player.CharacterAdded:Connect(function(character)
        local hrp = character:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end
        
        local lastTimePosition = 0
        
        RunService.Heartbeat:Connect(function()
            if not pendingBrickDisappear then return end
            
            -- Find delete sound in HRP
            for _, child in pairs(hrp:GetChildren()) do
                if child:IsA("Sound") and child.SoundId == DELETE_SOUND_ID then
                    if child.IsPlaying then
                        -- Detect sound restart (TimePosition reset near 0)
                        if child.TimePosition < lastTimePosition and child.TimePosition < 0.1 then
                            local soundTime = tick()
                            local delay = soundTime - pendingBrickDisappear
                            
                            print(string.format("[DETECTED] %s played delete sound %.5f seconds after brick disappeared", 
                                player.Name, delay))
                            
                            -- Clear pending after first detection
                            pendingBrickDisappear = nil
                        end
                        lastTimePosition = child.TimePosition
                    else
                        lastTimePosition = 0
                    end
                end
            end
        end)
    end)
    
    -- Monitor current character if already spawned
    if player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local lastTimePosition = 0
            
            RunService.Heartbeat:Connect(function()
                if not pendingBrickDisappear then return end
                
                for _, child in pairs(hrp:GetChildren()) do
                    if child:IsA("Sound") and child.SoundId == DELETE_SOUND_ID then
                        if child.IsPlaying then
                            if child.TimePosition < lastTimePosition and child.TimePosition < 0.1 then
                                local soundTime = tick()
                                local delay = soundTime - pendingBrickDisappear
                                
                                print(string.format("[DETECTED] %s played delete sound %.5f seconds after brick disappeared", 
                                    player.Name, delay))
                                
                                pendingBrickDisappear = nil
                            end
                            lastTimePosition = child.TimePosition
                        else
                            lastTimePosition = 0
                        end
                    end
                end
            end)
        end
    end
end

-- Monitor all current and future players
for _, player in pairs(Players:GetPlayers()) do
    monitorPlayer(player)
end

Players.PlayerAdded:Connect(monitorPlayer)

print("[BKIT EXPLOIT DETECTOR] Loaded - monitoring ReplicatedStorage.Brick")
