local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DELETE_SOUND_ID = "rbxassetid://9117183621"
local brickTemplate = ReplicatedStorage:WaitForChild("Brick")

local pendingBrickDisappear = nil

-- Monitor brick template for ANY property change or removal
local function watchBrick()
    -- Watch for the brick being removed/nil parented
    local connection1 = brickTemplate.AncestryChanged:Connect(function()
        if not brickTemplate:IsDescendantOf(ReplicatedStorage) then
            pendingBrickDisappear = tick()
            print(string.format("[BRICK DISAPPEARED at %.5f] Watching for delete sounds...", pendingBrickDisappear))
        end
    end)
    
    local connection2 = brickTemplate:GetPropertyChangedSignal("Parent"):Connect(function()
        if brickTemplate.Parent == nil or not brickTemplate:IsDescendantOf(ReplicatedStorage) then
            pendingBrickDisappear = tick()
            print(string.format("[BRICK DISAPPEARED at %.5f] Watching for delete sounds...", pendingBrickDisappear))
        end
    end)
end

watchBrick()

-- Track sound playing on each player
local function monitorPlayer(player)
    local function setupCharacter(character)
        task.wait(0.5) -- Give character time to load
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local lastTimePosition = {}
        
        local heartbeat = RunService.Heartbeat:Connect(function()
            -- Always check for sounds, even when not pending
            for _, child in pairs(hrp:GetChildren()) do
                if child:IsA("Sound") and child.SoundId == DELETE_SOUND_ID then
                    if not lastTimePosition[child] then
                        lastTimePosition[child] = child.TimePosition
                    end
                    
                    if child.IsPlaying then
                        -- Detect sound restart (TimePosition reset near 0)
                        if child.TimePosition < lastTimePosition[child] and child.TimePosition < 0.1 then
                            local soundTime = tick()
                            print(string.format("[SOUND RESTART] %s delete sound restarted at %.5f", player.Name, soundTime))
                            
                            -- Check if we have a pending brick disappear
                            if pendingBrickDisappear then
                                local delay = soundTime - pendingBrickDisappear
                                print(string.format("[DETECTED] %s played delete sound %.5f seconds after brick disappeared", 
                                    player.Name, delay))
                                pendingBrickDisappear = nil
                            end
                        end
                        lastTimePosition[child] = child.TimePosition
                    else
                        lastTimePosition[child] = 0
                    end
                end
            end
        end)
        
        character.AncestryChanged:Connect(function()
            if not character:IsDescendantOf(workspace) then
                heartbeat:Disconnect()
            end
        end)
    end
    
    player.CharacterAdded:Connect(setupCharacter)
    if player.Character then
        setupCharacter(player.Character)
    end
end

-- Monitor all current and future players
for _, player in pairs(Players:GetPlayers()) do
    monitorPlayer(player)
end

Players.PlayerAdded:Connect(monitorPlayer)

print("[BKIT EXPLOIT DETECTOR] Loaded - monitoring ReplicatedStorage.Brick and all player sounds")
