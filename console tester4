local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CHECK_INTERVAL = 5
local lastPrint = {}

RunService.Heartbeat:Connect(function()
	local now = tick()

	for _, player in ipairs(Players:GetPlayers()) do
		local char = workspace:FindFirstChild(player.Name)
		if not char then continue end

		local boombox = char:FindFirstChild("SuperFlyGoldBoombox")
		if not boombox then continue end

		for _, obj in ipairs(boombox:GetDescendants()) do
			if obj:IsA("Sound") and obj.IsPlaying then
				local key = player.UserId .. "_" .. obj.SoundId

				if not lastPrint[key] or now - lastPrint[key] >= CHECK_INTERVAL then
					lastPrint[key] = now
					print("[BOOMBOX] " .. player.Name .. " | ID " .. obj.SoundId .. " | " .. string.format("%.1f", obj.PlaybackLoudness) .. " dBFS")
				end
			end
		end
	end
end)

print("[BOOMBOX DEBUG] Running - will print every 5s per active boombox")
