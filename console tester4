local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local bricksFolder = workspace:WaitForChild("Bricks")

print("BlockAge test started - will run for 2 minutes")

local brickFirstSeen = {}

local function trackExisting()
	for _, obj in pairs(bricksFolder:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "Brick" then
			if not brickFirstSeen[obj] then
				brickFirstSeen[obj] = tick()
			end
		end
	end
end

trackExisting()

bricksFolder.DescendantAdded:Connect(function(obj)
	if obj:IsA("BasePart") and obj.Name == "Brick" then
		if not brickFirstSeen[obj] then
			brickFirstSeen[obj] = tick()
		end
	end
end)

local function holdingDelete(player)
	local char = player.Character
	if not char then return false end
	for _, obj in pairs(char:GetChildren()) do
		if obj:IsA("Tool") and obj.Name:lower():find("delete") then
			return true
		end
	end
	return false
end

local previousBricks = {}

local function snapshotBricks()
	local current = {}
	for _, obj in pairs(bricksFolder:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "Brick" then
			current[obj] = true
		end
	end
	return current
end

previousBricks = snapshotBricks()

local startTime = tick()
local conn

conn = RunService.Heartbeat:Connect(function()
	-- stop after 2 minutes
	if tick() - startTime >= 120 then
		conn:Disconnect()
		print("BlockAge test stopped")
		return
	end

	local currentBricks = snapshotBricks()

	for oldBrick in pairs(previousBricks) do
		if not currentBricks[oldBrick] then
			if holdingDelete(LocalPlayer) then
				local char = LocalPlayer.Character
				if char and char:FindFirstChild("HumanoidRootPart") then
					local age = brickFirstSeen[oldBrick]
					if age then
						local seconds = math.floor(tick() - age)
						print("Your block age: " .. seconds .. " seconds")
					else
						print("Your block age: unknown (existed before script ran)")
					end
				end
			end
		end
	end

	previousBricks = currentBricks
end)
