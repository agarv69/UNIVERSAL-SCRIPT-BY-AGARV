local paintEvent = game.Players.LocalPlayer.Character.Paint.Script.Event
local brick = game.ReplicatedStorage.Brick

-- Spray all 6 sides with # symbols
local sides = {
    Enum.NormalId.Front,
    Enum.NormalId.Right,
    Enum.NormalId.Back,
    Enum.NormalId.Left,
    Enum.NormalId.Top,
    Enum.NormalId.Bottom
}

for _, side in ipairs(sides) do
    paintEvent:FireServer(brick, side, brick.Position, "both 🤝", Color3.new(0.01, 0.01, 0.005), "spray", string.rep("#", 132))
    task.wait(0.1)
end

print("ReplicatedStorage.Brick sprayed!")
