local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local deleteRange = 500
local deleteEvent = nil
local brick = ReplicatedStorage:FindFirstChild("Brick")

print("=== MULTI-METHOD DELETE AURA ===")

-- METHOD 1: Capture event reference
local function captureEvent()
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Delete") then
		local deleteScript = LocalPlayer.Character.Delete:FindFirstChild("Script")
		if deleteScript and deleteScript:FindFirstChild("Event") then
			deleteEvent = deleteScript.Event
			print("[Method 1] Event captured!")
			return true
		end
	end
	return false
end

-- METHOD 2: Modify tool script range
local function modifyToolScript()
	local deleteTool = LocalPlayer.Backpack:FindFirstChild("Delete") or 
	                   (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Delete"))
	if deleteTool then
		local deleteScript = deleteTool:FindFirstChild("Script")
		if deleteScript then
			pcall(function()
				local src = deleteScript.Source
				if src then
					deleteScript.Source = src:gsub("Magnitude < 24", "Magnitude < 99999")
					print("[Method 2] Tool script modified!")
				end
			end)
		end
	end
end

-- Auto-equip and setup
task.spawn(function()
	task.wait(1)
	if LocalPlayer.Backpack:FindFirstChild("Delete") and LocalPlayer.Character then
		LocalPlayer.Backpack.Delete.Parent = LocalPlayer.Character
		task.wait(0.5)
		captureEvent()
		modifyToolScript()
	end
end)

-- Keep trying to capture/modify
task.spawn(function()
	while task.wait(1) do
		if not deleteEvent then captureEvent() end
		modifyToolScript()
	end
end)

-- Keep tool equipped
task.spawn(function()
	while task.wait(0.5) do
		if LocalPlayer.Backpack:FindFirstChild("Delete") and LocalPlayer.Character then
			LocalPlayer.Backpack.Delete.Parent = LocalPlayer.Character
		end
	end
end)

-- METHOD 3: Fire from backpack (no equip needed)
local function deleteFromBackpack(block, pos)
	local deleteTool = LocalPlayer.Backpack:FindFirstChild("Delete")
	if deleteTool then
		local script = deleteTool:FindFirstChild("Script")
		if script and script:FindFirstChild("Event") then
			pcall(function()
				script.Event:FireServer(block, pos)
			end)
		end
	end
end

