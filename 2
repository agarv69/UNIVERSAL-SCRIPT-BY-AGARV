-- Make UI draggable
local dragging = false
local dragInput, mousePos, framePos

mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		mousePos = input.Position
		framePos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		dragInput = input
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - mousePos
		mainFrame.Position = UDim2.new(
			framePos.X.Scale,
			framePos.X.Offset + delta.X,
			framePos.Y.Scale,
			framePos.Y.Offset + delta.Y
		)
	end
end)

-- Function to send message in chat
local function sendChatMessage(message)
	local success, err = pcall(function()
		-- Try new TextChatService first (newer Roblox)
		local TextChatService = game:GetService("TextChatService")
		local textChannels = TextChatService:WaitForChild("TextChannels", 2)

		if textChannels then
			local generalChannel = textChannels:FindFirstChild("RBXGeneral")
			if generalChannel then
				generalChannel:SendAsync(message)
				return
			end
		end

		-- Fallback to legacy chat
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local chatEvents = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 2)
		if chatEvents then
			local sayMessage = chatEvents:WaitForChild("SayMessageRequest", 2)
			if sayMessage then
				sayMessage:FireServer(message, "All")
			end
		end
	end)

	if not success then
		warn("Failed to send chat message:", err)
	else
		print("Sent '67' in chat")
	end
end

-- Function to send Discord webhook
local function sendWebhook()
	if not request then
		warn("Request function not available")
		return
	end

	local playerCount = #Players:GetPlayers()
	local maxPlayers = Players.MaxPlayers

	local joinLink = string.format(
		"https://www.roblox.com/games/start?placeId=%s&gameInstanceId=%s",
		tostring(game.PlaceId),
		game.JobId
	)

	local executor = "Unknown"
	if syn and syn.request then
		executor = "Synapse X"
	elseif fluxus and fluxus.request then
		executor = "Fluxus"
	elseif getexecutorname then
		executor = getexecutorname()
	end

	local embed = {
		title = string.format("Bkit Disabled  |  %d/%d", playerCount, maxPlayers),
		description = string.format("[Join Game](%s)\n\n%s / `%s` • Today at %s",
			joinLink,
			player.DisplayName,
			player.Name,
			os.date("%I:%M %p")
		),
		color = 0xff0000, -- Red color
		footer = {
			text = executor
		},
		timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
	}

	local data = {
		embeds = {embed}
	}

	pcall(function()
		request({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = HttpService:JSONEncode(data)
		})
	end)

	print("Sent Discord webhook")
end

-- Function to break bkit
local function breakBkit()
	local success, err = pcall(function()
		local character = player.Character
		if not character then error("No character") end

		local humanoid = character:FindFirstChild("Humanoid")
		if not humanoid then error("No humanoid") end

		-- Find delete tool in backpack
		local deleteTool = player.Backpack:FindFirstChild("Delete")
		if not deleteTool then error("Delete tool not found in backpack") end

		print("Breaking bkit...")

		-- Save currently equipped tool
		local previousTool = character:FindFirstChildOfClass("Tool")

		-- Equip Delete tool
		humanoid:EquipTool(deleteTool)
		task.wait(0.1)

		-- Get the event from the equipped tool
		local event = deleteTool:WaitForChild("Script"):WaitForChild("Event")

		-- Get Brick from ReplicatedStorage
		local rs = game:GetService("ReplicatedStorage")
		local brick = rs:FindFirstChild("Brick")
		if not brick then error("No Brick in ReplicatedStorage") end

		-- Fire delete event
		event:FireServer(brick, character.HumanoidRootPart.Position)
		task.wait(0.1)

		-- Unequip Delete tool
		humanoid:UnequipTools()

		-- Re-equip previous tool if there was one
		if previousTool and previousTool.Parent == player.Backpack then
			humanoid:EquipTool(previousTool)
		end

		print("Bkit broken!")

		-- Send webhook
		sendWebhook()
	end)

	if not success then
		warn("Failed to break bkit:", err)
	end

	return success
end

-- Function to check if Delete tool is in inventory
local function hasDeleteTool()
	return player.Backpack:FindFirstChild("Delete") ~= nil
end

-- Function to get a fresh server (not visited before)
local function getFreshServer()
	local placeId = game.PlaceId
	local currentJobId = game.JobId

	-- Get server list
	local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Desc&limit=100"

	local servers
	if request then
		local response = request({Url = url})
		servers = HttpService:JSONDecode(response.Body).data
	else
		servers = HttpService:JSONDecode(game:HttpGet(url)).data
	end

	-- Find a server that's not full, not current, and not visited
	if servers then
		for i, server in pairs(servers) do
			if type(server) == "table" and server.id and server.maxPlayers and server.playing then
				local isVisited = false
				for _, visitedId in ipairs(getgenv().visitedServers) do
					if server.id == visitedId then
						isVisited = true
						break
					end
				end

				-- Don't join full servers
				if not isVisited and server.id ~= currentJobId and tonumber(server.playing) < tonumber(server.maxPlayers) then
					return server.id
				end
			end
		end
	end

	return nil
end

-- Function to server hop (manual)
local function serverHop()
	hopButton.Text = "Finding Server..."
	hopButton.BackgroundColor3 = Color3.fromRGB(170, 170, 0)

	local targetServer = getFreshServer()

	if targetServer then
		print("Found new server, hopping...")
		hopButton.Text = "Hopping..."

		-- Queue the script to re-execute on join
		if queueteleport then
			pcall(function()
				queueteleport(game:HttpGet("https://pastebin.com/raw/YOUR_PASTEBIN_HERE"))
			end)
		end

		-- Teleport to the new server
		TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, player)
	else
		print("No available servers found")
		hopButton.Text = "No Servers!"
		hopButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
		wait(2)
		hopButton.Text = "Server Hop"
		hopButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
	end
end

-- Auto raid bot loop
local function autoRaidLoop()
	raidBotRunning = true

	while autoRaidEnabled do
		print("Auto Raid Bot: Waiting for Delete tool...")
		raidButton.Text = "Waiting for Delete..."

		local startTime = tick()
		local foundTool = false

		-- Wait up to 1 minute for Delete tool
		while tick() - startTime < 60 and autoRaidEnabled do
			if hasDeleteTool() then
				foundTool = true
				break
			end
			wait(1)
		end

		if not autoRaidEnabled then break end

		if foundTool then
			print("Auto Raid Bot: Delete tool found! Breaking bkit...")
			raidButton.Text = "Breaking Bkit..."

			-- Break bkit
			local success = breakBkit()

			if success then
				wait(2)

				-- Hop to new server
				print("Auto Raid Bot: Finding new server...")
				raidButton.Text = "Finding Server..."

				local targetServer = getFreshServer()

				if targetServer then
					print("Auto Raid Bot: Hopping to new server...")

					-- Queue script
					if queueteleport then
						pcall(function()
							queueteleport(game:HttpGet("https://pastebin.com/raw/YOUR_PASTEBIN_HERE"))
						end)
					end

					-- Teleport
					TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, player)
				else
					print("Auto Raid Bot: No servers available")
					raidButton.Text = "No Servers!"
					wait(5)
				end
			end
		else
			-- No tool found in 1 minute, hop to new server
			print("Auto Raid Bot: No Delete tool, hopping to new server...")
			raidButton.Text = "No Tool - Hopping..."

			local targetServer = getFreshServer()

			if targetServer then
				-- Queue script
				if queueteleport then
					pcall(function()
						queueteleport(game:HttpGet("https://pastebin.com/raw/YOUR_PASTEBIN_HERE"))
					end)
				end

				-- Teleport
				TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, player)
			else
				print("Auto Raid Bot: No servers available")
				raidButton.Text = "No Servers!"
				wait(5)
			end
		end

		if not autoRaidEnabled then break end
		wait(1)
	end

	raidBotRunning = false
	raidButton.Text = "Auto Raid Bot: OFF"
end

