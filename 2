local HttpService = game:GetService("HttpService")

local MaterialSymbols = {
	[Enum.Material.SmoothPlastic] = "!",
	[Enum.Material.Plastic] = "@",
	[Enum.Material.CeramicTiles] = "#",
	[Enum.Material.Brick] = "$",
	[Enum.Material.WoodPlanks] = "%",
	[Enum.Material.Ice] = "^",
	[Enum.Material.Grass] = "&",
	[Enum.Material.Sand] = "*",
	[Enum.Material.Snow] = "(",
	[Enum.Material.Glass] = ")",
	[Enum.Material.Wood] = "-",
	[Enum.Material.Slate] = "_",
	[Enum.Material.Pebble] = "=",
	[Enum.Material.Marble] = "+",
	[Enum.Material.Granite] = "[",
	[Enum.Material.DiamondPlate] = "]",
	[Enum.Material.Metal] = "{",
	[Enum.Material.Asphalt] = "}",
	[Enum.Material.Concrete] = "~",
	[Enum.Material.Pavement] = "`",
	[Enum.Material.Neon] = "?"
}

local function colorToHex(color3)
	local r = math.floor(color3.R * 255)
	local g = math.floor(color3.G * 255)
	local b = math.floor(color3.B * 255)
	return string.format("%02X%02X%02X", r, g, b)
end

local function hasDecimal(num)
	return num % 1 ~= 0
end

local bricksFolder = workspace:FindFirstChild("Bricks")
if not bricksFolder then
	warn("Bricks folder not found!")
	return
end

local buildString = ""
local blockCount = 0
local skippedCount = 0

for _, descendant in pairs(bricksFolder:GetDescendants()) do
	if descendant:IsA("BasePart") and descendant.Name == "Brick" then
		if not descendant.Anchored then
			skippedCount = skippedCount + 1
			continue
		end
		
		local size = descendant.Size
		if hasDecimal(size.X) or hasDecimal(size.Y) or hasDecimal(size.Z) then
			skippedCount = skippedCount + 1
			continue
		end
		
		local materialSymbol = MaterialSymbols[descendant.Material] or "!"
		local colorHex = colorToHex(descendant.Color)
		local cf = descendant.CFrame
		local canCollideMarker = descendant.CanCollide and "" or "^"
		
		buildString = buildString .. string.format(
			"|%s%s%s%.0f,%.0f,%.0f.%.1f,%.1f,%.1f|",
			colorHex,
			materialSymbol,
			canCollideMarker,
			size.X, size.Y, size.Z,
			cf.X, cf.Y, cf.Z
		)
		
		blockCount = blockCount + 1
	end
end

if buildString == "" or not buildString then
	warn("No blocks found to save!")
	print("Blocks scanned: " .. blockCount)
	print("Blocks skipped: " .. skippedCount)
	return
end

local fullScript = [[local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local buildString = ]] .. string.format("%q", buildString) .. [[

local SymbolToMaterial = {
	["!"] = Enum.Material.SmoothPlastic,
	["@"] = Enum.Material.Plastic,
	["#"] = Enum.Material.CeramicTiles,
	["$"] = Enum.Material.Brick,
	["%"] = Enum.Material.WoodPlanks,
	["^"] = Enum.Material.Ice,
	["&"] = Enum.Material.Grass,
	["*"] = Enum.Material.Sand,
	["("] = Enum.Material.Snow,
	[")"] = Enum.Material.Glass,
	["-"] = Enum.Material.Wood,
	["_"] = Enum.Material.Slate,
	["="] = Enum.Material.Pebble,
	["+"] = Enum.Material.Marble,
	["["] = Enum.Material.Granite,
	["]"] = Enum.Material.DiamondPlate,
	["{"] = Enum.Material.Metal,
	["}"] = Enum.Material.Asphalt,
	["~"] = Enum.Material.Concrete,
	["`"] = Enum.Material.Pavement,
	["?"] = Enum.Material.Neon
}

local function hexToColor(hex)
	local r = tonumber(hex:sub(1, 2), 16) / 255
	local g = tonumber(hex:sub(3, 4), 16) / 255
	local b = tonumber(hex:sub(5, 6), 16) / 255
	return Color3.new(r, g, b)
end

local function findBuildTools()
	local tools = {}
	
	local char = LocalPlayer.Character
	if char then
		for _, item in pairs(char:GetChildren()) do
			if item:IsA("Tool") and item.Name == "Build" then
				local script = item:FindFirstChild("Script")
				local remote = script and script:FindFirstChild("Event")
				if remote then
					table.insert(tools, {bt = item, e = remote})
				end
			end
		end
	end
	
	for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
		if item:IsA("Tool") and item.Name == "Build" then
			local script = item:FindFirstChild("Script")
			local remote = script and script:FindFirstChild("Event")
			if remote then
				table.insert(tools, {bt = item, e = remote})
			end
		end
	end
	
	return tools
end

local visualFolder = Instance.new("Folder")
visualFolder.Name = "BuildPreview"
visualFolder.Parent = workspace

local blocks = {}
for blockData in buildString:gmatch("|([^|]+)") do
	local colorHex = blockData:sub(1, 6)
	local materialSymbol = blockData:sub(7, 7)
	local rest = blockData:sub(8)
	
	local canCollide = true
	if rest:sub(1, 1) == "^" then
		canCollide = false
		rest = rest:sub(2)
	end
	
	local sizeData, posData = rest:match("([^%.]+)%.(.+)")
	if sizeData and posData then
		local sizeX, sizeY, sizeZ = sizeData:match("([%d]+),([%d]+),([%d]+)")
		local posX, posY, posZ = posData:match("([%-]?%d+%.?%d*),([%-]?%d+%.?%d*),([%-]?%d+%.?%d*)")
		
		if sizeX and posX then
			local size = Vector3.new(tonumber(sizeX), tonumber(sizeY), tonumber(sizeZ))
			local position = Vector3.new(tonumber(posX), tonumber(posY), tonumber(posZ))
			
			local cornerOffset = Vector3.new(-size.X/2, -size.Y/2, -size.Z/2)
			local placePosition = position + cornerOffset
			
			local preview = Instance.new("Part")
			preview.Name = "PreviewBlock"
			preview.Size = size
			preview.Anchored = true
			preview.CanCollide = false
			preview.CFrame = CFrame.new(position)
			preview.Material = SymbolToMaterial[materialSymbol] or Enum.Material.SmoothPlastic
			preview.Color = hexToColor(colorHex)
			preview.Transparency = 0.5
			preview.Parent = visualFolder
			
			table.insert(blocks, {
				size = size,
				position = position,
				placePosition = placePosition,
				preview = preview,
				placed = false
			})
		end
	end
end

print("Loaded " .. #blocks .. " blocks")

local btools = findBuildTools()
if #btools == 0 then
	warn("No build tools found!")
	return
end

print("Found " .. #btools .. " build tools")
print("Starting auto-build...")

local bti = 0
local ws = 0.05
local bricksFolder = workspace:FindFirstChild("Bricks")
local playerFolder = bricksFolder and bricksFolder:FindFirstChild(LocalPlayer.Name)

local function safeGetCharacter()
	return LocalPlayer.Character
end

local function safeGetHRP()
	local char = safeGetCharacter()
	if char then
		return char:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

local function safeTeleport(position)
	local hrp = safeGetHRP()
	if hrp then
		-- Stay in one spot, just update position periodically
		hrp.CFrame = CFrame.new(position)
		return true
	end
	return false
end

local function safeEquipTool(tool)
	local char = safeGetCharacter()
	if char and tool.Parent ~= char then
		local humanoid = char:FindFirstChild("Humanoid")
		if humanoid then
			humanoid:EquipTool(tool)
			return true
		end
	end
	return false
end

local function checkBlockExists(blockData)
	if not playerFolder then
		playerFolder = bricksFolder and bricksFolder:FindFirstChild(LocalPlayer.Name)
	end
	
	if playerFolder then
		for _, brick in pairs(playerFolder:GetChildren()) do
			if brick:IsA("BasePart") and brick.Name == "Brick" then
				local distance = (brick.Position - blockData.position).Magnitude
				if distance < 5 then
					return true
				end
			end
		end
	end
	return false
end

local function findClosestBlock()
	local hrp = safeGetHRP()
	if not hrp then return nil, nil end
	
	local playerPos = hrp.Position
	local closestBlock = nil
	local closestDistance = math.huge
	local closestIndex = nil
	
	for i, blockData in ipairs(blocks) do
		if not blockData.placed then
			local distance = (blockData.position - playerPos).Magnitude
			if distance < closestDistance then
				closestDistance = distance
				closestBlock = blockData
				closestIndex = i
			end
		end
	end
	
	return closestBlock, closestIndex
end

task.spawn(function()
	local placedCount = 0
	local totalBlocks = #blocks
	local buildRadius = 20 -- Place blocks within 20 studs
	
	-- First pass: place all blocks
	while placedCount < totalBlocks do
		local hrp = safeGetHRP()
		if not hrp then
			task.wait(1)
			continue
		end
		
		local playerPos = hrp.Position
		local blocksInRange = {}
		
		-- Find all unplaced blocks within range
		for i, blockData in ipairs(blocks) do
			if not blockData.placed then
				local distance = (blockData.position - playerPos).Magnitude
				if distance <= buildRadius then
					table.insert(blocksInRange, {index = i, data = blockData, distance = distance})
				end
			end
		end
		
		-- If no blocks in range, teleport to closest unplaced block
		if #blocksInRange == 0 then
			local blockData, blockIndex = findClosestBlock()
			if not blockData then
				break
			end
			pcall(function()
				safeTeleport(blockData.position)
			end)
			task.wait(0.5)
			continue
		end
		
		-- Sort by distance (closest first)
		table.sort(blocksInRange, function(a, b)
			return a.distance < b.distance
		end)
		
		-- Place all blocks in range
		for _, blockInfo in ipairs(blocksInRange) do
			local blockData = blockInfo.data
			
			bti = bti + 1
			local bt = btools[(bti % #btools) + 1]
			
			-- Equip tool
			pcall(function()
				safeEquipTool(bt.bt)
			end)
			
			-- Determine build mode
			local buildMode = "normal"
			local placePos = blockData.position
			
			if blockData.size ~= Vector3.new(4, 4, 4) then
				buildMode = "detailed"
				placePos = blockData.placePosition
			end
			
			-- Place block
			pcall(function()
				bt.e:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, buildMode)
			end)
			
			blockData.placed = true
			if blockData.preview then
				pcall(function()
					blockData.preview:Destroy()
				end)
			end
			
			placedCount = placedCount + 1
			
			task.wait(ws / #btools)
			
			if placedCount % 50 == 0 then
				print("Placed " .. placedCount .. "/" .. totalBlocks .. " blocks")
			end
			
			if placedCount % 20 == 0 then
				btools = findBuildTools()
			end
		end
	end
	
	print("First pass complete! Checking for missing blocks...")
	task.wait(2)
	
	-- Validation and retry loop
	local maxRetries = 5
	
	for retryCount = 1, maxRetries do
		-- Check which blocks are actually placed
		local missingBlocks = {}
		
		for i, blockData in ipairs(blocks) do
			if not checkBlockExists(blockData) then
				blockData.placed = false
				table.insert(missingBlocks, {index = i, data = blockData})
			else
				blockData.placed = true
			end
		end
		
		if #missingBlocks == 0 then
			print("All blocks verified and placed!")
			break
		end
		
		print("Retry " .. retryCount .. "/" .. maxRetries .. ": Found " .. #missingBlocks .. " missing blocks, rebuilding...")
		
		-- Rebuild only missing blocks
		for _, missing in ipairs(missingBlocks) do
			local blockData = missing.data
			
			bti = bti + 1
			local bt = btools[(bti % #btools) + 1]
			
			pcall(function()
				safeTeleport(blockData.position)
			end)
			
			pcall(function()
				safeEquipTool(bt.bt)
			end)
			
			local buildMode = "normal"
			local placePos = blockData.position
			
			if blockData.size ~= Vector3.new(4, 4, 4) then
				buildMode = "detailed"
				placePos = blockData.placePosition
			end
			
			pcall(function()
				bt.e:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, buildMode)
			end)
			
			task.wait(ws / #btools)
		end
		
		print("Retry pass complete, waiting before next check...")
		task.wait(2)
	end
	
	-- Final count
	local finalPlacedCount = 0
	for _, blockData in ipairs(blocks) do
		if checkBlockExists(blockData) then
			finalPlacedCount = finalPlacedCount + 1
		end
	end
	
	print("=== AUTO-BUILD COMPLETE ===")
	print("Successfully placed: " .. finalPlacedCount .. "/" .. #blocks)
	if finalPlacedCount < #blocks then
		print("Missing: " .. (#blocks - finalPlacedCount) .. " blocks")
	end
	
	visualFolder:Destroy()
end)]]

setclipboard(fullScript)
print("Auto-build script copied to clipboard!")
