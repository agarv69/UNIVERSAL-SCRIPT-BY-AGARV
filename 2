-- Boombox Orbit Script (Unequip and Orbit)
local RunService = game:GetService("RunService")
local player = game.Players.LocalPlayer

local radius = 5
local speed = 2
local heightOffset = 0
local angle = 0

local function startOrbit()
	local character = player.Character
	if not character then return end
	
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local boombox = character:FindFirstChild("SuperFlyGoldBoombox") or player.Backpack:FindFirstChild("SuperFlyGoldBoombox")
	
	if not boombox then return end
	
	-- Move to workspace (unequip it completely)
	boombox.Parent = workspace
	
	local handle = boombox:FindFirstChild("Handle")
	if not handle then return end
	
	handle.Massless = true
	handle.CanCollide = false
	
	RunService.Heartbeat:Connect(function(dt)
		if not boombox or not handle or not rootPart then return end
		
		angle = angle + (speed * dt)
		
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		
		handle.CFrame = rootPart.CFrame * CFrame.new(x, heightOffset, z)
	end)
end

-- Run when boombox is found
if player.Character then
	startOrbit()
end

player.CharacterAdded:Connect(function()
	task.wait(1)
	startOrbit()
end)
