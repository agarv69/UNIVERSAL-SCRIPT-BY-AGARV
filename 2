-- Debug Script - Only important additions/removals and boolean property changes
local player = game.Players.LocalPlayer

-- Log important additions (skip tiny parts/effects)
game.DescendantAdded:Connect(function(obj)
	if obj:IsA("Tool") or obj:IsA("ScreenGui") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
		print("[ADDED]", obj:GetFullName(), "|", obj.ClassName)
	end
end)

-- Log important removals
game.DescendantRemoving:Connect(function(obj)
	if obj:IsA("Tool") or obj:IsA("ScreenGui") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
		print("[REMOVED]", obj:GetFullName(), "|", obj.ClassName)
	end
end)

-- Log ONLY boolean (true/false) property changes
local function watchBooleans(obj)
	-- Common boolean properties
	local boolProps = {"Enabled", "Visible", "Anchored", "CanCollide", "Disabled", "Active", "Draggable"}
	
	for _, prop in pairs(boolProps) do
		pcall(function()
			local currentValue = obj[prop]
			if type(currentValue) == "boolean" then
				obj:GetPropertyChangedSignal(prop):Connect(function()
					print("[PROPERTY]", obj:GetFullName(), "|", prop, "=", obj[prop])
				end)
			end
		end)
	end
end

-- Watch existing and new objects
for _, obj in pairs(game:GetDescendants()) do
	watchBooleans(obj)
end

game.DescendantAdded:Connect(watchBooleans)

print("[DEBUG] Logging additions/removals + boolean property changes only!")
