			else
				-- Disable Force R6
				if r6Connection then
					r6Connection:Disconnect()
					r6Connection = nil
				end
	
				local Char = LocalPlayer.Character
				if Char then
					local Hum = Char:FindFirstChildOfClass("Humanoid")
					if Hum and Hum.RigType == Enum.HumanoidRigType.R15 then
						StopAnimations(Hum)
						RestoreAnimations()
						StopAnimations(Hum)
					end
				end
			end
		end
	})
	
	
	
	
	
	
