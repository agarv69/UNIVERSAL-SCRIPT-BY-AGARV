				.DefaultChatSystemChatEvents
				.SayMessageRequest
				:FireServer(message, "All")
		end
	end
	
	local function getPlayerTime(player)
		local ls = player:FindFirstChild("leaderstats")
		if not ls then return 9999 end
		local t = ls:FindFirstChild("Time")
		if not t then return 9999 end
		return t.Value
	end
	
	-- ============================================================
	-- FLING LOGIC
	-- ============================================================
	local function flingPlayer(target)
		local myChar = LocalPlayer.Character
		if not myChar then return false end
		local myHRP = myChar:FindFirstChild("HumanoidRootPart")
		if not myHRP then return false end
	
		local tChar = target and target.Character
		if not tChar then return false end
		local tHRP = tChar:FindFirstChild("HumanoidRootPart")
		if not tHRP then return false end
	
		local savedCFrame = myHRP.CFrame
		local targetStartPos = tHRP.Position
	
		local BV = Instance.new("BodyVelocity")
		BV.Name = "GriefDetectFlingBV"
		BV.Velocity = Vector3.new(9e8, 9e8, 9e8)
		BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		BV.Parent = myHRP
	
		local Thrust = Instance.new("BodyThrust")
		Thrust.Name = "GriefDetectFlingThrust"
		Thrust.Force = Vector3.new(20000, 20000, 20000)
		Thrust.Parent = myHRP
	
		local startTime = tick()
		local flinged = false
	
		repeat
			if not tHRP or not tHRP.Parent then break end
			if not myHRP or not myHRP.Parent then break end
			myHRP.CFrame = tHRP.CFrame
			Thrust.Location = tHRP.Position
			if (tHRP.Position - targetStartPos).Magnitude > FLING_SUCCESS_DIST then
				flinged = true
				break
			end
			RunService.Heartbeat:Wait()
		until (tick() - startTime) >= FLING_TIMEOUT
	
		BV.Velocity = Vector3.new(0, 0, 0)
		BV.MaxForce = Vector3.new(0, 0, 0)
		Thrust.Force = Vector3.new(0, 0, 0)
		BV:Destroy()
		Thrust:Destroy()
	
		for _, part in pairs(myChar:GetChildren()) do
			if part:IsA("BasePart") then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
	
		task.wait()
	
		if myHRP and myHRP.Parent then
			myHRP.CFrame = savedCFrame
			task.wait()
			for _, part in pairs(myChar:GetChildren()) do
				if part:IsA("BasePart") then
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end
		end
	
