	local screenGui = getScreenGui()
	if not screenGui then return end
	
	local defaultSoundId = 134390474890852
	local contentSoundId = 128341339664030
	
	local defaultPool = {}
	for i = 1, 5 do
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. defaultSoundId
		s.Volume = 0.3
		s.Parent = game:GetService("SoundService")
		table.insert(defaultPool, s)
	end
	
	local contentPool = {}
	for i = 1, 5 do
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. contentSoundId
		s.Volume = 0.3
		s.Parent = game:GetService("SoundService")
		table.insert(contentPool, s)
	end
	
	local defaultIndex = 1
	local contentIndex = 1
	
	local function playSound(pool, indexRef)
		pool[indexRef]:Play()
		indexRef = indexRef + 1
		if indexRef > #pool then indexRef = 1 end
		return indexRef
	end
	
	local contentArea = screenGui:FindFirstChild("contentarea", true)
	
