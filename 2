-- StarterGui.ServerHopper.MainFrame.ContentArea.BottomRow.ServerCount.ServerCount
local function C_45()
local script = G2L["45"];
	local ServerCountLabel = script.Parent
	local MainFrame = script.Parent.Parent.Parent.Parent.Parent
	local HttpService = game:GetService("HttpService")
	
	-- Find or create refresh event
	local RefreshEvent = MainFrame:FindFirstChild("ServerHopperRefresh")
	if not RefreshEvent then
		RefreshEvent = Instance.new("BindableEvent")
		RefreshEvent.Name = "ServerHopperRefresh"
		RefreshEvent.Parent = MainFrame
	end
	
	local function updateServerCount()
		local success = pcall(function()
			local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100"
			local response = game:HttpGet(url)
			local data = HttpService:JSONDecode(response)
	
			local serverCount = 0
			if data and data.data then
				serverCount = #data.data
			end
	
			if serverCount == 100 then
				ServerCountLabel.Text = "Server Count: 100+"
			else
				ServerCountLabel.Text = "Server Count: " .. tostring(serverCount)
			end
		end)
	
		if not success then
			ServerCountLabel.Text = "Server Count: Error"
		end
	end
	
	-- Listen for refresh event
	RefreshEvent.Event:Connect(function()
		updateServerCount()
	end)
	
	-- Update immediately on startup
	updateServerCount()
end;
task.spawn(C_45);
