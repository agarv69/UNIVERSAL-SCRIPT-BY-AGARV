	-- ============================================================
	-- STATE
	-- ============================================================
	local spychat = false
	local isEnabled = false
	local arkSpyOn = false
	local donateSpyOn = false
	local mutedSpyOn = false
	
	-- ============================================================
	-- TCO COLOR TABLES
	-- ============================================================
	local isog = workspace:FindFirstChild("Cubes") ~= nil
	
	local namecolors = {
		peasant  = {150, 103, 102},
		arken    = {4,   175, 236},
		admin    = {245, 205, 48},
		hidden   = {255, 0,   0},
