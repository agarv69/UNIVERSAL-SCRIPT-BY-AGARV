local URL = "https://raw.githubusercontent.com/agarvsocooolsmith/Scripts/refs/heads/main/UserLists"

local function getIdsFromRaw(rawText, listName)
    local ids = {}
    local inList = false
    for line in rawText:gmatch("[^\n]+") do
        if line:find(listName) then
            inList = true
        elseif inList then
            if line:find("}") then break end
            local id = line:match("(%d+)")
            if id then
                ids[tonumber(id)] = true
            end
        end
    end
    return ids
end

local function checkTamper()
    if not _G.AgarWareUserList then
        loadstring(game:HttpGet(URL))()
        return
    end

    local success, rawText = pcall(function()
        return game:HttpGet(URL)
    end)

    if not success then
        warn("Failed to fetch URL")
        return
    end

    local realOwners = getIdsFromRaw(rawText, "AgarWareOwners")
    local realWhitelist = getIdsFromRaw(rawText, "AgarWareWhitelisted")
    local realBlacklist = getIdsFromRaw(rawText, "AgarWareBlacklisted")

    local tampered = false

    -- Check owners
    for i = #_G.AgarWareUserList.AgarWareOwners, 1, -1 do
        local id = _G.AgarWareUserList.AgarWareOwners[i]
        if not realOwners[id] then
            print("TAMPERED: " .. id .. " was added to owners, removing...")
            table.remove(_G.AgarWareUserList.AgarWareOwners, i)
            tampered = true
        end
    end

    -- Check whitelist
    for i = #_G.AgarWareUserList.AgarWareWhitelisted, 1, -1 do
        local id = _G.AgarWareUserList.AgarWareWhitelisted[i]
        if not realWhitelist[id] then
            print("TAMPERED: " .. id .. " was added to whitelist, removing...")
            table.remove(_G.AgarWareUserList.AgarWareWhitelisted, i)
            tampered = true
        end
    end

    -- Check blacklist for removed entries
    for id in pairs(realBlacklist) do
        local found = false
        for _, existingId in ipairs(_G.AgarWareUserList.AgarWareBlacklisted) do
            if existingId == id then found = true break end
        end
        if not found then
            print("TAMPERED: " .. id .. " was removed from blacklist, restoring...")
            table.insert(_G.AgarWareUserList.AgarWareBlacklisted, id)
            tampered = true
        end
    end

    -- Check blacklist for added entries
    for i = #_G.AgarWareUserList.AgarWareBlacklisted, 1, -1 do
        local id = _G.AgarWareUserList.AgarWareBlacklisted[i]
        if not realBlacklist[id] then
            print("TAMPERED: " .. id .. " was added to blacklist removal, restoring...")
            table.remove(_G.AgarWareUserList.AgarWareBlacklisted, i)
            tampered = true
        end
    end

    if not tampered then
        print("All lists are clean")
    end
end

task.spawn(function()
    while true do
        checkTamper()
        task.wait(10)
    end
end)
