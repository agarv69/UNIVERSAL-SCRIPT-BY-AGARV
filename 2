local function C_e8()
local script = G2L["e8"];
	-- ============================================================
	-- CHATSPY + ARKSPY + DONATESPY + MUTEDSPY (single OnIncomingMessage)
	-- ============================================================
	
	local Players = game:GetService("Players")
	local TextChatService = game:GetService("TextChatService")
