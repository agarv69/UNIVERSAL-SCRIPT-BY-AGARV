local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local isDeleting = true

-- Auto-equip Delete tool
local function equipDelete()
	if not LocalPlayer.Character then return end
	
	local deleteTool = LocalPlayer.Backpack:FindFirstChild("Delete")
	if deleteTool then
		deleteTool.Parent = LocalPlayer.Character
	end
end

-- Initial equip
task.wait(1)
equipDelete()

-- Re-equip on respawn
LocalPlayer.CharacterAdded:Connect(function(character)
	task.wait(1.5)
	equipDelete()
end)

-- Keep Delete equipped
task.spawn(function()
	while task.wait(0.5) do
		equipDelete()
	end
end)

-- Extended range delete aura (prioritizes nearby, then deletes far)
task.spawn(function()
	while isDeleting do
		task.wait(0.1) -- Main loop delay to avoid overwhelming server
		
		if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then 
			continue 
		end
		
		local deleteTool = LocalPlayer.Character:FindFirstChild("Delete")
		if not deleteTool then continue end
		
		local deleteScript = deleteTool:FindFirstChild("Script")
		if not deleteScript or not deleteScript:FindFirstChild("Event") then continue end
		
		local hrp = LocalPlayer.Character.HumanoidRootPart
		
		-- Get ALL blocks and sort by distance (nearby first to avoid suspicion, then far)
		local blocksWithDistance = {}
		for _, block in pairs(workspace.Bricks:GetDescendants()) do
			if block:IsA("BasePart") and block.Name == "Brick" then
				local distance = (block.Position - hrp.Position).Magnitude
				table.insert(blocksWithDistance, {block, block.Position, distance})
			end
		end
		
		-- Sort by distance (closest first)
		table.sort(blocksWithDistance, function(a, b)
			return a[3] < b[3]
		end)
		
		-- Delete blocks with controlled rate to avoid rate limit
		local deleteCount = 0
		for _, data in pairs(blocksWithDistance) do
			local block = data[1]
			local pos = data[2]
			
			pcall(function()
				deleteScript.Event:FireServer(block, pos)
			end)
			
			deleteCount = deleteCount + 1
			
			-- Limit to 50 deletes per cycle to avoid rate limiting
			if deleteCount >= 50 then
				break
			end
			
			task.wait(0.02) -- Small delay between deletes
		end
	end
end)

print("Extended Range Delete Aura loaded!")
print("Deletes up to 50 blocks per cycle, starting with nearby blocks!")
