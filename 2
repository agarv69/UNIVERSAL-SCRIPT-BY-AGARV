-- StarterGui.ServerHopper.MainFrame.ContentArea.BottomRow.ServerCount.ServerCount
local function C_43()
local script = G2L["43"];
	local ServerCountLabel = script.Parent
	local HttpService = game:GetService("HttpService")
	
	local function updateServerCount()
		local success, result = pcall(function()
			local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100"
			local response = game:HttpGet(url)
			local data = HttpService:JSONDecode(response)
	
			local serverCount = 0
			if data and data.data then
				serverCount = #data.data
			end
	
			ServerCountLabel.Text = "Server Count: " .. tostring(serverCount)
		end)
	
		if not success then
			ServerCountLabel.Text = "Server Count: Error"
		end
	end
	
	-- Update immediately
	updateServerCount()
	
	-- Update every 60 seconds
	while true do
		task.wait(60)
		updateServerCount()
	end
end;
task.spawn(C_43);
