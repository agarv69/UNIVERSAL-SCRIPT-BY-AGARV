task.wait(1)

local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- AUTO PICKUP
--------------------------------------------------

task.spawn(function()
	while true do
		local char = LocalPlayer.Character
		local hum  = char and char:FindFirstChildWhichIsA("Humanoid")

		if hum and hum.Health > 0 then
			local currentlyEquipped = char:FindFirstChildOfClass("Tool")

			for _, obj in ipairs(workspace:GetChildren()) do
				if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
					pcall(function()
						hum:EquipTool(obj)
						task.wait(0.05)
						for i = 1, 3 do
							if obj.Parent == char then
								obj.Parent = LocalPlayer.Backpack
							end
							task.wait(0.02)
						end
						if currentlyEquipped and currentlyEquipped.Parent == LocalPlayer.Backpack then
							task.wait(0.03)
							hum:EquipTool(currentlyEquipped)
						end
					end)
				end
			end
		end

		task.wait(0.1)
	end
end)

--------------------------------------------------
-- ANTI FLING
--------------------------------------------------

local function disableCollisionsFor(character)
	if not character then return end
	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
end

for _, player in pairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		if player.Character then
			disableCollisionsFor(player.Character)
		end
		player.CharacterAdded:Connect(disableCollisionsFor)
	end
end

Players.PlayerAdded:Connect(function(player)
	if player ~= LocalPlayer then
		player.CharacterAdded:Connect(disableCollisionsFor)
		if player.Character then
			disableCollisionsFor(player.Character)
		end
	end
end)

RunService.Heartbeat:Connect(function()
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			disableCollisionsFor(player.Character)
		end
	end
end)

--------------------------------------------------
-- GOD MODE
--------------------------------------------------

local godConnections = {}

local function enableGodmode()
	for _, conn in pairs(godConnections) do
		if conn then conn:Disconnect() end
	end
	godConnections = {}

	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	humanoid.MaxHealth = math.huge
	humanoid.Health    = math.huge

	table.insert(godConnections, RunService.RenderStepped:Connect(function()
		if humanoid and humanoid.Parent then
			humanoid.MaxHealth = math.huge
			humanoid.Health    = math.huge
		end
	end))

	table.insert(godConnections, humanoid:GetPropertyChangedSignal("Health"):Connect(function()
		if humanoid and humanoid.Parent then
			if humanoid.Health < math.huge then
				humanoid.MaxHealth = math.huge
				humanoid.Health    = math.huge
			end
		end
	end))

	table.insert(godConnections, humanoid.Died:Connect(function()
		task.wait()
		humanoid.Health = math.huge
	end))
end

enableGodmode()

LocalPlayer.CharacterAdded:Connect(function(character)
	character:WaitForChild("Humanoid")
	task.wait(0.1)
	enableGodmode()
end)
