-- StarterGui.ScreenGui.Frame.main.build.build
local function C_6()
local script = G2L["6"];
	-- PUT THIS SCRIPT UNDER THE "build" BUTTON
	local button = script.Parent
	local textbox = script.Parent.Parent.json
	
	local isBuilding = false
	
	button.MouseButton1Click:Connect(function()
		if not isBuilding then
			-- START BUILD
			local buildString = textbox.Text
	
			if buildString == "" or buildString == "Put your build file..." then
				return
			end
	
			isBuilding = true
			button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
			button.Text = "Stop Build"
	
			-- Set the build string globally
			_G.buildString = buildString
	
			-- Run the autobuild script
			task.spawn(function()
				loadstring(game:HttpGet("https://raw.githubusercontent.com/agarv69/Open-Source-Scripts/refs/heads/main/autobuild.lua"))()
			end)
		else
			-- STOP BUILD
			_G.stopautobuild = true
			isBuilding = false
			button.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
			button.Text = "Start Build"
		end
	end)
end;
task.spawn(C_6);
-- StarterGui.ScreenGui.Frame.second.copybuilds.copybuilds
local function C_a()
local script = G2L["a"];
	-- PUT THIS SCRIPT UNDER THE "copybuilds" BUTTON
	local button = script.Parent
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	
	local function hexFromColor(color)
		return string.format("%02X%02X%02X", 
			math.floor(color.R * 255), 
			math.floor(color.G * 255), 
			math.floor(color.B * 255))
	end
	
	local MaterialToSymbol = {
		[Enum.Material.SmoothPlastic] = "!",
		[Enum.Material.Plastic] = "@",
		[Enum.Material.CeramicTiles] = "#",
		[Enum.Material.Brick] = "$",
		[Enum.Material.WoodPlanks] = "%",
		[Enum.Material.Ice] = "^",
		[Enum.Material.Grass] = "&",
		[Enum.Material.Sand] = "*",
		[Enum.Material.Snow] = "(",
		[Enum.Material.Glass] = ")",
		[Enum.Material.Wood] = "-",
		[Enum.Material.Slate] = "_",
		[Enum.Material.Pebble] = "=",
		[Enum.Material.Marble] = "+",
		[Enum.Material.Granite] = "[",
		[Enum.Material.DiamondPlate] = "]",
		[Enum.Material.Metal] = "{",
		[Enum.Material.Asphalt] = "}",
		[Enum.Material.Concrete] = "~",
		[Enum.Material.Pavement] = "`",
		[Enum.Material.Neon] = "?"
	}
	
	button.MouseButton1Click:Connect(function()
		local success = pcall(function()
			local bricksFolder = workspace:FindFirstChild("Bricks")
			if not bricksFolder then error("No bricks") end
	
			local buildString = ""
	
			for _, playerFolder in pairs(bricksFolder:GetChildren()) do
				for _, brick in pairs(playerFolder:GetChildren()) do
					if brick:IsA("BasePart") and brick.Name == "Brick" then
						local colorHex = hexFromColor(brick.Color)
						local mat = MaterialToSymbol[brick.Material] or "@"
						local collide = brick.CanCollide and "" or "^"
						local size = brick.Size
						local pos = brick.Position
	
						buildString = buildString .. string.format("|%s%s%s%d,%d,%d.%.1f,%.1f,%.1f",
							colorHex, mat, collide,
							math.floor(size.X + 0.5), math.floor(size.Y + 0.5), math.floor(size.Z + 0.5),
							pos.X, pos.Y, pos.Z)
					end
				end
			end
	
			buildString = buildString .. "|"
			setclipboard(buildString)
	
			button.Text = "Copied to clipboard!"
			task.wait(1)
			button.Text = "Copy Server Builds to .json"
		end)
	
		if not success then
			button.Text = "Failed to copy"
			task.wait(1)
			button.Text = "Copy Server Builds to .json"
		end
	end)
end;
task.spawn(C_a);

