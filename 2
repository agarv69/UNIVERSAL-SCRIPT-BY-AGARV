			elseif input.KeyCode == Enum.KeyCode.D then CONTROL.R = vehicleflyspeed
			elseif input.KeyCode == Enum.KeyCode.E then CONTROL.Q = vehicleflyspeed * 2
			elseif input.KeyCode == Enum.KeyCode.Q then CONTROL.E = -vehicleflyspeed * 2
			end
		end)
	
		vflyKeyUp = UserInputService.InputEnded:Connect(function(input, processed)
