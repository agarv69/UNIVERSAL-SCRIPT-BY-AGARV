local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local toolsToEquip = {
	"Build",
	"Delete",
	"Paint",
	"Shape",
	"Shovel",
	"Sign"
}

local isSpamming = true
local range = 50 -- Range around you to spam

-- Auto-equip all tools
local function equipAllTools()
	if not LocalPlayer.Character then return end
	
	for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
		if tool:IsA("Tool") and table.find(toolsToEquip, tool.Name) then
			tool.Parent = LocalPlayer.Character
		end
	end
end

-- Initial equip
task.wait(1)
equipAllTools()

-- Auto-equip when new tools are added
LocalPlayer.Backpack.ChildAdded:Connect(function(tool)
	if tool:IsA("Tool") and table.find(toolsToEquip, tool.Name) then
		task.wait(0.05)
		if LocalPlayer.Character then
			tool.Parent = LocalPlayer.Character
		end
	end
end)

-- Re-equip on respawn
LocalPlayer.CharacterAdded:Connect(function(character)
	task.wait(1.5)
	equipAllTools()
end)

-- Keep tools equipped
task.spawn(function()
	while task.wait(0.5) do
		equipAllTools()
	end
end)

-- Get random position around player
local function getRandomPosAroundPlayer(distance)
	if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		return Vector3.new(0, 0, 0)
	end
	
	local hrp = LocalPlayer.Character.HumanoidRootPart
	local randomX = math.random(-distance, distance)
	local randomZ = math.random(-distance, distance)
	
	return hrp.Position + Vector3.new(randomX, 0, randomZ)
end

-- Get position far away
local function getFarPosition()
	return Vector3.new(math.random(10000, 50000), math.random(1000, 5000), math.random(10000, 50000))
end

-- Spam all tools
RunService.Heartbeat:Connect(function()
	if not isSpamming or not LocalPlayer.Character then return end
	
	local character = LocalPlayer.Character
	local brick = game:GetService("ReplicatedStorage"):FindFirstChild("Brick")
	if not brick then return end
	
	-- BUILD - Spam blocks around you
	local buildTool = character:FindFirstChild("Build")
	if buildTool then
		local buildScript = buildTool:FindFirstChild("Script")
		if buildScript and buildScript:FindFirstChild("Event") then
			local pos = getRandomPosAroundPlayer(range)
			pcall(function()
				buildScript.Event:FireServer(workspace.Terrain, Enum.NormalId.Top, pos, "normal")
			end)
		end
	end
	
	-- DELETE - Delete blocks around you or far away
	local deleteTool = character:FindFirstChild("Delete")
	if deleteTool then
		local deleteScript = deleteTool:FindFirstChild("Script")
		if deleteScript and deleteScript:FindFirstChild("Event") then
			-- Find nearby blocks to delete
			for _, block in pairs(workspace.Bricks:GetDescendants()) do
				if block:IsA("BasePart") and block.Name == "Brick" then
					if (block.Position - character.HumanoidRootPart.Position).Magnitude < range then
						pcall(function()
							deleteScript.Event:FireServer(block, block.Position)
						end)
					end
				end
			end
		end
	end
	
	-- PAINT - Unanchor and toxify blocks around you
	local paintTool = character:FindFirstChild("Paint")
	if paintTool then
		local paintScript = paintTool:FindFirstChild("Script")
		if paintScript and paintScript:FindFirstChild("Event") then
			-- Find nearby blocks to toxify
			for _, block in pairs(workspace.Bricks:GetDescendants()) do
				if block:IsA("BasePart") and block.Name == "Brick" then
					if (block.Position - character.HumanoidRootPart.Position).Magnitude < range then
						pcall(function()
							-- Unanchor
							paintScript.Event:FireServer(block, Enum.NormalId.Top, block.Position, "material", nil, "anchor", "")
							task.wait(0.01)
							-- Toxify (Neon)
							paintScript.Event:FireServer(block, Enum.NormalId.Top, block.Position, "material", Color3.fromRGB(0, 0, 0), "neon", "")
						end)
					end
				end
			end
		end
	end
	
	-- SHAPE - Decrease blocks around you
	local shapeTool = character:FindFirstChild("Shape")
	if shapeTool then
		local shapeScript = shapeTool:FindFirstChild("Script")
		if shapeScript and shapeScript:FindFirstChild("Event") then
			-- Find nearby blocks to decrease
			for _, block in pairs(workspace.Bricks:GetDescendants()) do
				if block:IsA("BasePart") and block.Name == "Brick" then
					if (block.Position - character.HumanoidRootPart.Position).Magnitude < range then
						pcall(function()
							shapeScript.Event:FireServer(block, Enum.NormalId.Top, block.Position, "decrease")
						end)
					end
				end
			end
		end
	end
	
	-- SHOVEL - Spam dig around you on the ground
	local shovelTool = character:FindFirstChild("Shovel")
	if shovelTool then
		local shovelScript = shovelTool:FindFirstChild("Script")
		if shovelScript and shovelScript:FindFirstChild("Event") then
			local pos = getRandomPosAroundPlayer(range)
			pos = Vector3.new(pos.X, character.HumanoidRootPart.Position.Y - 3, pos.Z) -- Ground level
			pcall(function()
				shovelScript.Event:FireServer(workspace.Terrain, Enum.NormalId.Top, pos, "dig")
			end)
		end
	end
	
	-- SIGN - Spam signs around you
	local signTool = character:FindFirstChild("Sign")
	if signTool then
		local signScript = signTool:FindFirstChild("Script")
		if signScript and signScript:FindFirstChild("Event") then
			local pos = getRandomPosAroundPlayer(range)
			pcall(function()
				signScript.Event:FireServer(workspace.Terrain, Enum.NormalId.Top, pos)
			end)
		end
	end
end)

print("Multi-tool spam script loaded!")
print("All tools equipped and spamming!")
print("Range: " .. range .. " studs")
