local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local isDeleting = true

-- Auto-equip Delete tool
local function equipDelete()
	if not LocalPlayer.Character then return end
	
	local deleteTool = LocalPlayer.Backpack:FindFirstChild("Delete")
	if deleteTool then
		deleteTool.Parent = LocalPlayer.Character
	end
end

-- Initial equip
task.wait(1)
equipDelete()

-- Auto-equip when new tools are added
LocalPlayer.Backpack.ChildAdded:Connect(function(tool)
	if tool.Name == "Delete" then
		task.wait(0.05)
		if LocalPlayer.Character then
			tool.Parent = LocalPlayer.Character
		end
	end
end)

-- Re-equip on respawn
LocalPlayer.CharacterAdded:Connect(function(character)
	task.wait(1.5)
	equipDelete()
end)

-- Keep Delete equipped
task.spawn(function()
	while task.wait(0.5) do
		equipDelete()
	end
end)

-- Infinite range delete aura (with rate limiting to prevent lag)
task.spawn(function()
	while isDeleting do
		if not LocalPlayer.Character then 
			task.wait(0.5)
			continue 
		end
		
		local deleteTool = LocalPlayer.Character:FindFirstChild("Delete")
		if not deleteTool then 
			task.wait(0.5)
			continue 
		end
		
		local deleteScript = deleteTool:FindFirstChild("Script")
		if not deleteScript or not deleteScript:FindFirstChild("Event") then 
			task.wait(0.5)
			continue 
		end
		
		-- Get ALL blocks in the entire workspace (no range check)
		local blocksToDelete = {}
		for _, block in pairs(workspace.Bricks:GetDescendants()) do
			if block:IsA("BasePart") and block.Name == "Brick" then
				table.insert(blocksToDelete, block)
			end
		end
		
		-- Delete blocks with a small delay to prevent server lag
		for _, block in pairs(blocksToDelete) do
			pcall(function()
				deleteScript.Event:FireServer(block, block.Position)
			end)
			task.wait(0.01) -- Small delay between each delete to prevent lag
		end
		
		task.wait(0.05) -- Wait before next cycle
	end
end)

print("Infinite Delete Aura loaded!")
print("Deleting ALL blocks in the server with NO range limit!")
