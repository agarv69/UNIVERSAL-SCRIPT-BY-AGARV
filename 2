		if connection then
			connection:Disconnect()
			connection = nil
		end
		progress = 0
		fillBar.Size = UDim2.new(0, 0, 1, 0)
		fillBar.BackgroundColor3 = GREY
		btnLabel.Text = "Join Biggest XL Server"
	end
	
