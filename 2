local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function findBuildTool()
	local locations = {LocalPlayer.Character, LocalPlayer.Backpack}
	
	for _, location in pairs(locations) do
		if location then
			for _, item in pairs(location:GetChildren()) do
				if item:IsA("Tool") and item.Name == "Build" then
					local remote = item:FindFirstChild("Script", true) and item.Script:FindFirstChild("Event")
					if remote then
						return {tool = item, event = remote}
					end
				end
			end
		end
	end
	
	return nil
end

local function findClosestBrick()
	local bricksFolder = workspace:FindFirstChild("Bricks")
	if not bricksFolder then return nil end
	
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	
	local closestBrick = nil
	local closestDist = math.huge
	
	for _, child in pairs(bricksFolder:GetDescendants()) do
		if child:IsA("BasePart") and child.Name == "Brick" then
			local dist = (child.Position - hrp.Position).Magnitude
			if dist < closestDist then
				closestDist = dist
				closestBrick = child
			end
		end
	end
	
	return closestBrick
end

local function snapToGrid(position)
	return Vector3.new(
		math.round(position.X / 4) * 4 + 2,
		math.round(position.Y / 4) * 4 + 2,
		math.round(position.Z / 4) * 4 + 2
	)
end

-- Main execution
local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
if not hrp then
	warn("HRP not found!")
	return
end

local buildTool = findBuildTool()
if not buildTool then
	warn("Build tool not found!")
	return
end

local sourceBrick = findClosestBrick()
if not sourceBrick then
	warn("No brick found to copy properties from!")
	return
end

-- Calculate position 4 studs in front of player
local lookDirection = hrp.CFrame.LookVector
local placePos = hrp.Position + (lookDirection * 4)
placePos = snapToGrid(placePos)

-- Place block using the source brick's face (this copies its properties)
buildTool.event:FireServer(sourceBrick, Enum.NormalId.Top, placePos, "normal")

print("Placed block at:", placePos, "with properties from brick:", sourceBrick)
