local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Pick a random player
local function getRandomPlayer()
	local allPlayers = Players:GetPlayers()
	local otherPlayers = {}
	
	for _, player in pairs(allPlayers) do
		if player ~= LocalPlayer then
			table.insert(otherPlayers, player)
		end
	end
	
	if #otherPlayers > 0 then
		return otherPlayers[math.random(1, #otherPlayers)]
	end
	return nil
end

local targetPlayer = getRandomPlayer()

if not targetPlayer then
	warn("No other players in server!")
	return
end

print("Following: " .. targetPlayer.Name)

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- SET NETWORK OWNERSHIP to ourselves
pcall(function()
	RootPart:SetNetworkOwner(LocalPlayer)
	for _, part in pairs(Character:GetDescendants()) do
		if part:IsA("BasePart") then
			part:SetNetworkOwner(LocalPlayer)
		end
	end
end)

-- Create AlignPosition and AlignOrientation for PHYSICS-BASED sticking
local function createAttachment(parent)
	local att = Instance.new("Attachment")
	att.Parent = parent
	return att
end

local connection
local alignPos
local alignOrient

local function setupFollow()
	local TCharacter = targetPlayer.Character
	if not TCharacter then return false end
	
	local THead = TCharacter:FindFirstChild("Head")
	if not THead then return false end
	
	-- Clean up old constraints
	if alignPos then alignPos:Destroy() end
	if alignOrient then alignOrient:Destroy() end
	
	-- Create attachments
	local att0 = createAttachment(RootPart)
	local att1 = createAttachment(THead)
	
	-- AlignPosition - FORCES position match
	alignPos = Instance.new("AlignPosition")
	alignPos.Attachment0 = att0
	alignPos.Attachment1 = att1
	alignPos.MaxForce = math.huge
	alignPos.MaxVelocity = math.huge
	alignPos.Responsiveness = 200 -- MAXIMUM responsiveness
	alignPos.ApplyAtCenterOfMass = true
	alignPos.RigidityEnabled = true
	alignPos.Position = Vector3.new(0, 2, 0) -- Offset above head
	alignPos.Parent = RootPart
	
	-- AlignOrientation - Keep upright
	alignOrient = Instance.new("AlignOrientation")
	alignOrient.Attachment0 = att0
	alignOrient.Attachment1 = att1
	alignOrient.MaxTorque = math.huge
	alignOrient.Responsiveness = 200
	alignOrient.RigidityEnabled = true
	alignOrient.Parent = RootPart
	
	return true
end

-- Initial setup
if not setupFollow() then
	targetPlayer.CharacterAdded:Wait()
	setupFollow()
end

-- RenderStepped for INSTANT visual updates (runs BEFORE frame renders)
connection = RunService.RenderStepped:Connect(function()
	if not targetPlayer or targetPlayer.Parent ~= Players then
		if connection then connection:Disconnect() end
		if alignPos then alignPos:Destroy() end
		if alignOrient then alignOrient:Destroy() end
		return
	end
	
	local TCharacter = targetPlayer.Character
	if not TCharacter then return end
	
	local THead = TCharacter:FindFirstChild("Head")
	if not THead then return end
	
	-- DIRECT CFRAME UPDATE for visual smoothness
	local targetPos = THead.Position + Vector3.new(0, 2, 0)
	RootPart.CFrame = CFrame.new(targetPos)
	
	-- Zero velocity to prevent physics drift
	RootPart.Velocity = Vector3.new()
	RootPart.RotVelocity = Vector3.new()
	
	-- Match their velocity for prediction
	RootPart.AssemblyLinearVelocity = THead.AssemblyLinearVelocity
end)

-- Heartbeat backup for physics
RunService.Heartbeat:Connect(function()
	if not targetPlayer or targetPlayer.Parent ~= Players then return end
	
	local TCharacter = targetPlayer.Character
	if not TCharacter then return end
	
	local THead = TCharacter:FindFirstChild("Head")
	if not THead then return end
	
	-- Force position again
	RootPart.CFrame = CFrame.new(THead.Position + Vector3.new(0, 2, 0))
	Character:SetPrimaryPartCFrame(CFrame.new(THead.Position + Vector3.new(0, 2, 0)))
end)

-- Handle respawns
targetPlayer.CharacterAdded:Connect(function()
	wait(1)
	setupFollow()
end)

print("ZERO-DELAY HEADSIT on " .. targetPlayer.Name .. " using Physics Constraints!")
