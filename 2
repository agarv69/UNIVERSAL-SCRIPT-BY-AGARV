	local BLACK = Color3.new(0, 0, 0)
	local ACCENT = Color3.fromRGB(0, 123, 255)
	
	local function getScreenGui()
		local parent = SaveRow
		while parent do
			if parent:IsA("ScreenGui") then return parent end
			parent = parent.Parent
		end
	end
	
	local function readFile()
		local success, result = pcall(function()
			return readfile(FILE_NAME)
		end)
		if success and result and result ~= "" then return result end
		return nil
	end
	
	local function writeFile(content)
		pcall(function()
			writefile(FILE_NAME, content)
		end)
	end
	
	local function isTickBox(child)
		if not child:IsA("TextButton") then return false end
		if not child.Name:match("TickBox$") then return false end
		return true
	end
	
	local function isOn(tickbox)
		return tickbox.BackgroundColor3 ~= BLACK
	end
	
	local function loadSave()
		local data = readFile()
		if not data then return nil end
		local decoded = {}
		for line in data:gmatch("[^\n]+") do
			local key, value = line:match("(.-)=(.+)")
			if key and value then
				decoded[key] = value
			end
		end
		if decoded["saveEnabled"] ~= "true" then return nil end
		return next(decoded) and decoded or nil
	end
	
	local function saveData()
		if not saveEnabled then return end
		local lines = {}
		table.insert(lines, "saveEnabled=true")
	
		local contentArea = getScreenGui().MainFrame.ContentArea
		for _, page in pairs(contentArea:GetChildren()) do
			if page:IsA("Frame") then
				for _, side in pairs(page:GetChildren()) do
					if side:IsA("Frame") then
						for _, group in pairs(side:GetChildren()) do
							if group:IsA("Frame") then
								for _, row in pairs(group:GetChildren()) do
									if row:IsA("Frame") and string.find(row.Name, "Row") then
										for _, child in pairs(row:GetChildren()) do
											if isTickBox(child) then
												local state = isOn(child) and "ON" or "OFF"
												table.insert(lines, row.Name .. "_" .. child.Name .. "=" .. state)
											end
											if child:IsA("TextBox") then
												local text = child.Text ~= "" and child.Text or "empty"
												table.insert(lines, row.Name .. "_" .. child.Name .. "_text=" .. text)
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	
		writeFile(table.concat(lines, "\n"))
	end
	
	local function applyLoad(data)
		if not data or isApplyingLoad then return end
		isApplyingLoad = true
	
		local contentArea = getScreenGui().MainFrame.ContentArea
		task.wait(0.5)
	
		for _, page in pairs(contentArea:GetChildren()) do
			if page:IsA("Frame") then
				for _, side in pairs(page:GetChildren()) do
					if side:IsA("Frame") then
						for _, group in pairs(side:GetChildren()) do
							if group:IsA("Frame") then
								for _, row in pairs(group:GetChildren()) do
									if row:IsA("Frame") and string.find(row.Name, "Row") then
										for _, child in pairs(row:GetChildren()) do
											if isTickBox(child) then
												local savedValue = data[row.Name .. "_" .. child.Name]
												if savedValue == "ON" and not isOn(child) then
													pcall(function()
														firesignal(child.MouseButton1Click)
													end)
													task.wait(0.15)
												end
											end
											if child:IsA("TextBox") then
												local savedText = data[row.Name .. "_" .. child.Name .. "_text"]
												if savedText and savedText ~= "empty" then
													child.Text = savedText
												end
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	
		task.wait(0.5)
		isApplyingLoad = false
	end
	
	task.spawn(function()
		while true do
			task.wait(2)
			if saveEnabled then
				saveData()
			end
		end
	end)
	
	script.AncestryChanged:Connect(function()
		if not script:IsDescendantOf(game) then
			saveData()
		end
	end)
	
	LocalPlayer.AncestryChanged:Connect(function()
		if saveEnabled then
			saveData()
		end
	end)
	
	SaveTickBox.MouseButton1Click:Connect(function()
		saveEnabled = not saveEnabled
		SaveTickBox.BackgroundColor3 = saveEnabled and ACCENT or BLACK
		if saveEnabled then
			saveData()
		else
			writeFile("saveEnabled=false")
		end
	end)
	
	task.spawn(function()
		task.wait(1.5)
		local data = loadSave()
		if not data then return end
		saveEnabled = true
		SaveTickBox.BackgroundColor3 = ACCENT
		applyLoad(data)
	end)
end;
