local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Pick a random player
local function getRandomPlayer()
	local allPlayers = Players:GetPlayers()
	local otherPlayers = {}
	
	for _, player in pairs(allPlayers) do
		if player ~= LocalPlayer then
			table.insert(otherPlayers, player)
		end
	end
	
	if #otherPlayers > 0 then
		return otherPlayers[math.random(1, #otherPlayers)]
	end
	return nil
end

local targetPlayer = getRandomPlayer()

if not targetPlayer then
	warn("No other players in server!")
	return
end

print("Following: " .. targetPlayer.Name)

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- Disable all character physics to reduce server checks
for _, part in pairs(Character:GetDescendants()) do
	if part:IsA("BasePart") then
		part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
		part.CanCollide = false
	end
end

-- Create BodyVelocity for SERVER-SIDE movement
local BV = Instance.new("BodyVelocity")
BV.Parent = RootPart
BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
BV.Velocity = Vector3.new(0, 0, 0)

-- Create BodyGyro to keep upright
local BG = Instance.new("BodyGyro")
BG.Parent = RootPart
BG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
BG.D = 5000
BG.P = 50000

-- Disable seat so you can't be thrown off
Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

-- MAIN TRACKING LOOP - Using VELOCITY instead of CFrame
local connection
connection = RunService.Heartbeat:Connect(function(delta)
	if not targetPlayer or targetPlayer.Parent ~= Players then
		if connection then connection:Disconnect() end
		if BV then BV:Destroy() end
		if BG then BG:Destroy() end
		return
	end
	
	local TCharacter = targetPlayer.Character
	if not TCharacter then return end
	
	local THead = TCharacter:FindFirstChild("Head")
	if not THead then return end
	
	-- Calculate target position
	local targetPos = THead.Position + Vector3.new(0, 2.5, 0)
	local currentPos = RootPart.Position
	
	-- Calculate the velocity needed to reach target INSTANTLY
	local displacement = targetPos - currentPos
	local velocityNeeded = displacement / delta -- Distance / time = velocity
	
	-- Apply MASSIVE velocity to force instant movement
	BV.Velocity = velocityNeeded * 10 -- Multiply for even faster response
	
	-- Also do direct CFrame for client-side smoothness
	RootPart.CFrame = CFrame.new(targetPos)
	Character:SetPrimaryPartCFrame(CFrame.new(targetPos))
	
	-- Keep upright
	BG.CFrame = CFrame.new(RootPart.Position)
end)

-- SECONDARY LOOP - RenderStepped for visual smoothness on YOUR screen
RunService.RenderStepped:Connect(function()
	if not targetPlayer or targetPlayer.Parent ~= Players then return end
	
	local TCharacter = targetPlayer.Character
	if not TCharacter then return end
	
	local THead = TCharacter:FindFirstChild("Head")
	if not THead then return end
	
	-- Direct visual update
	RootPart.CFrame = CFrame.new(THead.Position + Vector3.new(0, 2.5, 0))
end)

-- Handle respawns
targetPlayer.CharacterAdded:Connect(function()
	wait(1)
	Character = LocalPlayer.Character
	RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
end)

print("SERVER-SIDE INSTANT HEADSIT on " .. targetPlayer.Name)
