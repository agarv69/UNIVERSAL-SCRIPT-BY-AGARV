			else
				if IsOnMobile then
					unmobilefly()
				else
					NOFLY()
				end
			end
		end
	})
	
	
	
	
	
	
	
	-- ====================================================================================================
	-- WALKSPEED CONFIGS
	-- ====================================================================================================
	local LocalPlayer = game:GetService("Players").LocalPlayer
	local RunService = game:GetService("RunService")
	
	local walkspeedValue = 16
	local walkspeedEnabled = false
	local walkspeedLoop = nil
	
	_G.CreateTextbox({
		frame = "Walkspeed",
		textboxname = "WalkspeedChanger",
