-- LocalScript in StarterPlayer > StarterCharacterScripts

local player = game.Players.LocalPlayer
local character = script.Parent
local humanoid = character:WaitForChild("Humanoid")

-- Monitor for death/respawn
humanoid.Died:Connect(function()
    -- Wait a brief moment for the death to register
    wait(0.1)
    
    -- Force unlock inventory by resetting BackpackEnabled
    player.PlayerGui:SetTopbarTransparency(0)
    
    -- Reset walkspeed if it's stuck at 0
    if humanoid.WalkSpeed == 0 then
        humanoid.WalkSpeed = 16 -- Default walkspeed
    end
    
    -- Fix camera after respawn
    workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    workspace.CurrentCamera.CameraSubject = humanoid
end)

-- Additional safeguard: periodically check if stuck
spawn(function()
    while wait(1) do
        if humanoid.Health > 0 and humanoid.WalkSpeed == 0 then
            -- Player is alive but stuck at 0 walkspeed (vampire ability effect)
            wait(3.1) -- Wait slightly longer than the 3-second freeze
            
            if humanoid.WalkSpeed == 0 then
                humanoid.WalkSpeed = 16
            end
        end
    end
end)

-- Camera fix function
local function fixCamera()
    workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    workspace.CurrentCamera.CameraSubject = humanoid
end

-- Monitor for camera issues
workspace.CurrentCamera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
    if workspace.CurrentCamera.CameraSubject ~= humanoid and humanoid.Health > 0 then
        fixCamera()
    end
end)
