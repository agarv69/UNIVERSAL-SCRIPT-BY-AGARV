local function getAdmin()
	local highestTime = 0
	local admin = nil
	for _, plr in pairs(Players:GetPlayers()) do
		local leaderstats = plr:FindFirstChild("leaderstats")
		if leaderstats then
			local timeValue = leaderstats:FindFirstChild("Time")
			if timeValue and timeValue.Value > highestTime then
				highestTime = timeValue.Value
				admin = plr
			end
		end
	end
	return admin, highestTime
end

local function getThumbnail(userId)
	local success, result = pcall(function()
		return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
	end)
	return success and result or ""
end

