local function C_3()
local script = G2L["3"];
	local frame = script.Parent.MainFrame
	
	-- Configuration
	local BASE_WIDTH = 500
	local BASE_HEIGHT = 350
	local MAX_WIDTH = 550
	local MAX_HEIGHT = 400
	local PADDING = 10  -- Pixels from edge of screen
	
	local function rescaler()
		local viewportSize = workspace.CurrentCamera.ViewportSize
		local screenX = viewportSize.X
		local screenY = viewportSize.Y
	
		local isMobile = screenX < 600
	
		local newWidth, newHeight
	
		if isMobile then
			newWidth = math.clamp(screenX * 0.7, 280, 360)
			newHeight = math.clamp(screenY * 0.45, 200, 270)
		else
			newWidth = math.clamp(screenX * 0.35, 450, MAX_WIDTH)
			newHeight = math.clamp(screenY * 0.45, 320, MAX_HEIGHT)
		end
	
		-- Calculate centered position
		local posX = (screenX - newWidth) / 2
		local posY = (screenY - newHeight) / 2
	
		-- Check if GUI goes off screen and adjust
		if posX < PADDING then
			posX = PADDING  -- Too far left
		elseif posX + newWidth > screenX - PADDING then
			posX = screenX - newWidth - PADDING  -- Too far right
		end
	
		if posY < PADDING then
			posY = PADDING  -- Too far up
		elseif posY + newHeight > screenY - PADDING then
			posY = screenY - newHeight - PADDING  -- Too far down
		end
	
		frame.Size = UDim2.new(0, newWidth, 0, newHeight)
		frame.Position = UDim2.new(0, posX, 0, posY)
	end
	
	rescaler()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescaler)
end;
