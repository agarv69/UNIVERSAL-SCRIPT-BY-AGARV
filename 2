-- Roblox Script: Auto-send "67" in chat with UI toggle
-- Execute this script to send "67" and rejoin with a toggle UI

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer

-- Create UI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Chat67UI"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Try to parent to CoreGui, fallback to PlayerGui if that fails
local success = pcall(function()
	screenGui.Parent = CoreGui
end)
if not success then
	screenGui.Parent = player:WaitForChild("PlayerGui")
end

-- Main Frame
local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 200, 0, 100)
mainFrame.Position = UDim2.new(0, 10, 0, 10) -- Top left
mainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
mainFrame.BorderSizePixel = 2
mainFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
mainFrame.Parent = screenGui

-- Add corner rounding
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = mainFrame

-- Title Label
local titleLabel = Instance.new("TextLabel")
titleLabel.Name = "TitleLabel"
titleLabel.Size = UDim2.new(1, 0, 0, 30)
titleLabel.Position = UDim2.new(0, 0, 0, 0)
titleLabel.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
titleLabel.BorderSizePixel = 0
titleLabel.Text = "67 Chat Script"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextSize = 16
titleLabel.Font = Enum.Font.GothamBold
titleLabel.Parent = mainFrame

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 8)
titleCorner.Parent = titleLabel

-- Toggle Button
local toggleButton = Instance.new("TextButton")
toggleButton.Name = "ToggleButton"
toggleButton.Size = UDim2.new(0, 180, 0, 35)
toggleButton.Position = UDim2.new(0, 10, 0, 40)
toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
toggleButton.BorderSizePixel = 0
toggleButton.Text = "✓ Enabled"
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.TextSize = 14
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Parent = mainFrame

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 6)
buttonCorner.Parent = toggleButton

-- Rejoin Button
local rejoinButton = Instance.new("TextButton")
rejoinButton.Name = "RejoinButton"
rejoinButton.Size = UDim2.new(0, 180, 0, 35)
rejoinButton.Position = UDim2.new(0, 10, 0, 80)
rejoinButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
rejoinButton.BorderSizePixel = 0
rejoinButton.Text = "↻ Rejoin Server"
rejoinButton.TextColor3 = Color3.fromRGB(255, 255, 255)
rejoinButton.TextSize = 14
rejoinButton.Font = Enum.Font.GothamBold
rejoinButton.Parent = mainFrame

-- Adjust frame height to fit rejoin button
mainFrame.Size = UDim2.new(0, 200, 0, 125)

local rejoinCorner = Instance.new("UICorner")
rejoinCorner.CornerRadius = UDim.new(0, 6)
rejoinCorner.Parent = rejoinButton

-- Make UI draggable
local dragging = false
local dragInput, mousePos, framePos

mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		mousePos = input.Position
		framePos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		dragInput = input
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - mousePos
		mainFrame.Position = UDim2.new(
			framePos.X.Scale,
			framePos.X.Offset + delta.X,
			framePos.Y.Scale,
			framePos.Y.Offset + delta.Y
		)
	end
end)

-- State management
local enabled = true

-- Function to send message in chat
local function sendChatMessage(message)
	local success, err = pcall(function()
		-- Try new TextChatService first (newer Roblox)
		local TextChatService = game:GetService("TextChatService")
		local textChannels = TextChatService:WaitForChild("TextChannels", 2)

		if textChannels then
			local generalChannel = textChannels:FindFirstChild("RBXGeneral")
			if generalChannel then
				generalChannel:SendAsync(message)
				return
			end
		end

		-- Fallback to legacy chat
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local chatEvents = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 2)
		if chatEvents then
			local sayMessage = chatEvents:WaitForChild("SayMessageRequest", 2)
			if sayMessage then
				sayMessage:FireServer(message, "All")
			end
		end
	end)

	if not success then
		warn("Failed to send chat message:", err)
	else
		print("Sent '67' in chat")
	end
end

-- Function to save state
local function saveState()
	if writefile then
		writefile("roblox_67_enabled.txt", tostring(enabled))
	end
end

-- Function to load state
local function loadState()
	if isfile and readfile then
		local success, content = pcall(function()
			return readfile("roblox_67_enabled.txt")
		end)

		if success and content == "false" then
			enabled = false
		end
	end
end

-- Function to update button appearance
local function updateButton()
	if enabled then
		toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
		toggleButton.Text = "✓ Enabled"
	else
		toggleButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
		toggleButton.Text = "✗ Disabled"
	end
	saveState()
end

-- Toggle button click
toggleButton.MouseButton1Click:Connect(function()
	enabled = not enabled
	updateButton()
	print("67 script", enabled and "enabled" or "disabled")
end)

-- Function to rejoin server
local function rejoinServer()
	local placeId = game.PlaceId
	local jobId = game.JobId

	-- Save that we're rejoining (only if enabled)
	if enabled and writefile then
		writefile("roblox_67_rejoin.txt", "true")
	end

	print("Rejoining server...")

	-- Teleport to the same server
	if jobId and jobId ~= "" then
		TeleportService:TeleportToPlaceInstance(placeId, jobId, player)
	else
		-- If no JobId, just rejoin any server
		TeleportService:Teleport(placeId, player)
	end
end

-- Rejoin button click
rejoinButton.MouseButton1Click:Connect(function()
	rejoinServer()
end)

-- Load previous state
loadState()
updateButton()

-- Check if we just rejoined
local shouldSendOnLoad = false
if isfile and readfile then
	local success, content = pcall(function()
		return readfile("roblox_67_rejoin.txt")
	end)

	if success and content == "true" then
		shouldSendOnLoad = true
		-- Delete the marker file
		if delfile then
			pcall(function()
				delfile("roblox_67_rejoin.txt")
			end)
		end
	end
end

-- Send "67" on execution or rejoin
wait(1) -- Small delay to ensure everything is loaded

if shouldSendOnLoad and enabled then
	-- We rejoined and it's enabled
	wait(1) -- Extra delay after rejoin
	sendChatMessage("67")
	print("Rejoined - Sent '67' in chat")
elseif not shouldSendOnLoad then
	-- First execution
	sendChatMessage("67")
	print("Script executed - Sent '67' in chat")
end

print("67 Chat Script loaded! Toggle enabled/disabled in the UI (top left)")
print("Click 'Rejoin Server' to rejoin and send '67' again (if enabled)")
