		textbox.Size = UDim2.new(1, 0, 0, math.max(result.Y + 20, 250))
	end
end

task.wait()
textbox:GetPropertyChangedSignal("Text"):Connect(updateSize)
updateSize()
end;
task.spawn(C_1f);

return _i["1"], require;
