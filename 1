		local lowerPartial = partial:lower()
		for _, p in pairs(Players:GetPlayers()) do
			if p.Name:lower():sub(1, #lowerPartial) == lowerPartial then
				return p
			end
			if p.DisplayName:lower():sub(1, #lowerPartial) == lowerPartial then
