		if brickAge < 70 then return end
	
		breakLog[deleterName] = breakLog[deleterName] or {}
		local now = tick()
		table.insert(breakLog[deleterName], now)
	
		local valid = {}
		for _, t in ipairs(breakLog[deleterName]) do
			if now - t <= BLOCK_COOLDOWN then
				table.insert(valid, t)
			end
		end
		breakLog[deleterName] = valid
	
		if #valid >= DELETE_LIMIT then
			handleDetection(player)
			breakLog[deleterName] = {}
		end
	end)
	
	-- ============================================================
	-- ENABLE / DISABLE
	-- ============================================================
	local function enable()
		isEnabled = true
		breakLog = {}
		detectedPlayers = {}
		lastSeenLog = shared.GriefLog or ""
		if ProtectionAccentColor then
