-- StarterGui.AUTOBUILD.MAIN.Display.display
local function C_b()
local script = G2L["b"];
	local textlabel = script.Parent
	local textbox = textlabel.Parent.ScrollingFrame.TextBox
	
	local function getPlacedBlocks()
		local count = 0
		local bricksFolder = workspace:FindFirstChild("Bricks")
		if bricksFolder then
			local playerFolder = bricksFolder:FindFirstChild(game.Players.LocalPlayer.Name)
			if playerFolder then
				for _, brick in pairs(playerFolder:GetChildren()) do
					if brick:IsA("BasePart") and brick.Name == "Brick" then
						count = count + 1
					end
				end
			end
		end
		return count
	end
	
	local function update()
		local text = textbox.Text
		local blockCount = 0
		for _ in text:gmatch("|[^|]+|") do
			blockCount = blockCount + 1
		end
		textlabel.Text = "Blocks: " .. getPlacedBlocks() .. "/" .. blockCount .. "<br/>Char: " .. #text
	end
	
	textbox:GetPropertyChangedSignal("Text"):Connect(update)
	
	task.spawn(function()
		while true do
			task.wait(1)
			update()
		end
	end)
	
	update()
end;
task.spawn(C_b);
