local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function getBricksFolder()
	return workspace:FindFirstChild("Bricks")
end

local function findClosestBrick()
	local bricksFolder = getBricksFolder()
	if not bricksFolder then return nil end
	
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	
	local closestBrick = nil
	local closestDist = math.huge
	
	for _, child in pairs(bricksFolder:GetDescendants()) do
		if child:IsA("BasePart") and child.Name == "Brick" then
			local dist = (child.Position - hrp.Position).Magnitude
			if dist < closestDist then
				closestDist = dist
				closestBrick = child
			end
		end
	end
	
	return closestBrick
end

local function snapToGrid(position)
	return Vector3.new(
		math.round(position.X),
		math.round(position.Y),
		math.round(position.Z)
	)
end

-- Main execution
local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
if not hrp then
	warn("HRP not found!")
	return
end

local closestBrick = findClosestBrick()
if not closestBrick then
	warn("No bricks found!")
	return
end

-- Snap HRP position to grid
local snappedPos = snapToGrid(hrp.Position)

-- Move brick to snapped HRP position
closestBrick.Position = snappedPos

print("Moved brick to snapped position:", snappedPos)
