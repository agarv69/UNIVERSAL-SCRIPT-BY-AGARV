-- ============================================================================
-- UTILITY FUNCTIONS
-- ============================================================================
local function hexToColor(hex)
	local r = tonumber(hex:sub(1, 2), 16) / 255
	local g = tonumber(hex:sub(3, 4), 16) / 255
	local b = tonumber(hex:sub(5, 6), 16) / 255
	return Color3.new(r, g, b)
end

local function equipAllTools()
	if not LocalPlayer.Character then return end
	
	for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
		if tool:IsA("Tool") then
			tool.Parent = LocalPlayer.Character
		end
	end
end

local function findBuildTools()
	local tools = {}
	local locations = {LocalPlayer.Character, LocalPlayer.Backpack}
	
	for _, location in pairs(locations) do
		if location then
			for _, item in pairs(location:GetChildren()) do
				if item:IsA("Tool") and item.Name == "Build" then
					local remote = item:FindFirstChild("Script", true) 
						and item.Script:FindFirstChild("Event")
					if remote then
						table.insert(tools, {tool = item, event = remote})
					end
				end
			end
		end
	end
	
	return tools
end

local function findShapeTool()
	local locations = {LocalPlayer.Character, LocalPlayer.Backpack}
	
	for _, location in pairs(locations) do
		if location then
			for _, item in pairs(location:GetChildren()) do
				if item:IsA("Tool") and item.Name == "Shape" then
					local remote = item:FindFirstChild("Script", true) 
						and item.Script:FindFirstChild("Event")
					if remote then
						return {tool = item, event = remote}
					end
				end
			end
		end
	end
	
	return nil
end

local function getPlayerBricksFolder()
	local bricksFolder = workspace:FindFirstChild("Bricks")
	if not bricksFolder then return nil end
	
	return bricksFolder:FindFirstChild(LocalPlayer.Name)
end

-- ============================================================================
-- GET NEWEST BRICK
-- ============================================================================
local function getNewestBrick()
	local playerFolder = getPlayerBricksFolder()
	if not playerFolder then return nil end
	
	local bricks = {}
	for _, brick in pairs(playerFolder:GetChildren()) do
		if brick:IsA("BasePart") and brick.Name == "Brick" then
			table.insert(bricks, brick)
		end
	end
	
	return bricks[#bricks]
end

-- ============================================================================
-- POSITION LOCKING
-- ============================================================================
local positionLock = nil

local function lockPosition(targetPos)
	if positionLock then
		positionLock:Disconnect()
	end
	
	positionLock = RunService.RenderStepped:Connect(function()
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local hrp = char.HumanoidRootPart
			hrp.CFrame = CFrame.new(targetPos)
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end)
end

local function unlockPosition()
	if positionLock then
		positionLock:Disconnect()
		positionLock = nil
	end
end

-- ============================================================================
-- BLOCK DETECTION
-- ============================================================================
local function findBlockNear(targetPos, searchRadius)
	local playerFolder = getPlayerBricksFolder()
	if not playerFolder then return nil end
	
	local closestBrick = nil
	local closestDist = searchRadius or CONFIG.POSITION_CHECK_TOLERANCE
	
	for _, brick in pairs(playerFolder:GetChildren()) do
		if brick:IsA("BasePart") and brick.Name == "Brick" then
			local dist = (brick.Position - targetPos).Magnitude
			if dist < closestDist then
				closestBrick = brick
				closestDist = dist
			end
		end
	end
	
	return closestBrick
end

-- ============================================================================
-- RESIZE CALCULATION
-- ============================================================================
local function calculateResizeFaces(targetSize, targetPos, actualPos)
	local sizeX, sizeY, sizeZ = targetSize.X, targetSize.Y, targetSize.Z
	local offsetX = actualPos.X - targetPos.X
	local offsetY = actualPos.Y - targetPos.Y
	local offsetZ = actualPos.Z - targetPos.Z
	
	local growX = sizeX - 1
	local growY = sizeY - 1
	local growZ = sizeZ - 1
	
	local rightResize, leftResize
	if sizeX % 2 == 1 then
		rightResize = growX / 2
		leftResize = growX / 2
	else
		if offsetX > 0 then
			rightResize = growX / 2 - 0.5
			leftResize = growX / 2 + 0.5
		else
			rightResize = growX / 2 + 0.5
			leftResize = growX / 2 - 0.5
		end
	end
	
	local topResize, bottomResize
	if sizeY % 2 == 1 then
		topResize = growY / 2
		bottomResize = growY / 2
	else
		if offsetY > 0 then
			topResize = growY / 2 - 0.5
			bottomResize = growY / 2 + 0.5
		else
			topResize = growY / 2 + 0.5
			bottomResize = growY / 2 - 0.5
		end
	end
	
	local frontResize, backResize
	if sizeZ % 2 == 1 then
		frontResize = growZ / 2
		backResize = growZ / 2
	else
		if offsetZ > 0 then
			frontResize = growZ / 2 + 0.5
			backResize = growZ / 2 - 0.5
		else
			frontResize = growZ / 2 - 0.5
			backResize = growZ / 2 + 0.5
		end
	end
	
	return {
		Left = leftResize,
		Right = rightResize,
		Top = topResize,
		Bottom = bottomResize,
		Front = frontResize,
		Back = backResize
	}
end

-- ============================================================================
-- SHAPE TOOL RESIZING
-- ============================================================================
local function resizeBlock(brick, targetSize, targetPos)
	local shapeTool = findShapeTool()
	if not shapeTool then
		warn("Shape tool not found!")
		return false
	end
	
	if not brick then
		warn("No brick provided to resize!")
		return false
	end
	
	-- Wait before starting resize
	task.wait(CONFIG.WAIT_BEFORE_RESIZE)
	
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		warn("No HumanoidRootPart found!")
		return false
	end
	
	local hrpPos = hrp.Position
	
	print(string.format("\n=== RESIZING BLOCK ==="))
	print(string.format("Target Size: %.1fx%.1fx%.1f", targetSize.X, targetSize.Y, targetSize.Z))
	print(string.format("Target Pos: (%.1f, %.1f, %.1f)", targetPos.X, targetPos.Y, targetPos.Z))
	
	local faceOrder = {
		{face = Enum.NormalId.Left, name = "Left"},
		{face = Enum.NormalId.Right, name = "Right"},
		{face = Enum.NormalId.Top, name = "Top"},
		{face = Enum.NormalId.Bottom, name = "Bottom"},
		{face = Enum.NormalId.Front, name = "Front"},
		{face = Enum.NormalId.Back, name = "Back"}
	}
	
	for _, faceData in ipairs(faceOrder) do
		-- Get newest brick and recalculate BEFORE each face
		local currentBrick = getNewestBrick()
		if not currentBrick then
			warn("Lost track of brick!")
			return false
		end
		
		local actualPos = currentBrick.Position
		local resizeFaces = calculateResizeFaces(targetSize, targetPos, actualPos)
		
		local amount = resizeFaces[faceData.name]
		
		if amount > 0 then
			print(string.format("\nResizing %s face: %.1f studs (Pos: %.1f, %.1f, %.1f)", faceData.name, amount, actualPos.X, actualPos.Y, actualPos.Z))
			
			for i = 1, math.floor(amount) do
				-- Get newest brick again before each resize
				currentBrick = getNewestBrick()
				if not currentBrick then
					warn("Lost track of brick!")
					return false
				end
				
				pcall(function()
					shapeTool.event:FireServer(currentBrick, faceData.face, hrpPos, "increase")
				end)
				print(string.format("  %s: Increase #%d", faceData.name, i))
				task.wait(CONFIG.RESIZE_WAIT_TIME)
			end
		end
	end
	
	print("=== RESIZE COMPLETE ===\n")
	return true
end

-- ============================================================================
-- PARSE BUILD STRING
-- ============================================================================
local function parseBlocks(buildStr)
	local blocks = {}
	
	for blockData in buildStr:gmatch("|([^|]+)") do
		local colorHex = blockData:sub(1, 6)
		local materialSymbol = blockData:sub(7, 7)
		local rest = blockData:sub(8)
		
		local canCollide = true
		if rest:sub(1, 1) == "^" then
			canCollide = false
			rest = rest:sub(2)
		end
		
		local sizeData, posData = rest:match("([^%.]+)%.(.+)")
		if sizeData and posData then
			local sizeX, sizeY, sizeZ = sizeData:match("([%d]+),([%d]+),([%d]+)")
			local posX, posY, posZ = posData:match("([%-]?%d+%.?%d*),([%-]?%d+%.?%d*),([%-]?%d+%.?%d*)")
			
			if sizeX and posX then
				local size = Vector3.new(tonumber(sizeX), tonumber(sizeY), tonumber(sizeZ))
				local centerPos = Vector3.new(tonumber(posX), tonumber(posY), tonumber(posZ))
				
				local needsResize = (size ~= Vector3.new(4, 4, 4))
				local needsShapeResize = needsResize and (size ~= Vector3.new(1, 1, 1))
				
				table.insert(blocks, {
					size = size,
					centerPos = centerPos,
					color = hexToColor(colorHex),
					material = SymbolToMaterial[materialSymbol] or Enum.Material.SmoothPlastic,
					canCollide = canCollide,
					needsResize = needsResize,
					needsShapeResize = needsShapeResize
				})
			end
		end
	end
	
	return blocks
end

-- ============================================================================
-- VISUALIZATION
-- ============================================================================
local function createPreviews(blocks)
	local folder = Instance.new("Folder")
	folder.Name = "BuildPreview"
	folder.Parent = workspace
	
	for i, blockData in ipairs(blocks) do
		local preview = Instance.new("Part")
		preview.Name = "Preview_" .. i
		preview.Size = blockData.size
		preview.CFrame = CFrame.new(blockData.centerPos)
		preview.Anchored = true
		preview.CanCollide = false
		preview.Material = blockData.material
		preview.Color = blockData.color
		preview.Transparency = 0.6
		preview.Parent = folder
		
		blockData.preview = preview
	end
	
	return folder
end

-- ============================================================================
-- BLOCK PLACEMENT
-- ============================================================================
local function placeBlock(blockData, buildTools, blockIndex, totalBlocks)
	if #buildTools == 0 then
		warn("No build tools available!")
		return false
	end
	
	local buildPos = blockData.centerPos + Vector3.new(0, CONFIG.BUILD_HEIGHT_OFFSET, 0)
	lockPosition(buildPos)
	task.wait(0.1)
	
	local existing = findBlockNear(blockData.centerPos, 1)
	if existing then
		blockData.placedBrick = existing
		
		if blockData.needsShapeResize then
			resizeBlock(existing, blockData.size, blockData.centerPos)
		end
		
		return true
	end
	
	local placeMode = blockData.needsResize and "detailed" or "normal"
	local placePos = blockData.centerPos
	
	local toolIndex = 0
	local startTime = tick()
	
	while tick() - startTime < CONFIG.PLACEMENT_TIMEOUT do
		toolIndex = (toolIndex % #buildTools) + 1
		local bt = buildTools[toolIndex]
		
		pcall(function()
			bt.event:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, placeMode)
		end)
		
		task.wait(0.05)
		
		local brick = findBlockNear(blockData.centerPos, 3)
		if brick then
			blockData.placedBrick = brick
			print(string.format("✓ [%d/%d] Block placed at (%.1f, %.1f, %.1f)", blockIndex, totalBlocks, brick.Position.X, brick.Position.Y, brick.Position.Z))
			
			if blockData.needsShapeResize then
				resizeBlock(brick, blockData.size, blockData.centerPos)
			end
			
			return true
		end
	end
	
	return false
end

-- ============================================================================
-- MAIN BUILD PROCESS
-- ============================================================================
local function main()
	print("=== AUTO-BUILD STARTING ===")
	
	local blocks = parseBlocks(buildString)
	print("Loaded " .. #blocks .. " blocks to build")
	
	if #blocks == 0 then
		warn("No blocks found in build string!")
		return
	end
	
	local previewFolder = createPreviews(blocks)
	print("Created preview visualization")
	
	equipAllTools()
	task.wait(0.5)
	
	local buildTools = findBuildTools()
	if #buildTools == 0 then
		warn("No build tools found! Make sure you have Build tools equipped.")
		return
	end
	print("Found " .. #buildTools .. " build tools")
	
	local shapeTool = findShapeTool()
	if shapeTool then
		print("Found Shape tool")
	else
		warn("Shape tool not found! Detailed blocks won't be resized correctly.")
	end
	
	task.spawn(function()
		while true do
			task.wait(CONFIG.TOOL_EQUIP_INTERVAL)
			equipAllTools()
		end
	end)
	
	local successCount = 0
	local failCount = 0
	local totalBlocks = #blocks
	
	for i, blockData in ipairs(blocks) do
		local success = placeBlock(blockData, buildTools, i, totalBlocks)
		
		if success then
			successCount = successCount + 1
			
			if blockData.preview then
				pcall(function() blockData.preview:Destroy() end)
			end
		else
			failCount = failCount + 1
			warn(string.format("✗ [%d/%d] Block FAILED", i, totalBlocks))
		end
		
		unlockPosition()
		task.wait(0.05)
		
		if i % 20 == 0 then
			buildTools = findBuildTools()
		end
	end
	
	print(string.format("\n=== BUILD COMPLETE ===\nSuccess: %d | Failed: %d", successCount, failCount))
	
	task.wait(1)
	if previewFolder then
		pcall(function() previewFolder:Destroy() end)
	end
	
	print("\n=== ALL DONE ===")
end

main()
