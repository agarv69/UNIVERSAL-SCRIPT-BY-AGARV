		for _, name in ipairs(wl:split(",")) do
			if name == playerName then return true end
		end
		return false
	end
	
	-- ============================================================
	-- CONFIG
	-- ============================================================
	local isEnabled = false
	local DELETE_LIMIT = 10
	local BLOCK_COOLDOWN = 10
	local TIME_THRESHOLD = 600
	local FLING_TIMEOUT = 10
	local FLING_SUCCESS_DIST = 150
	local FLING_SUCCESS_SPEED = 1000
	
	-- ============================================================
	-- STATE
	-- ============================================================
