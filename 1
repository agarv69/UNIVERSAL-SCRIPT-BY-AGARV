local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function getShapeTool()
	return LocalPlayer.Backpack:FindFirstChild("Shape")
		or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Shape"))
end

local function getShapeEvent()
	local tool = getShapeTool()
	if tool then
		return tool:FindFirstChild("Script") and tool.Script:FindFirstChild("Event")
	end
	return nil
end

local function resizeBlockInfiniteRange(block, targetSize)
	print("Starting resize for block at " .. tostring(block.Position))
	print("Current size: " .. tostring(block.Size))
	print("Target size: " .. targetSize .. "," .. targetSize .. "," .. targetSize)
	
	local shapeTool = getShapeTool()
	local shapeEvent = getShapeEvent()
	
	if not shapeTool or not shapeEvent then
		warn("Shape tool not found!")
		return false
	end
	
	if shapeTool.Parent == LocalPlayer.Backpack then
		LocalPlayer.Character.Humanoid:EquipTool(shapeTool)
		task.wait(0.2)
	end
	
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		warn("No HumanoidRootPart!")
		return false
	end
	
	-- Keep spamming until all axes match target
	local attempts = 0
	while attempts < 200 do
		local currentSize = block.Size
		
		if currentSize.X == targetSize and currentSize.Y == targetSize and currentSize.Z == targetSize then
			print("✓ Resize complete!")
			return true
		end
		
		-- Spam all axes that need adjusting
		if currentSize.X ~= targetSize then
			pcall(function()
				shapeEvent:FireServer(block, Enum.NormalId.Right, hrp.Position, currentSize.X < targetSize and "increase" or "decrease")
			end)
		end
		
		if currentSize.Y ~= targetSize then
			pcall(function()
				shapeEvent:FireServer(block, Enum.NormalId.Top, hrp.Position, currentSize.Y < targetSize and "increase" or "decrease")
			end)
		end
		
		if currentSize.Z ~= targetSize then
			pcall(function()
				shapeEvent:FireServer(block, Enum.NormalId.Back, hrp.Position, currentSize.Z < targetSize and "increase" or "decrease")
			end)
		end
		
		task.wait(0.05)
		attempts = attempts + 1
		
		if attempts % 20 == 0 then
			print("Attempt " .. attempts .. " - Current: " .. tostring(block.Size))
		end
	end
	
	warn("Failed after 200 attempts - Final size: " .. tostring(block.Size))
	return false
end

local bricksFolder = workspace:FindFirstChild("Bricks")
if bricksFolder then
	local playerFolder = bricksFolder:FindFirstChild(LocalPlayer.Name)
	if playerFolder then
		for _, block in pairs(playerFolder:GetChildren()) do
			if block:IsA("BasePart") and block.Name == "Brick" then
				local randomSize = math.random(1, 10)
				print("\n=== Resizing block ===")
				resizeBlockInfiniteRange(block, randomSize)
			end
		end
	end
end

print("\n=== Done ===")
