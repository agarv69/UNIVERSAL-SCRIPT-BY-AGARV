-- BLOCK SAVE & AUTO-BUILD SCRIPT
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local MaterialSymbols = {
	[Enum.Material.SmoothPlastic] = "!",
	[Enum.Material.Plastic] = "@",
	[Enum.Material.CeramicTiles] = "#",
	[Enum.Material.Brick] = "$",
	[Enum.Material.WoodPlanks] = "%",
	[Enum.Material.Ice] = "^",
	[Enum.Material.Grass] = "&",
	[Enum.Material.Sand] = "*",
	[Enum.Material.Snow] = "(",
	[Enum.Material.Glass] = ")",
	[Enum.Material.Wood] = "-",
	[Enum.Material.Slate] = "_",
	[Enum.Material.Pebble] = "=",
	[Enum.Material.Marble] = "+",
	[Enum.Material.Granite] = "[",
	[Enum.Material.DiamondPlate] = "]",
	[Enum.Material.Metal] = "{",
	[Enum.Material.Asphalt] = "}",
	[Enum.Material.Concrete] = "~",
	[Enum.Material.Pavement] = "`",
	[Enum.Material.Neon] = "?"
}

local function colorToHex(color3)
	local r = math.floor(color3.R * 255)
	local g = math.floor(color3.G * 255)
	local b = math.floor(color3.B * 255)
	return string.format("%02X%02X%02X", r, g, b)
end

local function hasDecimal(num)
	return num % 1 ~= 0
end

local bricksFolder = workspace:FindFirstChild("Bricks")
if not bricksFolder then
	warn("Bricks folder not found!")
	return
end

local buildString = ""
local blockCount = 0
local skippedCount = 0

for _, descendant in pairs(bricksFolder:GetDescendants()) do
	if descendant:IsA("BasePart") and descendant.Name == "Brick" then
		if not descendant.Anchored then
			skippedCount = skippedCount + 1
			continue
		end
		
		local size = descendant.Size
		if hasDecimal(size.X) or hasDecimal(size.Y) or hasDecimal(size.Z) then
			skippedCount = skippedCount + 1
			continue
		end
		
		local materialSymbol = MaterialSymbols[descendant.Material] or "!"
		local colorHex = colorToHex(descendant.Color)
		local cf = descendant.CFrame
		local canCollideMarker = descendant.CanCollide and "" or "^"
		
		buildString = buildString .. string.format(
			"|%s%s%s%.0f,%.0f,%.0f.%.1f,%.1f,%.1f|",
			colorHex,
			materialSymbol,
			canCollideMarker,
			size.X, size.Y, size.Z,
			cf.X, cf.Y, cf.Z
		)
		
		blockCount = blockCount + 1
	end
end

if buildString == "" or not buildString then
	warn("No blocks found to save!")
	print("Blocks scanned: " .. blockCount)
	print("Blocks skipped: " .. skippedCount)
	return
end

local fullScript = [[local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local buildString = ]] .. string.format("%q", buildString) .. [[

local SymbolToMaterial = {
	["!"] = Enum.Material.SmoothPlastic,
	["@"] = Enum.Material.Plastic,
	["#"] = Enum.Material.CeramicTiles,
	["$"] = Enum.Material.Brick,
	["%"] = Enum.Material.WoodPlanks,
	["^"] = Enum.Material.Ice,
	["&"] = Enum.Material.Grass,
	["*"] = Enum.Material.Sand,
	["("] = Enum.Material.Snow,
	[")"] = Enum.Material.Glass,
	["-"] = Enum.Material.Wood,
	["_"] = Enum.Material.Slate,
	["="] = Enum.Material.Pebble,
	["+"] = Enum.Material.Marble,
	["["] = Enum.Material.Granite,
	["]"] = Enum.Material.DiamondPlate,
	["{"] = Enum.Material.Metal,
	["}"] = Enum.Material.Asphalt,
	["~"] = Enum.Material.Concrete,
	["`"] = Enum.Material.Pavement,
	["?"] = Enum.Material.Neon
}

local function hexToColor(hex)
	local r = tonumber(hex:sub(1, 2), 16) / 255
	local g = tonumber(hex:sub(3, 4), 16) / 255
	local b = tonumber(hex:sub(5, 6), 16) / 255
	return Color3.new(r, g, b)
end

local function findBuildTools()
	local tools = {}
	
	if LocalPlayer.Character then
		for _, item in pairs(LocalPlayer.Character:GetChildren()) do
			if item:IsA("Tool") and item.Name == "Build" then
				local script = item:FindFirstChild("Script")
				local remote = script and script:FindFirstChild("Event")
				if remote then
					table.insert(tools, {bt = item, e = remote})
				end
			end
		end
	end
	
	for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
		if item:IsA("Tool") and item.Name == "Build" then
			local script = item:FindFirstChild("Script")
			local remote = script and script:FindFirstChild("Event")
			if remote then
				table.insert(tools, {bt = item, e = remote})
			end
		end
	end
	
	return tools
end

local visualFolder = Instance.new("Folder")
visualFolder.Name = "BuildPreview"
visualFolder.Parent = workspace

local blocks = {}
for blockData in buildString:gmatch("|([^|]+)") do
	local colorHex = blockData:sub(1, 6)
	local materialSymbol = blockData:sub(7, 7)
	local rest = blockData:sub(8)
	
	local canCollide = true
	if rest:sub(1, 1) == "^" then
		canCollide = false
		rest = rest:sub(2)
	end
	
	local sizeData, posData = rest:match("([^%.]+)%.(.+)")
	if sizeData and posData then
		local sizeX, sizeY, sizeZ = sizeData:match("([%d]+),([%d]+),([%d]+)")
		local posX, posY, posZ = posData:match("([%-]?%d+%.?%d*),([%-]?%d+%.?%d*),([%-]?%d+%.?%d*)")
		
		if sizeX and posX then
			local size = Vector3.new(tonumber(sizeX), tonumber(sizeY), tonumber(sizeZ))
			local position = Vector3.new(tonumber(posX), tonumber(posY), tonumber(posZ))
			
			local cornerOffset = Vector3.new(-size.X/2, -size.Y/2, -size.Z/2)
			local placePosition = position + cornerOffset
			
			local preview = Instance.new("Part")
			preview.Name = "PreviewBlock"
			preview.Size = size
			preview.Anchored = true
			preview.CanCollide = false
			preview.CFrame = CFrame.new(position)
			preview.Material = SymbolToMaterial[materialSymbol] or Enum.Material.SmoothPlastic
			preview.Color = hexToColor(colorHex)
			preview.Transparency = 0.5
			preview.Parent = visualFolder
			
			table.insert(blocks, {
				size = size,
				position = position,
				placePosition = placePosition,
				preview = preview,
				placed = false
			})
		end
	end
end

print("Loaded " .. #blocks .. " blocks")

local btools = findBuildTools()
if #btools == 0 then
	warn("No build tools found!")
	return
end

print("Found " .. #btools .. " build tools")

local bti = 0
local ws = 0.01
local bricksFolder = workspace:FindFirstChild("Bricks")
local playerFolder = bricksFolder and bricksFolder:FindFirstChild(LocalPlayer.Name)

local positionLock = nil

local function lockPosition(targetPos)
	if positionLock then
		positionLock:Disconnect()
	end
	
	positionLock = RunService.RenderStepped:Connect(function()
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
			LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(targetPos)
			LocalPlayer.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end
	end)
end

local function checkBlockExists(blockData)
	if not playerFolder then
		playerFolder = bricksFolder and bricksFolder:FindFirstChild(LocalPlayer.Name)
	end
	
	if not playerFolder then
		print("No player folder!")
		return false
	end
	
	-- Check ALL children in player folder
	local found = false
	for _, brick in pairs(playerFolder:GetChildren()) do
		if brick:IsA("BasePart") and brick.Name == "Brick" then
			local distance = (brick.Position - blockData.position).Magnitude
			if distance < 3 then
				found = true
				break
			end
		end
	end
	
	if found then
		print("FOUND BLOCK AT " .. tostring(blockData.position))
	else
		print("NO BLOCK AT " .. tostring(blockData.position))
	end
	
	return found
end

local verifyQueue = {}

task.spawn(function()
	print("Starting auto-build...")
	
	local currentIndex = 1
	
	while currentIndex <= #blocks or #verifyQueue > 0 do
		-- Place new blocks
		if currentIndex <= #blocks then
			local blockData = blocks[currentIndex]
			
			if not blockData.placed then
				-- Move to 10 studs above block
				local abovePos = blockData.position + Vector3.new(0, 10, 0)
				lockPosition(abovePos)
				
				task.wait(0.05)
				
				-- Get tool
				bti = bti + 1
				local bt = btools[(bti % #btools) + 1]
				
				-- Equip tool
				if LocalPlayer.Character and bt.bt.Parent ~= LocalPlayer.Character then
					pcall(function()
						LocalPlayer.Character.Humanoid:EquipTool(bt.bt)
					end)
				end
				
				-- Build mode
				local buildMode = "normal"
				local placePos = blockData.position
				
				if blockData.size ~= Vector3.new(4, 4, 4) then
					buildMode = "detailed"
					placePos = blockData.placePosition
				end
				
				-- Fire remote
				pcall(function()
					bt.e:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, buildMode)
				end)
				
				print("Placed block " .. currentIndex .. " at " .. tostring(blockData.position))
				
				-- Add to verify queue
				table.insert(verifyQueue, {
					blockData = blockData,
					index = currentIndex,
					verifyTime = tick() + 1
				})
				
				task.wait(ws / #btools)
			end
			
			currentIndex = currentIndex + 1
			
			if currentIndex % 20 == 0 then
				btools = findBuildTools()
			end
		end
		
		-- Check verify queue
		local i = 1
		while i <= #verifyQueue do
			local item = verifyQueue[i]
			
			if tick() >= item.verifyTime then
				-- Check if block exists
				if checkBlockExists(item.blockData) then
					-- BLOCK VERIFIED - MARK AS PLACED
					item.blockData.placed = true
					if item.blockData.preview then
						pcall(function()
							item.blockData.preview:Destroy()
						end)
					end
					print("✓ Verified block " .. item.index)
					table.remove(verifyQueue, i)
				else
					-- BLOCK MISSING - GO BACK AND PLACE IT
					print("✗ Block " .. item.index .. " MISSING, rebuilding...")
					
					local abovePos = item.blockData.position + Vector3.new(0, 10, 0)
					lockPosition(abovePos)
					task.wait(0.05)
					
					bti = bti + 1
					local bt = btools[(bti % #btools) + 1]
					
					if LocalPlayer.Character and bt.bt.Parent ~= LocalPlayer.Character then
						pcall(function()
							LocalPlayer.Character.Humanoid:EquipTool(bt.bt)
						end)
					end
					
					local buildMode = "normal"
					local placePos = item.blockData.position
					
					if item.blockData.size ~= Vector3.new(4, 4, 4) then
						buildMode = "detailed"
						placePos = item.blockData.placePosition
					end
					
					pcall(function()
						bt.e:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, buildMode)
					end)
					
					-- Update verify time
					item.verifyTime = tick() + 1
					i = i + 1
					
					task.wait(ws / #btools)
				end
			else
				i = i + 1
			end
		end
		
		task.wait()
	end
	
	if positionLock then
		positionLock:Disconnect()
		positionLock = nil
	end
	
	local finalPlaced = 0
	for _, blockData in ipairs(blocks) do
		if blockData.placed then
			finalPlaced = finalPlaced + 1
		end
	end
	
	print("=== BUILD COMPLETE ===")
	print("Placed: " .. finalPlaced .. "/" .. #blocks)
	visualFolder:Destroy()
end)]]

setclipboard(fullScript)
print("Auto-build script copied to clipboard!")
print("Blocks saved: " .. blockCount)
