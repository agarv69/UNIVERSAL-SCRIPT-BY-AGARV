-- BLOCK SAVE & AUTO-BUILD SCRIPT (8-24 STUD RANGE)
local HttpService = game:GetService("HttpService")

local MaterialSymbols = {
	[Enum.Material.SmoothPlastic] = "!",
	[Enum.Material.Plastic] = "@",
	[Enum.Material.CeramicTiles] = "#",
	[Enum.Material.Brick] = "$",
	[Enum.Material.WoodPlanks] = "%",
	[Enum.Material.Ice] = "^",
	[Enum.Material.Grass] = "&",
	[Enum.Material.Sand] = "*",
	[Enum.Material.Snow] = "(",
	[Enum.Material.Glass] = ")",
	[Enum.Material.Wood] = "-",
	[Enum.Material.Slate] = "_",
	[Enum.Material.Pebble] = "=",
	[Enum.Material.Marble] = "+",
	[Enum.Material.Granite] = "[",
	[Enum.Material.DiamondPlate] = "]",
	[Enum.Material.Metal] = "{",
	[Enum.Material.Asphalt] = "}",
	[Enum.Material.Concrete] = "~",
	[Enum.Material.Pavement] = "`",
	[Enum.Material.Neon] = "?"
}

local function colorToHex(color3)
	local r = math.floor(color3.R * 255)
	local g = math.floor(color3.G * 255)
	local b = math.floor(color3.B * 255)
	return string.format("%02X%02X%02X", r, g, b)
end

local function hasDecimal(num)
	return num % 1 ~= 0
end

local bricksFolder = workspace:FindFirstChild("Bricks")
if not bricksFolder then
	warn("Bricks folder not found!")
	return
end

local buildString = ""
local blockCount = 0
local skippedCount = 0

for _, descendant in pairs(bricksFolder:GetDescendants()) do
	if descendant:IsA("BasePart") and descendant.Name == "Brick" then
		if not descendant.Anchored then
			skippedCount = skippedCount + 1
			continue
		end
		
		local size = descendant.Size
		if hasDecimal(size.X) or hasDecimal(size.Y) or hasDecimal(size.Z) then
			skippedCount = skippedCount + 1
			continue
		end
		
		local materialSymbol = MaterialSymbols[descendant.Material] or "!"
		local colorHex = colorToHex(descendant.Color)
		local cf = descendant.CFrame
		local canCollideMarker = descendant.CanCollide and "" or "^"
		
		buildString = buildString .. string.format(
			"|%s%s%s%.0f,%.0f,%.0f.%.1f,%.1f,%.1f|",
			colorHex,
			materialSymbol,
			canCollideMarker,
			size.X, size.Y, size.Z,
			cf.X, cf.Y, cf.Z
		)
		
		blockCount = blockCount + 1
	end
end

if buildString == "" or not buildString then
	warn("No blocks found to save!")
	print("Blocks scanned: " .. blockCount)
	print("Blocks skipped: " .. skippedCount)
	return
end

local fullScript = [[local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local buildString = ]] .. string.format("%q", buildString) .. [[

local SymbolToMaterial = {
	["!"] = Enum.Material.SmoothPlastic,
	["@"] = Enum.Material.Plastic,
	["#"] = Enum.Material.CeramicTiles,
	["$"] = Enum.Material.Brick,
	["%"] = Enum.Material.WoodPlanks,
	["^"] = Enum.Material.Ice,
	["&"] = Enum.Material.Grass,
	["*"] = Enum.Material.Sand,
	["("] = Enum.Material.Snow,
	[")"] = Enum.Material.Glass,
	["-"] = Enum.Material.Wood,
	["_"] = Enum.Material.Slate,
	["="] = Enum.Material.Pebble,
	["+"] = Enum.Material.Marble,
	["["] = Enum.Material.Granite,
	["]"] = Enum.Material.DiamondPlate,
	["{"] = Enum.Material.Metal,
	["}"] = Enum.Material.Asphalt,
	["~"] = Enum.Material.Concrete,
	["`"] = Enum.Material.Pavement,
	["?"] = Enum.Material.Neon
}

local function hexToColor(hex)
	local r = tonumber(hex:sub(1, 2), 16) / 255
	local g = tonumber(hex:sub(3, 4), 16) / 255
	local b = tonumber(hex:sub(5, 6), 16) / 255
	return Color3.new(r, g, b)
end

local function findBuildTools()
	local tools = {}
	
	if LocalPlayer.Character then
		for _, item in pairs(LocalPlayer.Character:GetChildren()) do
			if item:IsA("Tool") and item.Name == "Build" then
				local script = item:FindFirstChild("Script")
				local remote = script and script:FindFirstChild("Event")
				if remote then
					table.insert(tools, {bt = item, e = remote})
				end
			end
		end
	end
	
	for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
		if item:IsA("Tool") and item.Name == "Build" then
			local script = item:FindFirstChild("Script")
			local remote = script and script:FindFirstChild("Event")
			if remote then
				table.insert(tools, {bt = item, e = remote})
			end
		end
	end
	
	return tools
end

local visualFolder = Instance.new("Folder")
visualFolder.Name = "BuildPreview"
visualFolder.Parent = workspace

local blocks = {}
for blockData in buildString:gmatch("|([^|]+)") do
	local colorHex = blockData:sub(1, 6)
	local materialSymbol = blockData:sub(7, 7)
	local rest = blockData:sub(8)
	
	local canCollide = true
	if rest:sub(1, 1) == "^" then
		canCollide = false
		rest = rest:sub(2)
	end
	
	local sizeData, posData = rest:match("([^%.]+)%.(.+)")
	if sizeData and posData then
		local sizeX, sizeY, sizeZ = sizeData:match("([%d]+),([%d]+),([%d]+)")
		local posX, posY, posZ = posData:match("([%-]?%d+%.?%d*),([%-]?%d+%.?%d*),([%-]?%d+%.?%d*)")
		
		if sizeX and posX then
			local size = Vector3.new(tonumber(sizeX), tonumber(sizeY), tonumber(sizeZ))
			local position = Vector3.new(tonumber(posX), tonumber(posY), tonumber(posZ))
			
			local cornerOffset = Vector3.new(-size.X/2, -size.Y/2, -size.Z/2)
			local placePosition = position + cornerOffset
			
			local preview = Instance.new("Part")
			preview.Name = "PreviewBlock"
			preview.Size = size
			preview.Anchored = true
			preview.CanCollide = false
			preview.CFrame = CFrame.new(position)
			preview.Material = SymbolToMaterial[materialSymbol] or Enum.Material.SmoothPlastic
			preview.Color = hexToColor(colorHex)
			preview.Transparency = 0.5
			preview.Parent = visualFolder
			
			table.insert(blocks, {
				size = size,
				position = position,
				placePosition = placePosition,
				preview = preview
			})
		end
	end
end

print("Loaded " .. #blocks .. " blocks")

local btools = findBuildTools()
if #btools == 0 then
	warn("No build tools found!")
	return
end

print("Found " .. #btools .. " build tools")

local bti = 0
local ws = 0.05
local bricksFolder = workspace:FindFirstChild("Bricks")
local playerFolder = bricksFolder and bricksFolder:FindFirstChild(LocalPlayer.Name)

-- Make all placed bricks CanCollide = false on client
local canCollideConnection = RunService.Heartbeat:Connect(function()
	if playerFolder then
		for _, brick in pairs(playerFolder:GetChildren()) do
			if brick:IsA("BasePart") and brick.Name == "Brick" then
				brick.CanCollide = false
			end
		end
	end
end)

local function checkBlockExists(blockData)
	if not playerFolder then
		playerFolder = bricksFolder and bricksFolder:FindFirstChild(LocalPlayer.Name)
	end
	
	if playerFolder then
		for _, brick in pairs(playerFolder:GetChildren()) do
			if brick:IsA("BasePart") and brick.Name == "Brick" then
				local distance = (brick.Position - blockData.position).Magnitude
				if distance < 5 then
					return true
				end
			end
		end
	end
	return false
end

local function getPlayerPos()
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		return LocalPlayer.Character.HumanoidRootPart.Position
	end
	return nil
end

local function findBlocksInRange()
	local playerPos = getPlayerPos()
	if not playerPos then return {} end
	
	local blocksInRange = {}
	
	for i, blockData in ipairs(blocks) do
		local distance = (blockData.position - playerPos).Magnitude
		if distance >= 5 and distance <= 20 then
			table.insert(blocksInRange, {data = blockData, distance = distance})
		end
	end
	
	table.sort(blocksInRange, function(a, b)
		return a.distance < b.distance
	end)
	
	return blocksInRange
end

local function findNearestUnbuiltBlock()
	local playerPos = getPlayerPos()
	if not playerPos then return nil end
	
	local nearest = nil
	local nearestDist = math.huge
	
	for i, blockData in ipairs(blocks) do
		local distance = (blockData.position - playerPos).Magnitude
		if distance < nearestDist then
			nearestDist = distance
			nearest = blockData
		end
	end
	
	return nearest
end

local function teleportNear(targetPos)
	if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		return
	end
	
	-- Move 8 studs away with tween
	local hrp = LocalPlayer.Character.HumanoidRootPart
	local currentY = hrp.Position.Y
	
	local direction = (targetPos - hrp.Position).Unit
	local offset = direction * 8
	local newPos = targetPos - offset
	newPos = Vector3.new(newPos.X, currentY, newPos.Z)
	
	pcall(function()
		local tween = TweenService:Create(hrp, TweenInfo.new(0.3, Enum.EasingStyle.Linear), {CFrame = CFrame.new(newPos)})
		tween:Play()
		tween.Completed:Wait()
	end)
end

task.spawn(function()
	print("Starting auto-build...")
	
	while true do
		local blocksInRange = findBlocksInRange()
		
		-- If no blocks in 5-20 stud range, teleport to nearest block
		if #blocksInRange == 0 then
			local nearestBlock = findNearestUnbuiltBlock()
			if not nearestBlock then
				print("No more blocks to build!")
				break
			end
			
			print("No blocks in range, moving to next cluster...")
			teleportNear(nearestBlock.position)
			task.wait(0.5)
			continue
		end
		
		-- SPAM BUILD all blocks in range
		print("Building " .. #blocksInRange .. " blocks in range...")
		for _, blockInfo in ipairs(blocksInRange) do
			local blockData = blockInfo.data
			
			bti = bti + 1
			local bt = btools[(bti % #btools) + 1]
			
			-- Equip tool
			if LocalPlayer.Character and bt.bt.Parent ~= LocalPlayer.Character then
				pcall(function()
					LocalPlayer.Character.Humanoid:EquipTool(bt.bt)
				end)
			end
			
			-- Build mode
			local buildMode = "normal"
			local placePos = blockData.position
			
			if blockData.size ~= Vector3.new(4, 4, 4) then
				buildMode = "detailed"
				placePos = blockData.placePosition
			end
			
			-- Fire remote
			pcall(function()
				bt.e:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, buildMode)
			end)
			
			if blockData.preview then
				pcall(function()
					blockData.preview:Destroy()
				end)
			end
			
			task.wait(ws / #btools)
			
			if bti % 20 == 0 then
				btools = findBuildTools()
			end
		end
		
		-- VERIFY what's actually placed (MAX 2 RETRIES)
		print("Verifying cluster...")
		task.wait(1)
		
		local retryCount = 0
		local maxRetries = 2
		
		while retryCount < maxRetries do
			local missingInRange = {}
			for _, blockInfo in ipairs(blocksInRange) do
				if not checkBlockExists(blockInfo.data) then
					table.insert(missingInRange, blockInfo.data)
				end
			end
			
			if #missingInRange == 0 then
				print("Cluster verified!")
				break
			end
			
			print("Retry " .. (retryCount + 1) .. ": " .. #missingInRange .. " missing blocks")
			retryCount = retryCount + 1
			
			-- Retry missing blocks
			for _, blockData in ipairs(missingInRange) do
				bti = bti + 1
				local bt = btools[(bti % #btools) + 1]
				
				if LocalPlayer.Character and bt.bt.Parent ~= LocalPlayer.Character then
					pcall(function()
						LocalPlayer.Character.Humanoid:EquipTool(bt.bt)
					end)
				end
				
				local buildMode = "normal"
				local placePos = blockData.position
				
				if blockData.size ~= Vector3.new(4, 4, 4) then
					buildMode = "detailed"
					placePos = blockData.placePosition
				end
				
				pcall(function()
					bt.e:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, buildMode)
				end)
				
				task.wait(ws / #btools)
			end
			
			task.wait(1)
		end
		
		if retryCount >= maxRetries then
			print("Max retries reached, moving to next cluster...")
		end
	end
	
	-- Final verification
	print("=== FINAL VERIFICATION ===")
	task.wait(2)
	
	local finalMissing = {}
	for _, blockData in ipairs(blocks) do
		if not checkBlockExists(blockData) then
			table.insert(finalMissing, blockData)
		end
	end
	
	if #finalMissing > 0 then
		print("Final pass: " .. #finalMissing .. " missing blocks")
	end
	
	local finalPlaced = #blocks - #finalMissing
	print("=== BUILD COMPLETE ===")
	print("Placed: " .. finalPlaced .. "/" .. #blocks)
	
	-- Re-enable CanCollide
	canCollideConnection:Disconnect()
	if playerFolder then
		for _, brick in pairs(playerFolder:GetChildren()) do
			if brick:IsA("BasePart") and brick.Name == "Brick" then
				brick.CanCollide = true
			end
		end
	end
	
	visualFolder:Destroy()
end)]]

setclipboard(fullScript)
print("Auto-build script copied to clipboard!")
print("Blocks saved: " .. blockCount)
print("Skipped: " .. skippedCount)
print("Execute your clipboard to start auto-building!")
