-- Debug Script - Raw property changes (skip DevConsole spam)
local player = game.Players.LocalPlayer

local function isDevConsole(obj)
	return obj:IsDescendantOf(game:GetService("CoreGui").DevConsoleMaster)
end

-- Cache paths before removal
local pathCache = {}

game.DescendantAdded:Connect(function(obj)
	if not isDevConsole(obj) then
		pathCache[obj] = obj:GetFullName()
		print(obj:GetFullName(), "| ClassName:", obj.ClassName, "| ADDED")
	end
end)

game.DescendantRemoving:Connect(function(obj)
	if not isDevConsole(obj) then
		local fullPath = pathCache[obj] or obj:GetFullName()
		print(fullPath, "| ClassName:", obj.ClassName, "| REMOVED")
		pathCache[obj] = nil
	end
end)

local function watchObject(obj)
	if isDevConsole(obj) then return end
	
	pathCache[obj] = obj:GetFullName()
	
	-- Watch CameraType changes
	if obj == workspace.CurrentCamera then
		obj:GetPropertyChangedSignal("CameraType"):Connect(function()
			print("workspace.CurrentCamera.CameraType =", obj.CameraType.Name)
		end)
		obj:GetPropertyChangedSignal("CameraSubject"):Connect(function()
			print("workspace.CurrentCamera.CameraSubject =", tostring(obj.CameraSubject))
		end)
	end
	
	-- Watch Enabled on ScreenGui
	if obj:IsA("ScreenGui") then
		obj:GetPropertyChangedSignal("Enabled"):Connect(function()
			print(obj:GetFullName() .. ".Enabled =", obj.Enabled)
		end)
	end
	
	-- Watch Visible on GUI objects
	if obj:IsA("GuiObject") then
		pcall(function()
			obj:GetPropertyChangedSignal("Visible"):Connect(function()
				print(obj:GetFullName() .. ".Visible =", obj.Visible)
			end)
		end)
	end
	
	-- Watch Disabled on scripts
	if obj:IsA("BaseScript") then
		obj:GetPropertyChangedSignal("Disabled"):Connect(function()
			print(obj:GetFullName() .. ".Disabled =", obj.Disabled)
		end)
	end
end

for _, obj in pairs(game:GetDescendants()) do
	watchObject(obj)
end

game.DescendantAdded:Connect(watchObject)

print("[DEBUG STARTED]")
