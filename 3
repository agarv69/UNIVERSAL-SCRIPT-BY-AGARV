-- LocalScript in StarterPlayer > StarterPlayerScripts

local player = game.Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

-- Function to fix everything
local function fixAll()
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    -- Re-enable Backpack/Inventory GUI
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
    
    -- Fix camera
    workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    workspace.CurrentCamera.CameraSubject = humanoid
    
    -- Reset walkspeed if stuck
    if humanoid.WalkSpeed == 0 then
        humanoid.WalkSpeed = 16
    end
    
    print("Fixed camera, inventory, and movement!")
end

-- Press R to manually fix
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.R then
        fixAll()
    end
end)

-- Auto-fix on respawn
player.CharacterAdded:Connect(function(character)
    wait(0.5) -- Brief delay to let character load
    fixAll()
end)

-- Auto-fix after being killed (monitors for the 3-second lock)
spawn(function()
    while wait(0.5) do
        if player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            
            -- Check if inventory is disabled and we're alive
            if humanoid and humanoid.Health > 0 then
                -- Try to detect if backpack is locked
                pcall(function()
                    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
                end)
                
                -- Fix stuck walkspeed
                if humanoid.WalkSpeed == 0 then
                    wait(3.2) -- Wait for the 3-second vampire freeze to end
                    if humanoid.WalkSpeed == 0 then
                        humanoid.WalkSpeed = 16
                    end
                end
            end
        end
    end
end)
