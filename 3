-- ============================================================================
-- UTILITY FUNCTIONS
-- ============================================================================
local function hexToColor(hex)
	local r = tonumber(hex:sub(1, 2), 16) / 255
	local g = tonumber(hex:sub(3, 4), 16) / 255
	local b = tonumber(hex:sub(5, 6), 16) / 255
	return Color3.new(r, g, b)
end

local function equipAllTools()
	if not LocalPlayer.Character then return end
	
	for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
		if tool:IsA("Tool") then
			tool.Parent = LocalPlayer.Character
		end
	end
end

local function findBuildTools()
	local tools = {}
	local locations = {LocalPlayer.Character, LocalPlayer.Backpack}
	
	for _, location in pairs(locations) do
		if location then
			for _, item in pairs(location:GetChildren()) do
				if item:IsA("Tool") and item.Name == "Build" then
					local remote = item:FindFirstChild("Script", true) 
						and item.Script:FindFirstChild("Event")
					if remote then
						table.insert(tools, {tool = item, event = remote})
					end
				end
			end
		end
	end
	
	return tools
end

local function findShapeTool()
	return LocalPlayer.Backpack:FindFirstChild("Shape")
		or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Shape"))
end

local function getShapeEvent()
	local tool = findShapeTool()
	if tool then
		return tool:FindFirstChild("Script") and tool.Script:FindFirstChild("Event")
	end
	return nil
end

local function getPlayerBricksFolder()
	local bricksFolder = workspace:FindFirstChild("Bricks")
	if not bricksFolder then return nil end
	
	return bricksFolder:FindFirstChild(LocalPlayer.Name)
end

-- ============================================================================
-- POSITION LOCKING
-- ============================================================================
local positionLock = nil

local function lockPosition(targetPos)
	if positionLock then
		positionLock:Disconnect()
	end
	
	positionLock = RunService.RenderStepped:Connect(function()
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local hrp = char.HumanoidRootPart
			hrp.CFrame = CFrame.new(targetPos)
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end)
end

local function unlockPosition()
	if positionLock then
		positionLock:Disconnect()
		positionLock = nil
	end
end

-- ============================================================================
-- BLOCK DETECTION
-- ============================================================================
local function findBlockNear(targetPos, searchRadius)
	local playerFolder = getPlayerBricksFolder()
	if not playerFolder then return nil end
	
	local closestBrick = nil
	local closestDist = searchRadius or CONFIG.POSITION_CHECK_TOLERANCE
	
	for _, brick in pairs(playerFolder:GetChildren()) do
		if brick:IsA("BasePart") and brick.Name == "Brick" then
			local dist = (brick.Position - targetPos).Magnitude
			if dist < closestDist then
				closestBrick = brick
				closestDist = dist
			end
		end
	end
	
	return closestBrick
end

-- ============================================================================
-- PARSE BUILD STRING
-- ============================================================================
local function parseBlocks(buildStr)
	local blocks = {}
	
	for blockData in buildStr:gmatch("|([^|]+)") do
		local colorHex = blockData:sub(1, 6)
		local materialSymbol = blockData:sub(7, 7)
		local rest = blockData:sub(8)
		
		local canCollide = true
		if rest:sub(1, 1) == "^" then
			canCollide = false
			rest = rest:sub(2)
		end
		
		local sizeData, posData = rest:match("([^%.]+)%.(.+)")
		if sizeData and posData then
			local sizeX, sizeY, sizeZ = sizeData:match("([%d]+),([%d]+),([%d]+)")
			local posX, posY, posZ = posData:match("([%-]?%d+%.?%d*),([%-]?%d+%.?%d*),([%-]?%d+%.?%d*)")
			
			if sizeX and posX then
				local size = Vector3.new(tonumber(sizeX), tonumber(sizeY), tonumber(sizeZ))
				local centerPos = Vector3.new(tonumber(posX), tonumber(posY), tonumber(posZ))
				
				table.insert(blocks, {
					size = size,
					centerPos = centerPos,
					color = hexToColor(colorHex),
					material = SymbolToMaterial[materialSymbol] or Enum.Material.SmoothPlastic,
					canCollide = canCollide,
					needsResize = (size ~= Vector3.new(4, 4, 4))
				})
			end
		end
	end
	
	return blocks
end

-- ============================================================================
-- VISUALIZATION
-- ============================================================================
local function createPreviews(blocks)
	local folder = Instance.new("Folder")
	folder.Name = "BuildPreview"
	folder.Parent = workspace
	
	for i, blockData in ipairs(blocks) do
		local preview = Instance.new("Part")
		preview.Name = "Preview_" .. i
		preview.Size = blockData.size
		preview.CFrame = CFrame.new(blockData.centerPos)
		preview.Anchored = true
		preview.CanCollide = false
		preview.Material = blockData.material
		preview.Color = blockData.color
		preview.Transparency = 0.6
		preview.Parent = folder
		
		blockData.preview = preview
	end
	
	return folder
end

-- ============================================================================
-- BLOCK RESIZING
-- ============================================================================
local function resizeBlock(brick, targetSize)
	-- Check if already correct size
	if brick.Size.X == targetSize.X and brick.Size.Y == targetSize.Y and brick.Size.Z == targetSize.Z then
		print("Block already at correct size, skipping resize")
		return true
	end
	
	local shapeTool = findShapeTool()
	if not shapeTool then
		warn("Shape tool not found!")
		return false
	end
	
	-- Equip Shape tool
	if shapeTool.Parent == LocalPlayer.Backpack and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
		LocalPlayer.Character.Humanoid:EquipTool(shapeTool)
		task.wait(0.2)
	end
	
	local shapeEvent = getShapeEvent()
	if not shapeEvent then
		warn("Shape tool event not found!")
		return false
	end
	
	print(string.format("Resizing block from %s to %s", tostring(brick.Size), tostring(targetSize)))
	
	-- Lock position under the block during resize
	local resizePos = brick.Position - Vector3.new(0, 20, 0)
	lockPosition(resizePos)
	
	local startTime = tick()
	local maxIterations = 80
	local iterations = 0
	
	while tick() - startTime < CONFIG.RESIZE_TIMEOUT and iterations < maxIterations do
		if not brick or not brick:IsDescendantOf(workspace) then
			warn("Block was destroyed during resize!")
			unlockPosition()
			return false
		end
		
		local currentSize = brick.Size
		
		-- Check if we've reached target size
		if currentSize.X == targetSize.X and currentSize.Y == targetSize.Y and currentSize.Z == targetSize.Z then
			print("✓ Resize complete!")
			unlockPosition()
			return true
		end
		
		iterations = iterations + 1
		local pos = brick.Position
		local size = brick.Size
		
		-- Resize X axis - fire on BOTH Right and Left faces
		if currentSize.X ~= targetSize.X then
			local action = currentSize.X < targetSize.X and "increase" or "decrease"
			
			pcall(function()
				local rightPos = pos + (brick.CFrame.RightVector * size.X/2)
				shapeEvent:FireServer(brick, Enum.NormalId.Right, rightPos, action)
			end)
			task.wait(0.05)
			
			pcall(function()
				local leftPos = pos - (brick.CFrame.RightVector * size.X/2)
				shapeEvent:FireServer(brick, Enum.NormalId.Left, leftPos, action)
			end)
			task.wait(CONFIG.RESIZE_CHECK_INTERVAL)
		end
		
		-- Resize Y axis - fire on BOTH Top and Bottom faces
		if currentSize.Y ~= targetSize.Y then
			local action = currentSize.Y < targetSize.Y and "increase" or "decrease"
			
			pcall(function()
				local topPos = pos + (brick.CFrame.UpVector * size.Y/2)
				shapeEvent:FireServer(brick, Enum.NormalId.Top, topPos, action)
			end)
			task.wait(0.05)
			
			pcall(function()
				local bottomPos = pos - (brick.CFrame.UpVector * size.Y/2)
				shapeEvent:FireServer(brick, Enum.NormalId.Bottom, bottomPos, action)
			end)
			task.wait(CONFIG.RESIZE_CHECK_INTERVAL)
		end
		
		-- Resize Z axis - fire on BOTH Front and Back faces
		if currentSize.Z ~= targetSize.Z then
			local action = currentSize.Z < targetSize.Z and "increase" or "decrease"
			
			pcall(function()
				local frontPos = pos + (brick.CFrame.LookVector * size.Z/2)
				shapeEvent:FireServer(brick, Enum.NormalId.Front, frontPos, action)
			end)
			task.wait(0.05)
			
			pcall(function()
				local backPos = pos - (brick.CFrame.LookVector * size.Z/2)
				shapeEvent:FireServer(brick, Enum.NormalId.Back, backPos, action)
			end)
			task.wait(CONFIG.RESIZE_CHECK_INTERVAL)
		end
		
		task.wait(0.15)
	end
	
	unlockPosition()
	
	-- Final check
	local finalSize = brick.Size
	local success = finalSize.X == targetSize.X and finalSize.Y == targetSize.Y and finalSize.Z == targetSize.Z
	
	if not success then
		warn(string.format("Resize timeout! Current: %s, Target: %s", tostring(finalSize), tostring(targetSize)))
	end
	
	return success
end

-- ============================================================================
-- BLOCK PLACEMENT
-- ============================================================================
local function placeBlock(blockData, buildTools)
	if #buildTools == 0 then
		warn("No build tools available!")
		return false
	end
	
	-- Check if already exists
	local existing = findBlockNear(blockData.centerPos, 1)
	if existing then
		print("Block already exists at position, checking size...")
		blockData.placedBrick = existing
		
		-- If block needs resize and current size doesn't match, resize it
		if blockData.needsResize then
			if existing.Size ~= blockData.size then
				print("Existing block needs resizing...")
				local resizeSuccess = resizeBlock(existing, blockData.size)
				return resizeSuccess
			else
				print("Existing block already correct size, skipping resize")
				return true
			end
		end
		
		return true
	end
	
	-- Teleport above the block position with POSITION LOCK (like blockspam)
	local buildPos = blockData.centerPos + Vector3.new(0, CONFIG.BUILD_HEIGHT_OFFSET, 0)
	lockPosition(buildPos)
	task.wait(0.2)
	
	-- Place the block (always use detailed mode if it needs resizing)
	local placeMode = blockData.needsResize and "detailed" or "normal"
	local placePos = blockData.centerPos
	
	print(string.format("Placing block in '%s' mode at %s", placeMode, tostring(placePos)))
	
	-- Try placement with each tool until success
	local toolIndex = 0
	local startTime = tick()
	local placedBrick = nil
	
	while tick() - startTime < CONFIG.PLACEMENT_TIMEOUT do
		toolIndex = (toolIndex % #buildTools) + 1
		local bt = buildTools[toolIndex]
		
		pcall(function()
			bt.event:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, placeMode)
		end)
		
		task.wait(0.05)
		
		-- Check if block appeared
		local brick = findBlockNear(blockData.centerPos, 3)
		if brick then
			placedBrick = brick
			blockData.placedBrick = brick
			print("Block placed successfully!")
			break
		end
	end
	
	if not placedBrick then
		warn("Block placement timeout!")
		unlockPosition()
		return false
	end
	
	-- Unlock position after placement
	unlockPosition()
	task.wait(0.1)
	
	-- If this block needs resizing, do it now and WAIT for it to complete
	if blockData.needsResize then
		-- Check if size already matches (sometimes detailed mode places at correct size)
		if placedBrick.Size == blockData.size then
			print("Block placed at correct size, skipping resize")
			return true
		else
			print("Block needs resizing after placement...")
			
			-- WAIT for resize to complete before returning
			local resizeSuccess = resizeBlock(placedBrick, blockData.size)
			
			if resizeSuccess then
				print("Block resized successfully!")
			else
				warn("Block resize FAILED!")
			end
			
			return resizeSuccess
		end
	end
	
	return true
end

-- ============================================================================
-- MAIN BUILD PROCESS
-- ============================================================================
local function main()
	print("=== AUTO-BUILD STARTING ===")
	
	-- Parse blocks
	local blocks = parseBlocks(buildString)
	print("Loaded " .. #blocks .. " blocks to build")
	
	if #blocks == 0 then
		warn("No blocks found in build string!")
		return
	end
	
	-- Create previews
	local previewFolder = createPreviews(blocks)
	print("Created preview visualization")
	
	-- Equip tools
	equipAllTools()
	task.wait(0.5)
	
	-- Find build tools
	local buildTools = findBuildTools()
	if #buildTools == 0 then
		warn("No build tools found! Make sure you have Build tools equipped.")
		return
	end
	print("Found " .. #buildTools .. " build tools")
	
	-- Check for Shape tool if any blocks need resizing
	local needsShapeTool = false
	for _, blockData in ipairs(blocks) do
		if blockData.needsResize then
			needsShapeTool = true
			break
		end
	end
	
	if needsShapeTool and not findShapeTool() then
		warn("WARNING: Some blocks need resizing but Shape tool not found!")
	end
	
	-- Tool re-equip loop
	task.spawn(function()
		while true do
			task.wait(CONFIG.TOOL_EQUIP_INTERVAL)
			equipAllTools()
		end
	end)
	
	-- Build blocks
	local successCount = 0
	local failCount = 0
	
	for i, blockData in ipairs(blocks) do
		print(string.format("\n[%d/%d] Processing block...", i, #blocks))
		
		-- Place and resize the block (waits for completion)
		local success = placeBlock(blockData, buildTools)
		
		if success then
			successCount = successCount + 1
			print(string.format("✓ [%d/%d] Block COMPLETE (placed and resized)", i, #blocks))
			
			-- Destroy preview
			if blockData.preview then
				pcall(function() blockData.preview:Destroy() end)
			end
		else
			failCount = failCount + 1
			warn(string.format("✗ [%d/%d] Block FAILED", i, #blocks))
		end
		
		-- Make sure position is unlocked before next block
		unlockPosition()
		task.wait(0.1)
		
		-- Refresh build tools periodically
		if i % 20 == 0 then
			buildTools = findBuildTools()
		end
	end
	
	print(string.format("\n=== BUILD COMPLETE ===\nSuccess: %d | Failed: %d", successCount, failCount))
	
	-- Cleanup
	task.wait(1)
	if previewFolder then
		pcall(function() previewFolder:Destroy() end)
	end
	
	print("\n=== ALL DONE ===")
end

-- Run
main()
