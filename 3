-- Leaderboard Fix Script
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local PlayerList = CoreGui:WaitForChild("PlayerList")
local ScrollingFrame = PlayerList.Children.OffsetFrame.PlayerScrollList.SizeOffsetFrame.ScrollingFrameContainer.ScrollingFrameClippingFrame.ScrollingFrame.OffsetUndoFrame

local TeamList_Chosen = ScrollingFrame:FindFirstChild("TeamList_Chosen")
local TeamList_Neutral = ScrollingFrame:FindFirstChild("TeamList_Neutral")

if not TeamList_Chosen or not TeamList_Neutral then
	warn("TeamList_Chosen or TeamList_Neutral not found!")
	return
end

-- Function to get player's exact time from Workspace
local function getPlayerTime(player)
	local char = workspace:FindFirstChild(player.Name)
	if char then
		local tiempo = char:FindFirstChild("Tiempo")
		if tiempo then
			local text1 = tiempo:FindFirstChild("Text1")
			if text1 and text1:IsA("TextLabel") then
				local timeValue = tonumber(text1.Text)
				return timeValue or 0
			end
		end
	end
	return 0
end

-- Function to update player entry display time
local function updatePlayerDisplay(playerEntry, time)
	local contentFrame = playerEntry:FindFirstChild("PlayerEntryContentFrame")
	if contentFrame then
		local overlayFrame = contentFrame:FindFirstChild("OverlayFrame")
		if overlayFrame then
			local gameStat = overlayFrame:FindFirstChild("GameStat_Time")
			if gameStat then
				local display = gameStat:FindFirstChild("PlayerStatDisplay")
				if display and display:IsA("TextLabel") then
					display.Text = tostring(time)
				end
			end
		end
	end
end

-- Function to get all player entries in a team
local function getPlayerEntries(teamList)
	local entries = {}
	for _, child in pairs(teamList:GetChildren()) do
		if child.Name:match("^PlayerEntry_") then
			table.insert(entries, child)
		end
	end
	return entries
end

-- Function to update leaderboard
local function updateLeaderboard()
	-- Get all players and their times
	local playerData = {}
	for _, player in pairs(Players:GetPlayers()) do
		local time = getPlayerTime(player)
		table.insert(playerData, {
			player = player,
			time = time,
			userId = player.UserId
		})
	end
	
	-- Sort by time (highest first)
	table.sort(playerData, function(a, b)
		return a.time > b.time
	end)
	
	-- Find highest time
	local highestTime = playerData[1] and playerData[1].time or 0
	
	-- Move player entries to correct teams and update layout
	for i, data in ipairs(playerData) do
		local playerEntry = TeamList_Chosen:FindFirstChild("PlayerEntry_" .. data.userId) or 
		                     TeamList_Neutral:FindFirstChild("PlayerEntry_" .. data.userId)
		
		if playerEntry then
			-- Update display time with decimals
			updatePlayerDisplay(playerEntry, data.time)
			
			-- Move to correct team
			if data.time == highestTime and highestTime > 0 then
				-- Move to Chosen with LayoutOrder 1
				if playerEntry.Parent ~= TeamList_Chosen then
					playerEntry.Parent = TeamList_Chosen
				end
				playerEntry.LayoutOrder = 1
			else
				-- Move to Neutral with ranked LayoutOrder
				if playerEntry.Parent ~= TeamList_Neutral then
					playerEntry.Parent = TeamList_Neutral
				end
				playerEntry.LayoutOrder = (i - 1) * 2 + 1 -- Account for dividers
			end
		end
	end
	
	-- Update dividers in Neutral team
	local neutralEntries = getPlayerEntries(TeamList_Neutral)
	table.sort(neutralEntries, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	
	-- Remove old dividers in Neutral
	for _, child in pairs(TeamList_Neutral:GetChildren()) do
		if child.Name:match("^Divider_") then
			child:Destroy()
		end
	end
	
	-- Add dividers between players in Neutral
	for i = 1, #neutralEntries - 1 do
		local divider = Instance.new("Frame")
		divider.Name = "Divider_" .. i
		divider.LayoutOrder = neutralEntries[i].LayoutOrder + 1
		divider.Parent = TeamList_Neutral
	end
end

-- Update every frame
RunService.Heartbeat:Connect(function()
	updateLeaderboard()
end)

-- Initial update
updateLeaderboard()

print("[Leaderboard Fix] Script loaded successfully!")
