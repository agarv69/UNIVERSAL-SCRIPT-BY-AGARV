local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local deleteRange = 500 -- Range to delete

-- Function to modify the Delete tool's script
local function modifyDeleteTool()
	local deleteTool = LocalPlayer.Backpack:FindFirstChild("Delete") or 
	                   (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Delete"))
	
	if not deleteTool then return false end
	
	local deleteScript = deleteTool:FindFirstChild("Script")
	if not deleteScript then return false end
	
	-- Try to modify the script's range check
	local success = pcall(function()
		-- Replace the Magnitude < 24 check with a huge number
		local scriptSource = deleteScript.Source
		if scriptSource then
			scriptSource = scriptSource:gsub("Magnitude < 24", "Magnitude < 99999")
			deleteScript.Source = scriptSource
			print("Modified Delete tool range check!")
		end
	end)
	
	return true
end

-- Auto-equip Delete and modify it
task.spawn(function()
	task.wait(1)
	if LocalPlayer.Backpack:FindFirstChild("Delete") and LocalPlayer.Character then
		LocalPlayer.Backpack.Delete.Parent = LocalPlayer.Character
		task.wait(0.5)
		modifyDeleteTool()
	end
end)

-- Keep trying to modify if not done yet
task.spawn(function()
	while task.wait(1) do
		modifyDeleteTool()
	end
end)

-- Delete aura
RunService.Heartbeat:Connect(function()
	pcall(function()
		if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then 
			return 
		end
		
		if not LocalPlayer.Character:FindFirstChild("Delete") then return end
		
		local deleteScript = LocalPlayer.Character.Delete:FindFirstChild("Script")
		if not deleteScript or not deleteScript:FindFirstChild("Event") then return end
		
		local myPos = LocalPlayer.Character.HumanoidRootPart.Position
		
		-- Delete all blocks within range
		for _, block in pairs(workspace.Bricks:GetDescendants()) do
			if block:IsA("BasePart") and block.Name == "Brick" then
				local distance = (block.Position - myPos).Magnitude
				
				if distance <= deleteRange then
					task.spawn(function()
						pcall(function()
							deleteScript.Event:FireServer(block, block.Position)
						end)
					end)
				end
			end
		end
	end)
end)

