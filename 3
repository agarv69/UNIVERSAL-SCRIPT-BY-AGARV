local function getIdsFromRaw(rawText, listName)
	local ids = {}
	local inList = false
	for line in rawText:gmatch("[^\n]+") do
		if line:find(listName) then
			inList = true
		elseif inList then
			if line:find("}") then break end
			local id = line:match("(%d+)")
			if id then
				ids[tonumber(id)] = true
			end
		end
	end
	return ids
end

local function getStringsFromRaw(rawText, listName)
	local ids = {}
	local inList = false
	for line in rawText:gmatch("[^\n]+") do
		if line:find(listName) then
			inList = true
		elseif inList then
			if line:find("}") then break end
			local id = line:match('"([^"]+)"')
			if id then
				ids[id] = true
			end
		end
	end
	return ids
end

