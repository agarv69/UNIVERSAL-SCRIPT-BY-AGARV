		if isSelf then return end
	
		if isWhitelisted(player) then return end
		if not passesEnlightenCheck(player) then return end
		if not passesTimeFilterCheck(player) then return end
		if ownerUserId and not passesInGameCheck(ownerUserId) then return end
	
		if griefCooldown[userId] and tick() < griefCooldown[userId] then return end
	
		local now = tick()
		griefTracker[userId] = griefTracker[userId] or {}
		table.insert(griefTracker[userId], now)
	
		for i = #griefTracker[userId], 1, -1 do
			if now - griefTracker[userId][i] > GRIEF_TIME then
				table.remove(griefTracker[userId], i)
			end
		end
	
