local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local isDeleting = true
local deleteRange = 500 -- Adjust this for how far you want to delete

-- Auto-equip Delete tool
local function equipDelete()
	if not LocalPlayer.Character then return end
	
	local deleteTool = LocalPlayer.Backpack:FindFirstChild("Delete")
	if deleteTool then
		deleteTool.Parent = LocalPlayer.Character
	end
end

-- Initial equip
task.wait(1)
equipDelete()

-- Re-equip on respawn
LocalPlayer.CharacterAdded:Connect(function(character)
	task.wait(1.5)
	equipDelete()
end)

-- Keep Delete equipped
task.spawn(function()
	while task.wait(0.5) do
		equipDelete()
	end
end)

-- Extended range delete aura (fires all at once with coroutines)
task.spawn(function()
	while isDeleting do
		task.wait() -- Run every frame
		
		pcall(function()
			if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then 
				return
			end
			
			local deleteTool = LocalPlayer.Character:FindFirstChild("Delete")
			if not deleteTool then return end
			
			local deleteScript = deleteTool:FindFirstChild("Script")
			if not deleteScript or not deleteScript:FindFirstChild("Event") then return end
			
			local hrp = LocalPlayer.Character.HumanoidRootPart
			
			-- Get all blocks within range
			for _, block in pairs(workspace.Bricks:GetDescendants()) do
				if block:IsA("BasePart") and block.Name == "Brick" then
					local distance = (block.Position - hrp.Position).Magnitude
					
					if distance < deleteRange then
						-- Fire each delete in a separate coroutine (all at once)
						coroutine.wrap(function()
							pcall(function()
								deleteScript.Event:FireServer(block, block.Position)
							end)
						end)()
					end
				end
			end
		end)
	end
end)

print("Extended Range Delete Aura loaded!")
print("Range: " .. deleteRange .. " studs")
print("Fires all deletes simultaneously using coroutines!")
