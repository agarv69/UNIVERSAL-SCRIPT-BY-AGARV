local CoreGui = game:GetService("CoreGui")
local AgarWareGui = CoreGui:FindFirstChild("AgarWareGui")

if not AgarWareGui then
	warn("Could not find AgarWareGui in CoreGui!")
	return
end

local MainFrame = AgarWareGui:FindFirstChild("MainFrame", true)
local ContentArea = MainFrame:FindFirstChild("ContentArea")

print("========== CONTENTAREA STRUCTURE ==========")
print("ContentArea children:")
for _, child in pairs(ContentArea:GetChildren()) do
	print("  " .. child.Name .. " (" .. child.ClassName .. ")")
	if child:IsA("Frame") then
		print("    Children of " .. child.Name .. ":")
		for _, subchild in pairs(child:GetChildren()) do
			print("      " .. subchild.Name .. " (" .. subchild.ClassName .. ")")
			if subchild:IsA("Frame") then
				print("        Children of " .. subchild.Name .. ":")
				for _, subsubchild in pairs(subchild:GetChildren()) do
					print("          " .. subsubchild.Name .. " (" .. subsubchild.ClassName .. ")")
				end
			end
		end
	end
end
