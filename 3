local function C_3()
local script = G2L["3"];
	local frame = script.Parent.MainFrame
	
	-- Configuration
	local BASE_WIDTH = 500   -- Target size for laptops/iPads
	local BASE_HEIGHT = 350
	local MIN_WIDTH = 350    -- Smaller minimum for phones
	local MIN_HEIGHT = 250
	local MAX_WIDTH = 550    -- Max for big PC monitors
	local MAX_HEIGHT = 400
	
	local function rescaler()
		local viewportSize = workspace.CurrentCamera.ViewportSize
		local screenX = viewportSize.X
		local screenY = viewportSize.Y
	
		-- Detect device type based on screen size
		local isMobile = screenX < 600  -- Phones are usually under 600px wide
	
		local newWidth, newHeight
	
		if isMobile then
			-- For phones: smaller and more controlled
			newWidth = math.clamp(screenX * 0.75, MIN_WIDTH, 380)  -- Max 380 on phones
			newHeight = math.clamp(screenY * 0.5, MIN_HEIGHT, 280)  -- Max 280 on phones
		else
			-- For tablets/laptops/PCs: use fixed size with slight scaling
			newWidth = math.clamp(screenX * 0.35, BASE_WIDTH - 50, MAX_WIDTH)
			newHeight = math.clamp(screenY * 0.45, BASE_HEIGHT - 50, MAX_HEIGHT)
		end
	
		frame.Size = UDim2.new(0, newWidth, 0, newHeight)
		frame.Position = UDim2.new(0.5, -newWidth/2, 0.5, -newHeight/2)
	end
	
	rescaler()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescaler)
end;
