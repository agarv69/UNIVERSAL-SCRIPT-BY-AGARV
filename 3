local function C_2()
local script = G2L["2"];
	-- Automatic GUI Scaler using UIScale
	local screenGui = script.Parent
	local function storeOriginalProperties(frame)
		for _, descendant in pairs(frame:GetDescendants()) do
			if descendant:IsA("UIStroke") then
				descendant:SetAttribute("OriginalThickness", descendant.Thickness)
			end
			if descendant:IsA("GuiObject") then
				descendant:SetAttribute("OriginalBorderSize", descendant.BorderSizePixel)
			end
		end
	end
	local function rescaler()
		local viewportSize = workspace.CurrentCamera.ViewportSize
		local screenX = viewportSize.X
		local scalePercentage
		if screenX < 600 then
			-- Phone
			scalePercentage = 1.00
		elseif screenX < 1024 then
			-- iPad
			scalePercentage = 0.6
		elseif screenX < 1600 then
			-- Laptop
			scalePercentage = 0.40
		else
			-- PC
			scalePercentage = 0.37
		end
		local targetWidth = screenX * scalePercentage
		local scaleFactor = targetWidth / 1000
		for _, frame in pairs(screenGui:GetChildren()) do
			if frame:IsA("Frame") or frame:IsA("CanvasGroup") then
				local uiScale = frame:FindFirstChildOfClass("UIScale")
				if not uiScale then
					uiScale = Instance.new("UIScale")
					uiScale.Parent = frame
				end
				uiScale.Scale = scaleFactor
				if frame.Name == "Frame" and frame:FindFirstChild("ItsThisOne") then
					frame.AnchorPoint = Vector2.new(0.5, 0.5)
					frame.Position = UDim2.new(0.5, 0, 0.5, 0)
				end
				for _, descendant in pairs(frame:GetDescendants()) do
					if descendant:IsA("UIStroke") then
						local originalThickness = descendant:GetAttribute("OriginalThickness")
						if originalThickness then
							descendant.Thickness = originalThickness / scaleFactor
						end
					end
					if descendant:IsA("GuiObject") then
						local originalBorderSize = descendant:GetAttribute("OriginalBorderSize")
						if originalBorderSize and originalBorderSize > 0 then
							descendant.BorderSizePixel = math.max(1, math.round(originalBorderSize / scaleFactor))
						end
					end
				end
			end
		end
	end
	for _, frame in pairs(screenGui:GetChildren()) do
		if frame:IsA("Frame") or frame:IsA("CanvasGroup") then
			storeOriginalProperties(frame)
		end
	end
	rescaler()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescaler)
end;
