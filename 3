		end)

		button.MouseLeave:Connect(function()
			outlineStroke.Color = originalColor
			outlineStroke.Thickness = originalThickness
			outlineStroke.Transparency = originalTransparency
			outlineStroke.ZIndex = 1
			if _G.HideTooltip then
