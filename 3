local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Connections = {}
local isResetting = false

local function enableGodmode()
	-- Clear old connections
	for _, conn in pairs(Connections) do
		if conn then conn:Disconnect() end
	end
	Connections = {}

	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	-- Set max health
	humanoid.MaxHealth = math.huge
	humanoid.Health = math.huge

	-- Keep health at max every frame
	table.insert(Connections, RunService.RenderStepped:Connect(function()
		if isResetting then return end -- Don't interfere during reset
		if humanoid and humanoid.Parent then
			humanoid.MaxHealth = math.huge
			humanoid.Health = math.huge
		end
	end))

	-- Detect health changes
	table.insert(Connections, humanoid:GetPropertyChangedSignal("Health"):Connect(function()
		if isResetting then return end
		if humanoid and humanoid.Parent then
			if humanoid.Health < math.huge then
				humanoid.MaxHealth = math.huge
				humanoid.Health = math.huge
			end
		end
	end))

	-- Prevent death
	table.insert(Connections, humanoid.Died:Connect(function()
		if isResetting then return end
		task.wait()
		humanoid.Health = math.huge
	end))
end

-- Handle character respawns
LocalPlayer.CharacterAdded:Connect(function(character)
	isResetting = false -- Reset flag cleared
	character:WaitForChild("Humanoid")
	task.wait(0.1)
	enableGodmode()
end)

-- Detect when player tries to reset manually
local function detectReset()
	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	-- Monitor for manual reset (health set to 0)
	humanoid:GetPropertyChangedSignal("Health"):Connect(function()
		if humanoid.Health == 0 and humanoid.MaxHealth ~= math.huge then
			-- Player is trying to reset
			isResetting = true
			
			-- Temporarily disable godmode
			for _, conn in pairs(Connections) do
				if conn then conn:Disconnect() end
			end
			Connections = {}
			
			-- Let them reset
			humanoid.MaxHealth = 100
			humanoid.Health = 0
		end
	end)
end

-- Start godmode on first character
if LocalPlayer.Character then
	enableGodmode()
	detectReset()
else
	LocalPlayer.CharacterAdded:Wait()
	task.wait(0.1)
	enableGodmode()
	detectReset()
end

print("God Mode Auto-Exec: ENABLED")
