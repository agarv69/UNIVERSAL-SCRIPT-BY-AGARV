		padding.PaddingRight = UDim.new(0, 6)
		padding.Parent = tooltip
	
		local label = Instance.new("TextLabel")
		label.Name = "text"
		label.BackgroundTransparency = 1
		label.Text = ""
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextSize = 14
		label.Font = Enum.Font.Ubuntu
		label.TextWrapped = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextYAlignment = Enum.TextYAlignment.Top
		label.Size = UDim2.new(0, 200, 0, 0)
		label.AutomaticSize = Enum.AutomaticSize.Y
		label.ZIndex = 101
		label.Parent = tooltip
	end
	
	local function generateRandomText()
		local consonants = {"b","c","d","f","g","h","j","k","l","m","n","p","q","r","s","t","v","w","x","y","z"}
		local vowels = {"a","e","i","o","u"}
		local text = ""
		local wordCount = math.random(3, 8)
	
		for i = 1, wordCount do
			local wordLength = math.random(3, 10)
			local word = ""
	
			for j = 1, wordLength do
				if j % 2 == 1 then
					word = word .. consonants[math.random(1, #consonants)]
				else
					word = word .. vowels[math.random(1, #vowels)]
				end
			end
	
			if i == 1 then
				word = word:sub(1,1):upper() .. word:sub(2)
			end
	
			text = text .. word
			if i < wordCount then
				text = text .. " "
			end
		end
	
		return text
	end
	
	local function updatePosition()
		local mousePos = UserInputService:GetMouseLocation()
		local guiInset = game:GetService("GuiService"):GetGuiInset()
		tooltip.Position = UDim2.new(0, mousePos.X - guiInset.X + 24, 0, mousePos.Y - guiInset.Y + 24)
	end
	
	UserInputService.TouchMoved:Connect(updatePosition)
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			updatePosition()
		end
	end)
	
	RunService.RenderStepped:Connect(updatePosition)
	
	task.spawn(function()
		while true do
			local label = tooltip:FindFirstChild("text")
			if label then
				label.Text = generateRandomText()
			end
			task.wait(5)
		end
	end)
	
	function _G.ShowTooltip(text)
		local label = tooltip:FindFirstChild("text")
		if label then
			label.Text = text
		end
		tooltip.Visible = true
	end
	
	function _G.HideTooltip()
		tooltip.Visible = false
	end
end;
