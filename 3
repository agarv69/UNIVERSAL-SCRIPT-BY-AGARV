local currentWebhookIndex = 1

local function getNextWebhook()
	local webhook = WEBHOOKS[currentWebhookIndex]
	currentWebhookIndex = currentWebhookIndex + 1
	if currentWebhookIndex > #WEBHOOKS then
		currentWebhookIndex = 1
	end
	return webhook
end

