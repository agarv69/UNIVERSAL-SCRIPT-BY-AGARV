		if not brick:FindFirstChild("Light") then
			local c = brick.ChildAdded:Connect(function(child)
				if child.Name ~= "Light" then return end
				if not isToxifyOn() and not isExploitsOn() then return end
				local paintedAt = tick()
				local brickPos = brick.Position
				task.delay(MAX_DELAY, function()
					if isToxifyOn() then
						local player = getBestCandidate(recentPaintSound, paintedAt)
						if player then
							local hrp = getHRP(player)
							local dist = hrp and (hrp.Position - brickPos).Magnitude or 0
							-- Only fire ToxifyEvent if player is within normal range
							if dist <= AURA_MAG_THRESHOLD then
								local isSelf = player.Name == ownerName
								local ownerPlayer = Players:FindFirstChild(ownerName)
								shared.ToxifyEvent:Fire(
									player.UserId,
									ownerPlayer and ownerPlayer.UserId or nil,
									isSelf,
									ownerName,
									brickPos
								)
							end
						end
					end
					checkAuraExploit(recentPaintSound, brickPos, "toxify", paintedAt, ownerName)
				end)
			end)
			table.insert(connections, c)
		end
	
		-- UNANCHOR: Drag added
		if not brick:FindFirstChild("Drag") then
			local c = brick.ChildAdded:Connect(function(child)
				if child.Name ~= "Drag" then return end
				if not isAnchoredOn() and not isExploitsOn() then return end
				local unanchoredAt = tick()
				local brickPos = brick.Position
				task.delay(MAX_DELAY, function()
					if isAnchoredOn() then
						local player = getBestCandidate(recentPaintSound, unanchoredAt)
						if player then
							local hrp = getHRP(player)
							local dist = hrp and (hrp.Position - brickPos).Magnitude or 0
							-- Only fire UnanchorEvent if player is within normal range
							if dist <= AURA_MAG_THRESHOLD then
								local isSelf = player.Name == ownerName
								local ownerPlayer = Players:FindFirstChild(ownerName)
								shared.UnanchorEvent:Fire(
									player.UserId,
									ownerPlayer and ownerPlayer.UserId or nil,
									isSelf,
									ownerName,
									brickPos
								)
							end
						end
					end
					checkAuraExploit(recentPaintSound, brickPos, "unanchor", unanchoredAt, ownerName)
				end)
			end)
			table.insert(connections, c)
		end
	end
	
	local function watchFolder(folder)
		local ownerName = folder.Name
	
		-- DELETE
		local c1 = folder.ChildRemoved:Connect(function(child)
			if child.Name ~= "Brick" then return end
			if not isDeleteOn() and not isExploitsOn() then return end
			local removedAt = tick()
			local brickPos = child.Position
			local debugId = child:GetDebugId()
			task.delay(MAX_DELAY, function()
				if isDeleteOn() then
					local player = getBestCandidate(recentDeleteSound, removedAt)
					if player then
						local hrp = getHRP(player)
						local dist = hrp and (hrp.Position - brickPos).Magnitude or 0
						-- Only fire DeleteEvent if player is within normal range
						-- If they are far away it is likely an aura exploit, not a normal delete
						if dist <= AURA_MAG_THRESHOLD then
							local isSelf = player.Name == ownerName
							local ownerPlayer = Players:FindFirstChild(ownerName)
							local age = "Unknown"
							if brickBirth[debugId] then
								age = string.format("%.0f", removedAt - brickBirth[debugId])
								brickBirth[debugId] = nil
							end
							shared.DeleteEvent:Fire(
								player.UserId,
								ownerPlayer and ownerPlayer.UserId or nil,
								isSelf,
								ownerName,
								age,
								brickPos
							)
						end
					end
				end
				checkAuraExploit(recentDeleteSound, brickPos, "delete", removedAt, ownerName)
			end)
		end)
		table.insert(connections, c1)
	
		-- BRICK ADDED
		local c2 = folder.ChildAdded:Connect(function(child)
			if child.Name ~= "Brick" then return end
			brickBirth[child:GetDebugId()] = tick()
	
			if isSpamOn() then
				local ownerPlayer = Players:FindFirstChild(ownerName)
				if ownerPlayer then
					shared.BuildEvent:Fire(ownerPlayer.UserId)
				end
			end
	
			watchBrick(child, ownerName)
		end)
		table.insert(connections, c2)
	
		-- Watch existing bricks
		for _, child in ipairs(folder:GetChildren()) do
			if child.Name == "Brick" then
				brickBirth[child:GetDebugId()] = brickBirth[child:GetDebugId()] or tick()
				watchBrick(child, ownerName)
			end
		end
	end
	
	--------------------------------------------------
	-- START / STOP
	--------------------------------------------------
	
	local function startWatching()
		if isRunning then return end
		isRunning = true
		print("[GriefDetectorConsole] Started")
	
		local bricksFolder = workspace:WaitForChild("Bricks")
	
		for _, p in ipairs(Players:GetPlayers()) do
			watchPlayer(p)
		end
		local c1 = Players.PlayerAdded:Connect(watchPlayer)
		table.insert(connections, c1)
	
		for _, folder in ipairs(bricksFolder:GetChildren()) do
			watchFolder(folder)
		end
		local c2 = bricksFolder.ChildAdded:Connect(watchFolder)
		table.insert(connections, c2)
	end
	
	local function stopWatching()
		if not isRunning then return end
		isRunning = false
		print("[GriefDetectorConsole] Stopped")
	
		for _, c in ipairs(connections) do
			pcall(function() c:Disconnect() end)
		end
		connections       = {}
		recentDeleteSound = {}
		recentPaintSound  = {}
		auraCounters      = {}
		auraAlerted       = {}
	end
	
	--------------------------------------------------
	-- WATCH ATTRIBUTE CHANGES
	--------------------------------------------------
	
	for _, attr in ipairs(DETECTION_ATTRS) do
		ScreenGui:GetAttributeChangedSignal(attr):Connect(function()
			if anyDetectionOn() then
				startWatching()
			else
				stopWatching()
			end
		end)
	end
	
	if anyDetectionOn() then
		startWatching()
	end
end;
