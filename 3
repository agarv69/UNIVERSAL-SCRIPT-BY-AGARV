		if #griefTracker[userId] >= GRIEF_COUNT then
			print("[GRIEF DETECTED]", player.Name)
			shared.DeleteGriefEvent:Fire(player)
			shared.GriefEvent:Fire(player, "delete")
			griefTracker[userId] = {}
			griefCooldown[userId] = tick() + getCooldown()
		end
	end)
