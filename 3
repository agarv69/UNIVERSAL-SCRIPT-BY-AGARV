local ServerList = script.Parent
local MainFrame = script.Parent.Parent.Parent
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

-- Get request function
local request = request or http_request or syn.request or http.request or fluxus.request

-- File support check
local supportsFiles = false
pcall(function()
	writefile("test_support.txt", "test")
	if readfile("test_support.txt") == "test" then
		supportsFiles = true
		delfile("test_support.txt")
	end
end)

-- Get previous server
local prevServer = nil
if supportsFiles then
	pcall(function()
		prevServer = readfile("previousserverss.txt")
	end)
end

local currentServer = game.JobId
local isUpdating = false

-- Store the template permanently
local ServerTemplate = ServerList:FindFirstChild("ServerList")

if ServerTemplate then
	ServerTemplate.Visible = false
	ServerTemplate.LayoutOrder = 999999
else
	warn("ServerTemplate not found!")
end

local function createServerRow(serverData, layoutOrder)
	if not ServerTemplate then 
		warn("Template is missing!")
		return 
	end
	
	local success, newRow = pcall(function()
		return ServerTemplate:Clone()
	end)
	
	if not success or not newRow then
		warn("Failed to clone template")
		return
	end
	
	newRow.Name = "ServerList_" .. serverData.id
	newRow.Visible = true
	newRow.LayoutOrder = layoutOrder
	
	local serverSize = newRow:FindFirstChild("ServerSize")
	local jobID = newRow:FindFirstChild("JobID")
	local copyButton = newRow:FindFirstChild("CopyID")
	local joinButton = newRow:FindFirstChild("Join")
	
	local playing = serverData.playing
	local maxPlayers = serverData.maxPlayers
	local isFull = playing >= maxPlayers
	local isPrevious = supportsFiles and tostring(serverData.id) == tostring(prevServer)
	local isCurrent = serverData.id == currentServer
	
	-- Set JobID text
	if jobID then
		jobID.Text = tostring(serverData.id)
	end
	
	-- Set ServerSize text and color
	if serverSize then
		local sizeText = "Server Size: " .. tostring(playing) .. "/" .. tostring(maxPlayers)
		
		if isCurrent then
			sizeText = sizeText .. " (CURRENT)"
			serverSize.TextColor3 = Color3.fromRGB(0, 4, 255)
			newRow.BackgroundColor3 = Color3.fromRGB(0, 1, 29)
		elseif isPrevious then
			sizeText = sizeText .. " (PREVIOUS)"
			serverSize.TextColor3 = Color3.fromRGB(255, 171, 37)
			newRow.BackgroundColor3 = Color3.fromRGB(24, 16, 4)
		elseif isFull then
			sizeText = sizeText .. " (FULL)"
			serverSize.TextColor3 = Color3.fromRGB(255, 0, 0)
			newRow.BackgroundColor3 = Color3.fromRGB(18, 0, 0)
		else
			newRow.BackgroundColor3 = Color3.fromRGB(9, 9, 9)
			serverSize.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
		
		serverSize.Text = sizeText
	end
	
	-- CopyID button
	if copyButton then
		copyButton.MouseButton1Click:Connect(function()
			pcall(function()
				setclipboard(tostring(serverData.id))
			end)
		end)
	end
	
	-- Join button
	if joinButton then
		joinButton.MouseButton1Click:Connect(function()
			if supportsFiles then
				pcall(function()
					writefile("previousserverss.txt", tostring(currentServer))
				end)
			end
			pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, serverData.id, Players.LocalPlayer)
			end)
		end)
	end
	
	newRow.Parent = ServerList
	return true
end

local function updateCanvasSize()
	task.wait(0.15)
	local contentSize = ServerList.UIListLayout.AbsoluteContentSize
	ServerList.CanvasSize = UDim2.new(0, 0, 0, contentSize.Y + 10)
end

local function updateServerList()
	if isUpdating then 
		return 
	end
	
	if not ServerTemplate then
		warn("Cannot update - template missing")
		return
	end
	
	isUpdating = true
	
	-- Fetch servers FIRST
	local success, response = pcall(function()
		local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100"
		
		if request then
			local resp = request({Url = url, Method = "GET"})
			return HttpService:JSONDecode(resp.Body)
		else
			return HttpService:JSONDecode(game:HttpGet(url))
		end
	end)
	
	if not success then
		warn("HTTP request failed")
		isUpdating = false
		return
	end
	
	if not response or not response.data or #response.data == 0 then
		warn("No server data received")
		isUpdating = false
		return
	end
	
	-- Destroy old server frames (NOT the template)
	for _, child in pairs(ServerList:GetChildren()) do
		if child:IsA("Frame") and child.Name ~= "ServerList" then
			pcall(function()
				child:Destroy()
			end)
		end
	end
	
	task.wait(0.1)
	
	-- Sort by player count (highest first)
	table.sort(response.data, function(a, b)
		return a.playing > b.playing
	end)
	
	-- Create server rows
	local created = 0
	for i, serverData in ipairs(response.data) do
		if createServerRow(serverData, i) then
			created = created + 1
		end
		
		-- Yield every 3 servers for smoother loading
		if i % 3 == 0 then
			task.wait(0.03)
		end
	end
	
	print("Created " .. created .. " server frames out of " .. #response.data)
	
	-- Update canvas size
	task.wait(0.2)
	updateCanvasSize()
	
	isUpdating = false
end

-- Auto-update canvas size
ServerList.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	updateCanvasSize()
end)

-- Wait for refresh event with multiple retries
task.spawn(function()
	for i = 1, 5 do
		task.wait(1)
		local RefreshEvent = MainFrame:FindFirstChild("ServerHopperRefresh")
		
		if RefreshEvent then
			print("Connected to RefreshEvent")
			RefreshEvent.Event:Connect(function()
				if not isUpdating then
					updateServerList()
				end
			end)
			break
		else
			warn("RefreshEvent not found, retry " .. i .. "/5")
		end
	end
end)

-- Initial update with longer delay
task.wait(2)
if ServerTemplate then
	updateServerList()
else
	warn("Cannot run initial update - template is missing")
end
