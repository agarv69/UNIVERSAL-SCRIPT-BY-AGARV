local function C_15()
local script = G2L["15"];
	-- Automatic GUI Scaler + MainFrame recenter
	local screenGui = script.Parent
	local function convertToScale(frame)
		local baseWidth = frame.AbsoluteSize.X
		local baseHeight = frame.AbsoluteSize.Y
		for _, child in pairs(frame:GetChildren()) do
			if child:IsA("GuiObject") then
				if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
					child:SetAttribute("OriginalTextSize", child.TextSize)
				end
	
				local hasLayout = child:FindFirstChildOfClass("UIListLayout") or child:FindFirstChildOfClass("UIGridLayout")
	
				if hasLayout then
					child:SetAttribute("OriginalWidth", child.AbsoluteSize.X)
					child:SetAttribute("OriginalHeight", child.AbsoluteSize.Y)
				end
	
				local pixelWidth = child.AbsoluteSize.X
				local pixelHeight = child.AbsoluteSize.Y
				child.Size = UDim2.new(pixelWidth / baseWidth, 0, pixelHeight / baseHeight, 0)
				local pixelX = child.AbsolutePosition.X - frame.AbsolutePosition.X
				local pixelY = child.AbsolutePosition.Y - frame.AbsolutePosition.Y
				child.Position = UDim2.new(pixelX / baseWidth, 0, pixelY / baseHeight, 0)
	
				convertToScale(child)
			end
			if child:IsA("UIStroke") then
				child:SetAttribute("OriginalThickness", child.Thickness)
			end
			if child:IsA("UIListLayout") then
				child:SetAttribute("OriginalPadding", child.Padding.Offset)
			end
		end
		for _, descendant in pairs(frame:GetDescendants()) do
			if descendant:IsA("UIStroke") then
				descendant:SetAttribute("OriginalThickness", descendant.Thickness)
			end
			if descendant:IsA("UIListLayout") then
				descendant:SetAttribute("OriginalPadding", descendant.Padding.Offset)
			end
			if descendant:IsA("GuiObject") and descendant.Parent and (descendant.Parent:FindFirstChildOfClass("UIListLayout") or descendant.Parent:FindFirstChildOfClass("UIGridLayout")) then
				descendant:SetAttribute("OriginalWidth", descendant.AbsoluteSize.X)
				descendant:SetAttribute("OriginalHeight", descendant.AbsoluteSize.Y)
			end
		end
		frame:SetAttribute("OriginalWidth", frame.AbsoluteSize.X)
		frame:SetAttribute("AspectRatio", frame.AbsoluteSize.X / frame.AbsoluteSize.Y)
	end
	local function rescaler()
		local viewportSize = workspace.CurrentCamera.ViewportSize
		local screenX = viewportSize.X
		local scalePercentage
		if screenX < 600 then
			-- Phone
			scalePercentage = 1.00
		elseif screenX < 1024 then
			-- iPad
			scalePercentage = 0.6
		elseif screenX < 1600 then
			-- Laptop
			scalePercentage = 0.40
		else
			-- PC
			scalePercentage = 0.37
		end
		local targetWidth = screenX * scalePercentage
		local globalScaleFactor = targetWidth / 1000
		for _, frame in pairs(screenGui:GetChildren()) do
			if frame:IsA("Frame") or frame:IsA("CanvasGroup") then
				local aspectRatio = frame:GetAttribute("AspectRatio")
				local originalWidth = frame:GetAttribute("OriginalWidth")
				if aspectRatio and originalWidth then
					local newWidth = originalWidth * globalScaleFactor
					local newHeight = newWidth / aspectRatio
					frame.Size = UDim2.new(0, newWidth, 0, newHeight)
					if frame.Name == "MainFrame" then
						frame.AnchorPoint = Vector2.new(0.5, 0.5)
						frame.Position = UDim2.new(0.5, 0, 0.5, 0)
					end
					local scaleFactor = newWidth / originalWidth
					for _, descendant in pairs(frame:GetDescendants()) do
						if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
							local originalSize = descendant:GetAttribute("OriginalTextSize")
							if originalSize then
								descendant.TextSize = math.floor(originalSize * scaleFactor)
							end
						end
	
						if descendant:IsA("GuiObject") then
							local origWidth = descendant:GetAttribute("OriginalWidth")
							local origHeight = descendant:GetAttribute("OriginalHeight")
							if origWidth and origHeight then
								descendant.Size = UDim2.new(0, origWidth * scaleFactor, 0, origHeight * scaleFactor)
							end
						end
	
						if descendant:IsA("UIStroke") then
							local originalThickness = descendant:GetAttribute("OriginalThickness")
							if originalThickness then
								local minThickness = 1
								descendant.Thickness = math.max(minThickness, originalThickness * scaleFactor)
							end
						end
						if descendant:IsA("UIListLayout") then
							local originalPadding = descendant:GetAttribute("OriginalPadding")
							if originalPadding then
								descendant.Padding = UDim.new(0, originalPadding * scaleFactor)
							end
						end
					end
				end
			end
		end
	end
	for _, frame in pairs(screenGui:GetChildren()) do
		if frame:IsA("Frame") or frame:IsA("CanvasGroup") then
			convertToScale(frame)
		end
	end
	rescaler()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescaler)
end;
