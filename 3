local function C_4()
local script = G2L["4"];
	local frame = script.Parent.MainFrame
	
	-- Configuration
	local BASE_WIDTH = 500
	local BASE_HEIGHT = 350
	local MAX_WIDTH = 550
	local MAX_HEIGHT = 400
	
	-- Get aspect ratio from your Studio size
	local ASPECT_RATIO = frame.AbsoluteSize.X / frame.AbsoluteSize.Y  -- Calculates ratio automatically
	
	local function rescaler()
		local viewportSize = workspace.CurrentCamera.ViewportSize
		local screenX = viewportSize.X
		local screenY = viewportSize.Y
	
		local isMobile = screenX < 600
	
		local newWidth
	
		if isMobile then
			newWidth = math.clamp(screenX * 0.65, 280, 340)
		else
			newWidth = math.clamp(screenX * 0.35, 450, MAX_WIDTH)
		end
	
		-- Calculate height based on aspect ratio to keep proportions
		local newHeight = newWidth / ASPECT_RATIO
	
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Size = UDim2.new(0, newWidth, 0, newHeight)
		frame.Position = UDim2.new(0.5, 0, 0.52, 0)
	
		-- Scale all text in the GUI
		for _, descendant in pairs(frame:GetDescendants()) do
			if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
				local baseSize = descendant:GetAttribute("BaseTextSize") or 14
				local scale = isMobile and 0.9 or 1
				descendant.TextSize = baseSize * scale
			end
		end
	end
	
	rescaler()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescaler)
end;
