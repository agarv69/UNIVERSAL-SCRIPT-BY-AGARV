-- Enlighten Team Script
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local Workspace = game:GetService("Workspace")

-- Create Enlighten team if it doesn't exist
local EnlightenTeam = Teams:FindFirstChild("Enlighten")
if not EnlightenTeam then
	EnlightenTeam = Instance.new("Team")
	EnlightenTeam.Name = "Enlighten"
	EnlightenTeam.TeamColor = BrickColor.new("Cyan")
	EnlightenTeam.AutoAssignable = false
	EnlightenTeam.Parent = Teams
	print("[Enlighten Team] Created Enlighten team")
end

local ChosenTeam = Teams:FindFirstChild("Chosen")

local function hasArkenstone(player)
	-- Check backpack
	local backpack = player:FindFirstChild("Backpack")
	if backpack and backpack:FindFirstChild("The Arkenstone") then
		return true
	end
	
	-- Check character in workspace
	local character = Workspace:FindFirstChild(player.Name)
	if character and character:FindFirstChild("The Arkenstone") then
		return true
	end
	
	return false
end

local function updatePlayerTeams()
	for _, player in pairs(Players:GetPlayers()) do
		-- Skip players on Chosen team
		if ChosenTeam and player.Team == ChosenTeam then
			continue
		end
		
		if hasArkenstone(player) then
			-- Move to Enlighten team
			if player.Team ~= EnlightenTeam then
				player.Team = EnlightenTeam
			end
		else
			-- Move back to Neutral (or whatever default team exists)
			if player.Team == EnlightenTeam then
				local NeutralTeam = Teams:FindFirstChild("Neutral")
				if NeutralTeam then
					player.Team = NeutralTeam
				end
			end
		end
	end
end

-- Update every second
task.spawn(function()
	while true do
		updatePlayerTeams()
		task.wait(1)
	end
end)

updatePlayerTeams()
print("[Enlighten Team] Script loaded - moving Arkenstone holders to Enlighten team")
