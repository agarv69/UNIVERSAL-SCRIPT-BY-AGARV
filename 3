-- BLOCK SAVE & AUTO-BUILD SCRIPT WITH RESIZING
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local MaterialSymbols = {
	[Enum.Material.SmoothPlastic] = "!",
	[Enum.Material.Plastic] = "@",
	[Enum.Material.CeramicTiles] = "#",
	[Enum.Material.Brick] = "$",
	[Enum.Material.WoodPlanks] = "%",
	[Enum.Material.Ice] = "^",
	[Enum.Material.Grass] = "&",
	[Enum.Material.Sand] = "*",
	[Enum.Material.Snow] = "(",
	[Enum.Material.Glass] = ")",
	[Enum.Material.Wood] = "-",
	[Enum.Material.Slate] = "_",
	[Enum.Material.Pebble] = "=",
	[Enum.Material.Marble] = "+",
	[Enum.Material.Granite] = "[",
	[Enum.Material.DiamondPlate] = "]",
	[Enum.Material.Metal] = "{",
	[Enum.Material.Asphalt] = "}",
	[Enum.Material.Concrete] = "~",
	[Enum.Material.Pavement] = "`",
	[Enum.Material.Neon] = "?"
}

local function colorToHex(color3)
	local r = math.floor(color3.R * 255)
	local g = math.floor(color3.G * 255)
	local b = math.floor(color3.B * 255)
	return string.format("%02X%02X%02X", r, g, b)
end

local function hasDecimal(num)
	return num % 1 ~= 0
end

local bricksFolder = workspace:FindFirstChild("Bricks")
if not bricksFolder then
	warn("Bricks folder not found!")
	return
end

local buildString = ""
local blockCount = 0
local skippedCount = 0

for _, descendant in pairs(bricksFolder:GetDescendants()) do
	if descendant:IsA("BasePart") and descendant.Name == "Brick" then
		if not descendant.Anchored then
			skippedCount = skippedCount + 1
			continue
		end
		
		local size = descendant.Size
		if hasDecimal(size.X) or hasDecimal(size.Y) or hasDecimal(size.Z) then
			skippedCount = skippedCount + 1
			continue
		end
		
		local materialSymbol = MaterialSymbols[descendant.Material] or "!"
		local colorHex = colorToHex(descendant.Color)
		local cf = descendant.CFrame
		local canCollideMarker = descendant.CanCollide and "" or "^"
		
		buildString = buildString .. string.format(
			"|%s%s%s%.0f,%.0f,%.0f.%.1f,%.1f,%.1f|",
			colorHex,
			materialSymbol,
			canCollideMarker,
			size.X, size.Y, size.Z,
			cf.X, cf.Y, cf.Z
		)
		
		blockCount = blockCount + 1
	end
end

if buildString == "" or not buildString then
	warn("No blocks found to save!")
	print("Blocks scanned: " .. blockCount)
	print("Blocks skipped: " .. skippedCount)
	return
end

local fullScript = [[local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local buildString = ]] .. string.format("%q", buildString) .. [[

local SymbolToMaterial = {
	["!"] = Enum.Material.SmoothPlastic,
	["@"] = Enum.Material.Plastic,
	["#"] = Enum.Material.CeramicTiles,
	["$"] = Enum.Material.Brick,
	["%"] = Enum.Material.WoodPlanks,
	["^"] = Enum.Material.Ice,
	["&"] = Enum.Material.Grass,
	["*"] = Enum.Material.Sand,
	["("] = Enum.Material.Snow,
	[")"] = Enum.Material.Glass,
	["-"] = Enum.Material.Wood,
	["_"] = Enum.Material.Slate,
	["="] = Enum.Material.Pebble,
	["+"] = Enum.Material.Marble,
	["["] = Enum.Material.Granite,
	["]"] = Enum.Material.DiamondPlate,
	["{"] = Enum.Material.Metal,
	["}"] = Enum.Material.Asphalt,
	["~"] = Enum.Material.Concrete,
	["`"] = Enum.Material.Pavement,
	["?"] = Enum.Material.Neon
}

local function hexToColor(hex)
	local r = tonumber(hex:sub(1, 2), 16) / 255
	local g = tonumber(hex:sub(3, 4), 16) / 255
	local b = tonumber(hex:sub(5, 6), 16) / 255
	return Color3.new(r, g, b)
end

local function equipAllTools()
	for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
		if v:IsA("Tool") then
			v.Parent = LocalPlayer.Character
		end
	end
end

local function findBuildTools()
	local tools = {}
	
	if LocalPlayer.Character then
		for _, item in pairs(LocalPlayer.Character:GetChildren()) do
			if item:IsA("Tool") and item.Name == "Build" then
				local script = item:FindFirstChild("Script")
				local remote = script and script:FindFirstChild("Event")
				if remote then
					table.insert(tools, {bt = item, e = remote})
				end
			end
		end
	end
	
	for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
		if item:IsA("Tool") and item.Name == "Build" then
			local script = item:FindFirstChild("Script")
			local remote = script and script:FindFirstChild("Event")
			if remote then
				table.insert(tools, {bt = item, e = remote})
			end
		end
	end
	
	return tools
end

local function getShapeEvent()
	if LocalPlayer.Character then
		for _, item in pairs(LocalPlayer.Character:GetChildren()) do
			if item:IsA("Tool") and item.Name == "Shape" then
				local script = item:FindFirstChild("Script")
				if script and script:FindFirstChild("Event") then
					return script.Event
				end
			end
		end
	end
	
	for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
		if item:IsA("Tool") and item.Name == "Shape" then
			local script = item:FindFirstChild("Script")
			if script and script:FindFirstChild("Event") then
				return script.Event
			end
		end
	end
	
	return nil
end

local visualFolder = Instance.new("Folder")
visualFolder.Name = "BuildPreview"
visualFolder.Parent = workspace

local blocks = {}
for blockData in buildString:gmatch("|([^|]+)") do
	local colorHex = blockData:sub(1, 6)
	local materialSymbol = blockData:sub(7, 7)
	local rest = blockData:sub(8)
	
	local canCollide = true
	if rest:sub(1, 1) == "^" then
		canCollide = false
		rest = rest:sub(2)
	end
	
	local sizeData, posData = rest:match("([^%.]+)%.(.+)")
	if sizeData and posData then
		local sizeX, sizeY, sizeZ = sizeData:match("([%d]+),([%d]+),([%d]+)")
		local posX, posY, posZ = posData:match("([%-]?%d+%.?%d*),([%-]?%d+%.?%d*),([%-]?%d+%.?%d*)")
		
		if sizeX and posX then
			local size = Vector3.new(tonumber(sizeX), tonumber(sizeY), tonumber(sizeZ))
			local position = Vector3.new(tonumber(posX), tonumber(posY), tonumber(posZ))
			
			local preview = Instance.new("Part")
			preview.Name = "PreviewBlock"
			preview.Size = size
			preview.Anchored = true
			preview.CanCollide = false
			preview.CFrame = CFrame.new(position)
			preview.Material = SymbolToMaterial[materialSymbol] or Enum.Material.SmoothPlastic
			preview.Color = hexToColor(colorHex)
			preview.Transparency = 0.5
			preview.Parent = visualFolder
			
			table.insert(blocks, {
				size = size,
				position = position,
				preview = preview,
				needsResize = (size ~= Vector3.new(4, 4, 4)),
				resized = false
			})
		end
	end
end

print("Loaded " .. #blocks .. " blocks")

-- Equip all tools at start
equipAllTools()
task.wait(0.3)

local btools = findBuildTools()
if #btools == 0 then
	warn("No build tools found!")
	return
end

print("Found " .. #btools .. " build tools")

local bti = 0
local bricksFolder = workspace:FindFirstChild("Bricks")
local playerFolder = bricksFolder and bricksFolder:FindFirstChild(LocalPlayer.Name)

local positionLock = nil

local function lockPosition(targetPos)
	if positionLock then
		positionLock:Disconnect()
	end
	
	positionLock = RunService.RenderStepped:Connect(function()
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
			LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(targetPos)
			LocalPlayer.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end
	end)
end

local function checkBlockExists(blockData)
	if not playerFolder then
		playerFolder = bricksFolder and bricksFolder:FindFirstChild(LocalPlayer.Name)
	end
	
	if not playerFolder then
		return false, nil
	end
	
	for _, brick in pairs(playerFolder:GetChildren()) do
		if brick:IsA("BasePart") and brick.Name == "Brick" then
			local halfSize = blockData.size / 2
			local minBounds = blockData.position - halfSize
			local maxBounds = blockData.position + halfSize
			
			local brickPos = brick.Position
			
			local insideX = brickPos.X >= minBounds.X and brickPos.X <= maxBounds.X
			local insideY = brickPos.Y >= minBounds.Y and brickPos.Y <= maxBounds.Y
			local insideZ = brickPos.Z >= minBounds.Z and brickPos.Z <= maxBounds.Z
			
			if insideX and insideY and insideZ then
				return true, brick
			end
		end
	end
	
	return false, nil
end

-- Keep all tools equipped loop
task.spawn(function()
	while true do
		equipAllTools()
		task.wait(1)
	end
end)

-- BUILD LOOP
task.spawn(function()
	print("Starting auto-build...")
	
	for i, blockData in ipairs(blocks) do
		local abovePos = blockData.position + Vector3.new(0, 12, 0)
		lockPosition(abovePos)
		task.wait(0.1)
		
		local maxAttempts = 50
		local attempts = 0
		
		while attempts < maxAttempts do
			local exists, brick = checkBlockExists(blockData)
			if exists then
				blockData.placedBrick = brick
				break
			end
			
			bti = bti + 1
			local bt = btools[(bti % #btools) + 1]
			
			local buildMode = "normal"
			local placePos = blockData.position
			
			if blockData.size ~= Vector3.new(4, 4, 4) then
				buildMode = "detailed"
			end
			
			pcall(function()
				bt.e:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, buildMode)
			end)
			
			task.wait(0.03)
			attempts = attempts + 1
			
			if attempts % 10 == 0 then
				btools = findBuildTools()
			end
		end
		
		local exists, brick = checkBlockExists(blockData)
		if exists then
			print("✓ Placed block " .. i .. "/" .. #blocks)
			blockData.placedBrick = brick
			if blockData.preview then
				pcall(function()
					blockData.preview:Destroy()
				end)
			end
		else
			print("✗ Failed block " .. i)
		end
	end
	
	if positionLock then
		positionLock:Disconnect()
		positionLock = nil
	end
	
	print("Building complete, starting resize phase...")
end)

-- RESIZE LOOP (separate thread)
task.spawn(function()
	task.wait(2)
	
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		warn("No HumanoidRootPart!")
		return
	end
	
	print("Starting resize phase...")
	
	for i, blockData in ipairs(blocks) do
		if blockData.needsResize and blockData.placedBrick and blockData.placedBrick:IsDescendantOf(workspace) then
			local brick = blockData.placedBrick
			local targetSize = blockData.size
			
			print("Resizing block " .. i .. " to " .. tostring(targetSize))
			
			local attempts = 0
			local maxAttempts = 200
			
			while attempts < maxAttempts do
				local shapeEvent = getShapeEvent()
				if not shapeEvent then
					warn("Shape tool not found!")
					break
				end
				
				local currentSize = brick.Size
				
				if currentSize.X == targetSize.X and currentSize.Y == targetSize.Y and currentSize.Z == targetSize.Z then
					print("✓ Resized block " .. i)
					blockData.resized = true
					break
				end
				
				local diffX = math.abs(currentSize.X - targetSize.X)
				local diffY = math.abs(currentSize.Y - targetSize.Y)
				local diffZ = math.abs(currentSize.Z - targetSize.Z)
				
				if diffX >= diffY and diffX >= diffZ and currentSize.X ~= targetSize.X then
					pcall(function()
						shapeEvent:FireServer(brick, Enum.NormalId.Right, hrp.Position, currentSize.X < targetSize.X and "increase" or "decrease")
					end)
				elseif diffY >= diffZ and currentSize.Y ~= targetSize.Y then
					pcall(function()
						shapeEvent:FireServer(brick, Enum.NormalId.Top, hrp.Position, currentSize.Y < targetSize.Y and "increase" or "decrease")
					end)
				elseif currentSize.Z ~= targetSize.Z then
					pcall(function()
						shapeEvent:FireServer(brick, Enum.NormalId.Back, hrp.Position, currentSize.Z < targetSize.Z and "increase" or "decrease")
					end)
				end
				
				task.wait(0.1)
				attempts = attempts + 1
			end
			
			if attempts >= maxAttempts then
				print("✗ Failed to resize block " .. i)
			end
		end
	end
	
	print("=== ALL COMPLETE ===")
	visualFolder:Destroy()
end)]]

setclipboard(fullScript)
print("Auto-build script copied to clipboard!")
print("Blocks saved: " .. blockCount)
print("Skipped: " .. skippedCount)
print("Execute your clipboard to start auto-building!")
