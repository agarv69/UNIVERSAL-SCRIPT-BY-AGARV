-- Load boombox
_G.boomboxb = game:GetObjects('rbxassetid://740618400')[1]
_G.boomboxb.Parent = game:GetService'Players'.LocalPlayer.Backpack
loadstring(_G.boomboxb.Client.Source)() 
loadstring(_G.boomboxb.Server.Source)()

local Player = game:GetService("Players").LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local RunService = game:GetService("RunService")
local Handle = _G.boomboxb:WaitForChild("Handle")

local radius = 5
local speed = 2
local heightOffset = 0
local angle = 0
local orbitConnection

local function startOrbit()
	if orbitConnection then
		orbitConnection:Disconnect()
	end
	
	local Torso = Character:FindFirstChild("HumanoidRootPart")
	if not Torso then return end
	
	-- Destroy any existing weld
	for _, child in pairs(Handle:GetChildren()) do
		if child:IsA("Weld") then
			child:Destroy()
		end
	end
	
	Handle.Massless = true
	Handle.CanCollide = false
	
	-- Create BodyPosition
	local bp = Instance.new("BodyPosition")
	bp.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	bp.D = 1000
	bp.P = 5000
	bp.Parent = Handle
	
	-- Create BodyGyro
	local bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	bg.P = 5000
	bg.Parent = Handle
	
	-- Orbit loop
	orbitConnection = RunService.RenderStepped:Connect(function()
		if not Handle or not Torso then
			if orbitConnection then
				orbitConnection:Disconnect()
			end
			return
		end
		
		local t = tick()
		local theta = t * speed
		local pos = Torso.Position + Vector3.new(math.cos(theta) * radius, heightOffset, math.sin(theta) * radius)
		
		bp.Position = pos
	end)
end

local function stopOrbit()
	if orbitConnection then
		orbitConnection:Disconnect()
		orbitConnection = nil
	end
	
	-- Clean up BodyMovers
	for _, child in pairs(Handle:GetChildren()) do
		if child:IsA("BodyPosition") or child:IsA("BodyGyro") then
			child:Destroy()
		end
	end
end

_G.boomboxb.Equipped:Connect(function()
	stopOrbit()
end)

_G.boomboxb.Unequipped:Connect(function()
	task.wait(0.1)
	startOrbit()
end)

-- Start orbiting initially
task.wait(0.5)
startOrbit()
