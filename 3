local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local toolsToEquip = {
	"Build",
	"Delete",
	"Paint",
	"Shape",
	"Shovel",
	"Sign"
}

local function shouldEquip(toolName)
	for _, name in pairs(toolsToEquip) do
		if toolName == name then
			return true
		end
	end
	return false
end

local function equipAllTools()
	if not LocalPlayer.Character then return end
	
	-- Move all tools to character at once without humanoid equipping
	for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
		if tool:IsA("Tool") and shouldEquip(tool.Name) then
			-- Directly parent to character (bypasses the equip limit)
			tool.Parent = LocalPlayer.Character
		end
	end
end

-- Equip existing tools
task.wait(0.5)
equipAllTools()

-- Auto-equip when new tools are added to backpack
LocalPlayer.Backpack.ChildAdded:Connect(function(tool)
	if tool:IsA("Tool") and shouldEquip(tool.Name) then
		task.wait(0.05)
		if LocalPlayer.Character then
			tool.Parent = LocalPlayer.Character
		end
	end
end)

-- Re-equip when character respawns
LocalPlayer.CharacterAdded:Connect(function(character)
	task.wait(1.5) -- Wait for backpack to load
	equipAllTools()
end)

-- Keep tools equipped (re-equip if they go back to backpack)
task.spawn(function()
	while task.wait(0.1) do
		if LocalPlayer.Character then
			for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
				if tool:IsA("Tool") and shouldEquip(tool.Name) then
					tool.Parent = LocalPlayer.Character
				end
			end
		end
	end
end)

print("Auto-equip all tools script loaded! All tools will be equipped simultaneously.")
