local function C_6()
local script = G2L["6"];
	-- ServerHopScript (LocalScript under ToggleButton/ToggleScript)
	
	local Players         = game:GetService("Players")
	local TeleportService = game:GetService("TeleportService")
	local HttpService     = game:GetService("HttpService")
	local CoreGui         = game:GetService("CoreGui")
	local LocalPlayer     = Players.LocalPlayer
	
	--------------------------------------------------
	-- AUTO DISMISS FULL SERVER POPUP
	--------------------------------------------------
	
	task.spawn(function()
		while true do
			task.wait(0.5)
			pcall(function()
				for _, gui in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
					if gui:IsA("TextButton") then
						local t = gui.Text:lower()
						if t == "ok" or t == "okay" or t == "close" or t == "leave" then
							gui:activate()
						end
					end
				end
			end)
			pcall(function()
				for _, gui in pairs(CoreGui:GetDescendants()) do
					if gui:IsA("TextButton") then
						local t = gui.Text:lower()
						if t == "ok" or t == "okay" or t == "close" then
							gui:activate()
						end
					end
				end
			end)
		end
	end)
	
	--------------------------------------------------
	-- GET SERVERS
	--------------------------------------------------
	
	local function getServers()
		local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
		local ok, result = pcall(function()
			local body = nil
			if request then
				body = request({Url = url, Method = "GET"}).Body
			else
				body = game:HttpGet(url)
			end
			return HttpService:JSONDecode(body)
		end)
		if ok and result and result.data then
			return result.data
		end
		return {}
	end
	
	--------------------------------------------------
	-- SERVER HOP
	--------------------------------------------------
	
	shared.BotHop = function()
		if not shared.BotEnabled then return end
	
		local ToggleButton   = script.Parent.Parent
		local brokenServers  = shared.BrokenServers  or {}
		local visitedServers = shared.VisitedServers or {}
	
		ToggleButton.Text = "Serverhopping..."
	
		local target = nil
	
		while not target and shared.BotEnabled do
			local servers = getServers()
	
			-- Build set of server ids from API
			local apiServerIds = {}
			for _, s in ipairs(servers) do
				if s.id then
					apiServerIds[s.id] = s
				end
			end
	
			-- Step 1: Find unvisited, non-broken, non-full servers
			local unvisited = {}
			for _, s in ipairs(servers) do
				if s.id
					and s.id ~= game.JobId
					and not brokenServers[s.id]
					and not visitedServers[s.id]
					and s.playing and s.maxPlayers
					and tonumber(s.playing) < tonumber(s.maxPlayers)
				then
					table.insert(unvisited, s)
				end
			end
	
			if #unvisited > 0 then
				target = unvisited[math.random(1, #unvisited)]
			else
				-- Step 2: All servers visited — find oldest visited non-broken non-full server
				local oldest = nil
				local oldestTime = math.huge
	
				for _, s in ipairs(servers) do
					if s.id
						and s.id ~= game.JobId
						and not brokenServers[s.id]
						and s.playing and s.maxPlayers
						and tonumber(s.playing) < tonumber(s.maxPlayers)
					then
						local visitTime = visitedServers[s.id] or math.huge
						if visitTime < oldestTime then
							oldestTime = visitTime
							oldest = s
						end
					end
				end
	
				if oldest then
					target = oldest
				else
					-- No valid servers at all — retry after 30s
					ToggleButton.Text = "No servers found, retrying..."
					task.wait(7)
				end
			end
		end
	
		if not target or not shared.BotEnabled then return end
	
		-- Queue re-execution after teleport
		pcall(function()
			local queueFn = queue_on_teleport
				or (syn and syn.queue_on_teleport)
				or (fluxus and fluxus.queue_on_teleport)
	
			if queueFn then
				queueFn([[
					task.wait(3)
					local ok, code = pcall(function()
						return game:HttpGet("https://pastebin.com/raw/LnAuLdN3")
					end)
					if ok and code then
						loadstring(code)()
					end
					task.wait(1)
					local ok2, code2 = pcall(function()
						return game:HttpGet("https://raw.githubusercontent.com/agarv69/UNIVERSAL-SCRIPT-BY-AGARV/refs/heads/main/bot2")
					end)
					if ok2 and code2 then
						loadstring(code2)()
					end
				]])
			end
		end)
	
		pcall(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, LocalPlayer)
		end)
	
		-- If teleport fails, retry after 10s
		task.wait(10)
		if shared.BotEnabled then
			shared.BotHop()
		end
	end
end;
