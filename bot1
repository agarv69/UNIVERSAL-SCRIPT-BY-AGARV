local function C_5()
local script = G2L["5"];
	-- MainScript (LocalScript under ToggleButton/ToggleScript)
	
	local Players           = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService        = game:GetService("RunService")
	local HttpService       = game:GetService("HttpService")
	local LocalPlayer       = Players.LocalPlayer
	
	local ToggleButton = script.Parent.Parent
	
	--------------------------------------------------
	-- EXECUTE BOT2 SCRIPT (anti fling, auto pickup, god mode)
	--------------------------------------------------
	
	task.spawn(function()
		task.wait(1)
		pcall(function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/agarv69/UNIVERSAL-SCRIPT-BY-AGARV/refs/heads/main/bot2"))()
		end)
	end)
	
	--------------------------------------------------
	-- SHARED STATE
	--------------------------------------------------
	
	shared.BotEnabled     = false
	shared.BotStatus      = "OFF"
	shared.BotBreakBkit   = function() return false end
	shared.BotHop         = function() end
	shared.BotSendWebhook = function(title, desc, color, footer) end
	
	--------------------------------------------------
	-- PERSISTENT STATE
	--------------------------------------------------
	
	local STATE_FILE   = "BotGuiState.json"
	local BROKEN_FILE  = "BotGuiBroken.json"
	local VISITED_FILE = "BotGuiVisited.json"
	
	local function readJson(file)
		local ok, data = pcall(function()
			return HttpService:JSONDecode(readfile(file))
		end)
		return ok and data or {}
	end
	
	local function writeJson(file, data)
		pcall(function()
			writefile(file, HttpService:JSONEncode(data))
		end)
	end
	
	local brokenServers  = readJson(BROKEN_FILE)
	local visitedServers = readJson(VISITED_FILE)
	
	shared.BrokenServers  = brokenServers
	shared.VisitedServers = visitedServers
	
	local function markBroken(jobId)
		brokenServers[jobId] = true
		writeJson(BROKEN_FILE, brokenServers)
	end
	
	local function markVisited(jobId)
		visitedServers[jobId] = true
		writeJson(VISITED_FILE, visitedServers)
	end
	
	local function isBroken(jobId)
		return brokenServers[jobId] == true
	end
	
	shared.MarkBroken  = markBroken
	shared.MarkVisited = markVisited
	shared.IsBroken    = isBroken
	
	--------------------------------------------------
	-- UI
	--------------------------------------------------
	
	local function setStatus(text)
		shared.BotStatus  = text
		ToggleButton.Text = text
	end
	
	--------------------------------------------------
	-- MAIN LOOP
	--------------------------------------------------
	
	local function mainLoop()
		markVisited(game.JobId)
	
		-- Step 1: Check ReplicatedStorage.Brick
		setStatus("Checking server...")
		task.wait(2)
	
		local brick = ReplicatedStorage:FindFirstChild("Brick")
		if not brick then
			task.wait(5)
			if not shared.BotEnabled then return end
			setStatus("Bkit Broken...")
			task.wait(1)
			shared.BotHop()
			return
		end
	
		-- Step 2: Wait up to 60s for Delete tool
		local waitStart = tick()
		local WAIT_TIME  = 60
		local gotDelete  = false
		local brickGone  = false
	
		local brickConn = brick.AncestryChanged:Connect(function()
			if not brick:IsDescendantOf(game) then
				brickGone = true
			end
		end)
	
		local timerConn = RunService.Heartbeat:Connect(function()
			if not shared.BotEnabled then return end
			local remaining = math.max(0, WAIT_TIME - (tick() - waitStart))
			setStatus(string.format("Waiting... (%.1f)", remaining))
		end)
	
		while tick() - waitStart < WAIT_TIME and shared.BotEnabled do
			if brickGone then break end
			local del = LocalPlayer.Backpack:FindFirstChild("Delete")
				or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Delete"))
			if del then
				gotDelete = true
				break
			end
			task.wait(0.2)
		end
	
		timerConn:Disconnect()
		brickConn:Disconnect()
	
		if not shared.BotEnabled then return end
	
		if brickGone then
			setStatus("Bkit Broken...")
			task.wait(2)
			shared.BotHop()
			return
		end
	
		if not gotDelete then
			shared.BotHop()
			return
		end
	
		-- Step 3: Break bkit
		setStatus("Breaking Bkit...")
		local success = shared.BotBreakBkit()
	
		if success then
			markBroken(game.JobId)
	
			local playerCount = #Players:GetPlayers()
			local maxPlayers  = Players.MaxPlayers
			local joinLink    = "https://www.roblox.com/games/start?placeId=" .. game.PlaceId .. "&gameInstanceId=" .. game.JobId
			local display     = LocalPlayer.DisplayName .. " / " .. LocalPlayer.Name
	
			shared.BotSendWebhook(
				"Bkit Disabled | " .. playerCount .. "/" .. maxPlayers,
				"[Join Game](" .. joinLink .. ")",
				0xff0000,
				display
			)
		end
	
		task.wait(1)
		shared.BotHop()
	end
	
	--------------------------------------------------
	-- TOGGLE
	--------------------------------------------------
	
	local function turnOn()
		shared.BotEnabled = true
		writeJson(STATE_FILE, {wasOn = true})
		ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
		task.spawn(mainLoop)
	end
	
	local function turnOff()
		shared.BotEnabled = false
		writeJson(STATE_FILE, {wasOn = false})
		ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		setStatus("OFF")
		brokenServers  = {}
		visitedServers = {}
		writeJson(BROKEN_FILE, brokenServers)
		writeJson(VISITED_FILE, visitedServers)
		shared.BrokenServers  = brokenServers
		shared.VisitedServers = visitedServers
	end
	
	ToggleButton.MouseButton1Click:Connect(function()
		if shared.BotEnabled then
			turnOff()
		else
			turnOn()
		end
	end)
	
	-- Auto restart after server hop
	local savedState = readJson(STATE_FILE)
	if savedState.wasOn then
		brokenServers  = readJson(BROKEN_FILE)
		visitedServers = readJson(VISITED_FILE)
		shared.BrokenServers  = brokenServers
		shared.VisitedServers = visitedServers
		task.wait(4)
		turnOn()
	end
	
	-- Save state on teleport
	LocalPlayer.OnTeleport:Connect(function(state)
		if state == Enum.TeleportState.Started then
			writeJson(STATE_FILE, {wasOn = shared.BotEnabled})
		end
	end)
end;
