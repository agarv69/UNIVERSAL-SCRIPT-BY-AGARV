	-- BkitBreakScript (LocalScript under ToggleButton/ToggleScript)
	
	local Players           = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local LocalPlayer       = Players.LocalPlayer
	
	shared.BotBreakBkit = function()
		local character = LocalPlayer.Character
		if not character then return false end
	
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then return false end
	
		local deleteTool = LocalPlayer.Backpack:FindFirstChild("Delete")
			or character:FindFirstChild("Delete")
		if not deleteTool then return false end
	
		local brick = ReplicatedStorage:FindFirstChild("Brick")
		if not brick then return false end
	
		local ok = pcall(function()
			humanoid:EquipTool(deleteTool)
			task.wait(0.1)
			local event = deleteTool:WaitForChild("Script"):WaitForChild("Event")
			event:FireServer(brick, character.HumanoidRootPart.Position)
			task.wait(0.1)
			humanoid:UnequipTools()
		end)
	
		return ok
	end
end;
