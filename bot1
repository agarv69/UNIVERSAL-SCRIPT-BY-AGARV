-- StarterGui.BotGui.ToggleButton.ToggleScript.ServerHopScript
local function C_7()
local script = G2L["7"];
	-- ServerHopScript (LocalScript under ToggleButton/ToggleScript)
	
	local Players         = game:GetService("Players")
	local TeleportService = game:GetService("TeleportService")
	local HttpService     = game:GetService("HttpService")
	local LocalPlayer     = Players.LocalPlayer
	
	local function getServers()
		local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
		local ok, result = pcall(function()
			local body = nil
			if request then
				body = request({Url = url, Method = "GET"}).Body
			else
				body = game:HttpGet(url)
			end
			return HttpService:JSONDecode(body)
		end)
		if ok and result and result.data then
			return result.data
		end
		return {}
	end
	
	shared.BotHop = function()
		if not shared.BotEnabled then return end
	
		local ToggleButton = script.Parent.Parent
		ToggleButton.Text = "Serverhopping..."
	
		local servers       = getServers()
		local brokenServers  = shared.BrokenServers  or {}
		local visitedServers = shared.VisitedServers or {}
	
		-- Find a non-full, non-broken, non-current server
		local candidates = {}
		for _, s in ipairs(servers) do
			if s.id
				and s.id ~= game.JobId
				and not brokenServers[s.id]
				and s.playing and s.maxPlayers
				and tonumber(s.playing) < tonumber(s.maxPlayers)
			then
				table.insert(candidates, s)
			end
		end
	
		-- Fallback: visited servers that aren't broken and aren't current
		if #candidates == 0 then
			for jobId, _ in pairs(visitedServers) do
				if not brokenServers[jobId] and jobId ~= game.JobId then
					table.insert(candidates, {id = jobId})
				end
			end
		end
	
		if #candidates == 0 then
			ToggleButton.Text = "No servers found"
			return
		end
	
		local target = candidates[1]
	
		-- Queue re-execution after teleport
		pcall(function()
			local queueFn = queue_on_teleport
				or (syn and syn.queue_on_teleport)
				or (fluxus and fluxus.queue_on_teleport)
	
			if queueFn then
				queueFn([[
					task.wait(3)
					local ok, code = pcall(function()
						return game:HttpGet("https://pastebin.com/raw/LnAuLdN3")
					end)
					if ok and code then
						loadstring(code)()
					end
					task.wait(1)
					local ok2, code2 = pcall(function()
						return game:HttpGet("https://raw.githubusercontent.com/agarv69/UNIVERSAL-SCRIPT-BY-AGARV/refs/heads/main/bot2")
					end)
					if ok2 and code2 then
						loadstring(code2)()
					end
				]])
			end
		end)
	
		pcall(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, LocalPlayer)
		end)
	end
end;
