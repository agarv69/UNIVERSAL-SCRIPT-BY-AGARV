local script = G2L["5"];
	-- MainScript (LocalScript under ToggleButton/ToggleScript)
	
	local Players           = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService        = game:GetService("RunService")
	local HttpService       = game:GetService("HttpService")
	local TextChatService   = game:GetService("TextChatService")
	local LocalPlayer       = Players.LocalPlayer
	
	local ToggleButton = script.Parent.Parent
	
	pcall(function() writefile("BotGuiBroken.json", "{}") end)
	
	task.wait(0.5)
	
	--------------------------------------------------
	-- EXECUTE BOT2 SCRIPT
	--------------------------------------------------
	
	task.spawn(function()
		task.wait(0.5)
		pcall(function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/agarv69/UNIVERSAL-SCRIPT-BY-AGARV/refs/heads/main/bot2"))()
		end)
	end)
	
	--------------------------------------------------
	-- CHAT FUNCTION
	--------------------------------------------------
	
	local function sendChat(message)
		pcall(function()
			local channels = TextChatService:WaitForChild("TextChannels", 2)
			if channels then
				local general = channels:FindFirstChild("RBXGeneral")
				if general then
					general:SendAsync(message)
					return
				end
			end
			local rs = game:GetService("ReplicatedStorage")
			local chatEvents = rs:WaitForChild("DefaultChatSystemChatEvents", 2)
			if chatEvents then
				local sayMessage = chatEvents:WaitForChild("SayMessageRequest", 2)
				if sayMessage then
					sayMessage:FireServer(message, "All")
				end
			end
		end)
	end
	
	--------------------------------------------------
	-- SHARED STATE
	--------------------------------------------------
	
	shared.BotEnabled     = false
	shared.BotStatus      = "OFF"
	shared.BotBreakBkit   = function() return false end
	shared.BotHop         = function() end
	shared.BotSendWebhook = function(title, desc, color, footer) end
	shared.BotSendChat    = sendChat
	
	--------------------------------------------------
	-- PERSISTENT STATE
	--------------------------------------------------
	
	local STATE_FILE   = "BotGuiState.json"
	local BROKEN_FILE  = "BotGuiBroken.json"
	local VISITED_FILE = "BotGuiVisited.json"
	
	local function readJson(file)
		local ok, data = pcall(function()
			return HttpService:JSONDecode(readfile(file))
		end)
		return ok and data or {}
	end
	
	local function writeJson(file, data)
		pcall(function()
			writefile(file, HttpService:JSONEncode(data))
		end)
	end
	
	local brokenServers  = readJson(BROKEN_FILE)
	local visitedServers = readJson(VISITED_FILE)
	
	shared.BrokenServers  = brokenServers
	shared.VisitedServers = visitedServers
	
	local visitCounter = 0
	
	local function markBroken(jobId)
		brokenServers[jobId] = true
		writeJson(BROKEN_FILE, brokenServers)
		shared.BrokenServers = brokenServers
	end
	
	local function markVisited(jobId)
		if not visitedServers[jobId] then
			visitCounter = visitCounter + 1
			visitedServers[jobId] = visitCounter
			writeJson(VISITED_FILE, visitedServers)
			shared.VisitedServers = visitedServers
		end
	end
	
	local function isBroken(jobId)
		return brokenServers[jobId] == true
	end
	
	shared.MarkBroken  = markBroken
	shared.MarkVisited = markVisited
	shared.IsBroken    = isBroken
	
	--------------------------------------------------
	-- UI
	--------------------------------------------------
	
	local function setStatus(text)
		shared.BotStatus  = text
		ToggleButton.Text = text
	end
	
	--------------------------------------------------
	-- ARKENSTONE WATCHER
	--------------------------------------------------
	
	local arkestoneDetected = false
	
	local function watchArkenstone(onDetected)
		arkestoneDetected = false
	
		local function checkAndHandle()
			if arkestoneDetected then return end
			local backpack   = LocalPlayer:FindFirstChild("Backpack")
			local char       = LocalPlayer.Character
			local inBackpack = backpack and backpack:FindFirstChild("The Arkenstone")
			local inChar     = char and char:FindFirstChild("The Arkenstone")
			local arken      = inBackpack or inChar
			if not arken then return end
	
			arkestoneDetected = true
	
			task.spawn(function()
				pcall(function()
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local ark = LocalPlayer.Backpack:FindFirstChild("The Arkenstone")
						or (char and char:FindFirstChild("The Arkenstone"))
					if hum and ark then
						hum:EquipTool(ark)
					end
				end)
				task.wait(0.5)
				sendChat(";bkit")
			end)
	
			onDetected()
		end
	
		local connections = {}
	
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			table.insert(connections, backpack.ChildAdded:Connect(function(child)
				if child.Name == "The Arkenstone" then
					checkAndHandle()
				end
			end))
		end
	
		local char = LocalPlayer.Character
		if char then
			table.insert(connections, char.ChildAdded:Connect(function(child)
				if child.Name == "The Arkenstone" then
					checkAndHandle()
				end
			end))
		end
	
		checkAndHandle()
	
		return connections
	end
	
	--------------------------------------------------
	-- MAIN LOOP
	--------------------------------------------------
	
	local function mainLoop()
		markVisited(game.JobId)
	
		setStatus("Checking server...")
		task.wait(2)
	
		local brick = ReplicatedStorage:FindFirstChild("Brick")
		if not brick then
			task.wait(5)
			if not shared.BotEnabled then return end
			setStatus("Bkit Broken...")
			task.wait(1)
			shared.BotHop()
			return
		end
	
		local waitStart = tick()
		local WAIT_TIME = 60
		local gotDelete = false
		local brickGone = false
		local arkConns  = {}
	
		local brickConn = brick.AncestryChanged:Connect(function()
			if not brick:IsDescendantOf(game) then
				brickGone = true
			end
		end)
	
		arkConns = watchArkenstone(function() end)
	
		local timerConn = RunService.Heartbeat:Connect(function()
			if not shared.BotEnabled then return end
			local remaining = math.max(0, WAIT_TIME - (tick() - waitStart))
			setStatus(string.format("Waiting for Delete tool... (%.1f)", remaining))
		end)
	
		while tick() - waitStart < WAIT_TIME and shared.BotEnabled do
			if brickGone then break end
			local del = LocalPlayer.Backpack:FindFirstChild("Delete")
				or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Delete"))
			if del then
				gotDelete = true
				break
			end
			task.wait(0.2)
		end
	
		timerConn:Disconnect()
		brickConn:Disconnect()
		for _, c in ipairs(arkConns) do
			pcall(function() c:Disconnect() end)
		end
	
		if not shared.BotEnabled then return end
	
		if brickGone then
			setStatus("Bkit Broken...")
			task.wait(2)
			shared.BotHop()
			return
		end
	
		if not gotDelete then
			shared.BotHop()
			return
		end
	
		setStatus("Breaking Bkit...")
		local success = shared.BotBreakBkit()
	
		if success then
			markBroken(game.JobId)
	
			local playerCount = #Players:GetPlayers()
			local maxPlayers  = Players.MaxPlayers
			local joinLink    = "https://www.roblox.com/games/start?placeId=" .. game.PlaceId .. "&gameInstanceId=" .. game.JobId
			local display     = LocalPlayer.DisplayName .. " / " .. LocalPlayer.Name
	
			shared.BotSendWebhook(
				"Bkit Disabled | " .. playerCount .. "/" .. maxPlayers,
				"[Join Game](" .. joinLink .. ")",
				0xff0000,
				display
			)
		end
	
		task.wait(1)
		shared.BotHop()
	end
	
	--------------------------------------------------
	-- TOGGLE
	--------------------------------------------------
	
	local function turnOn()
		shared.BotEnabled = true
		writeJson(STATE_FILE, {wasOn = true})
		ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
		task.spawn(mainLoop)
	end
	
	local function turnOff()
		shared.BotEnabled = false
		writeJson(STATE_FILE, {wasOn = false})
		ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		setStatus("OFF")
		brokenServers  = {}
		visitedServers = {}
		writeJson(BROKEN_FILE, brokenServers)
		writeJson(VISITED_FILE, visitedServers)
		shared.BrokenServers  = brokenServers
		shared.VisitedServers = visitedServers
	end
	
	ToggleButton.MouseButton1Click:Connect(function()
		if shared.BotEnabled then
			turnOff()
		else
			turnOn()
		end
	end)
	
	-- Auto restart after server hop
	local savedState = readJson(STATE_FILE)
	if savedState.wasOn then
		brokenServers  = readJson(BROKEN_FILE)
		visitedServers = readJson(VISITED_FILE)
		shared.BrokenServers  = brokenServers
		shared.VisitedServers = visitedServers
		task.wait(4)
		turnOn()
	end
	
	-- Save state on teleport
	LocalPlayer.OnTeleport:Connect(function(state)
		if state == Enum.TeleportState.Started then
			writeJson(STATE_FILE, {wasOn = shared.BotEnabled})
		end
	end)
end;
