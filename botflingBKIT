-- AUTO PAINT (WHEN PAINT TOOL DETECTED)
--------------------------------------------------
local processedPaintTools = {}
local justPickedUpPaint = {}

-- Track tools picked up from workspace
task.spawn(function()
	while true do
		task.wait(0.1)
		for _, obj in ipairs(workspace:GetChildren()) do
			if obj:IsA("Tool") and obj.Name == "Paint" and obj:FindFirstChild("Handle") then
				justPickedUpPaint[obj] = true
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.1)

		-- Check if Brick exists first
		local brick = ReplicatedStorage:FindFirstChild("Brick")
		if not brick then
			task.wait(0.5)
			continue
		end

		-- Check if Paint tool exists in backpack
		local paintTool = LocalPlayer.Backpack:FindFirstChild("Paint")
		if paintTool and not processedPaintTools[paintTool] then
			processedPaintTools[paintTool] = true

			-- Wait if this tool was just picked up from workspace
			if justPickedUpPaint[paintTool] then
				task.wait(0.5)
				justPickedUpPaint[paintTool] = nil
			end

			isProcessingPaint = true
			cancelPaint = false

			task.spawn(function()
				pcall(function()
					local character = LocalPlayer.Character
					if not character then return end
					local humanoid = character:FindFirstChild("Humanoid")
					if not humanoid then return end

					-- Save currently equipped tool
					local previousTool = character:FindFirstChildOfClass("Tool")
					if previousTool and previousTool.Name == "Paint" then
						previousTool = nil
					end

					-- Equip Paint tool
					humanoid:EquipTool(paintTool)
					task.wait(0.1)

					-- Get the event from the equipped tool
					local paintEvent = paintTool:WaitForChild("Script"):WaitForChild("Event")

					local blueColor = Color3.fromRGB(0, 0, 255)
					local whiteColor = Color3.fromRGB(255, 255, 255)
					local sprayText = "MONKEY GANG"

					local sides = {
						Enum.NormalId.Front,
						Enum.NormalId.Right,
						Enum.NormalId.Back,
						Enum.NormalId.Left,
						Enum.NormalId.Top,
						Enum.NormalId.Bottom
					}

					-- Paint all 6 sides blue
					for i, side in ipairs(sides) do
						if cancelPaint then break end
						pcall(function()
							paintEvent:FireServer(brick, side, brick.Position, "both 🤝", blueColor, "", "")
						end)
						task.wait(0.05)
					end

					if not cancelPaint then
						-- Apply Smooth material
						pcall(function()
							paintEvent:FireServer(brick, Enum.NormalId.Top, brick.Position, "material", blueColor, "Smooth", "")
						end)
						task.wait(0.1)
					end

					-- Clear old spray first
					for i, side in ipairs(sides) do
						if cancelPaint then break end
						for retry = 1, 2 do
							pcall(function()
								paintEvent:FireServer(brick, side, brick.Position, "both 🤝", blueColor, "spray", "")
							end)
							task.wait(0.03)
						end
					end

					-- Apply spray text
					if not cancelPaint then
						for i, side in ipairs(sides) do
							if cancelPaint then break end
							for retry = 1, 2 do
								pcall(function()
									paintEvent:FireServer(brick, side, brick.Position, "both 🤝", whiteColor, "spray", sprayText)
								end)
								task.wait(0.03)
							end
						end
					end

					-- Unanchor the brick
					if not cancelPaint then
						-- Clear spray on Top side first
						pcall(function()
							paintEvent:FireServer(brick, Enum.NormalId.Top, brick.Position, "both 🤝", blueColor, "spray", "")
						end)
						task.wait(0.1)

						-- Unanchor
						pcall(function()
							paintEvent:FireServer(brick, Enum.NormalId.Top, brick.Position, "material", Color3.new(0, 0, 0), "anchor", "")
						end)
						task.wait(0.1)

						-- Re-apply spray on Top side
						pcall(function()
							paintEvent:FireServer(brick, Enum.NormalId.Top, brick.Position, "both 🤝", whiteColor, "spray", sprayText)
						end)
						task.wait(0.05)
					end

					task.wait(0.1)

					-- Unequip Paint tool
					humanoid:UnequipTools()

					task.wait(0.2)

					isProcessingPaint = false
					cancelPaint = false

					-- Re-equip previous tool if there was one
					if previousTool and previousTool.Parent == LocalPlayer.Backpack then
						humanoid:EquipTool(previousTool)
					end
				end)

				if not pcall(function() end) then
					isProcessingPaint = false
					cancelPaint = false
				end
			end)
		end

		-- Clean up table for tools that no longer exist
		for tool, _ in pairs(processedPaintTools) do
			if not tool or not tool.Parent then
				processedPaintTools[tool] = nil
			end
		end
	end
end)

