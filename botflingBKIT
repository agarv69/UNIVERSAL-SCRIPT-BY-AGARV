local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local isProcessingDelete = false
local isProcessingPaint = false
local isProcessingArkenstone = false
local cancelPaint = false

local function sendChat(message)
	pcall(function()
		local channels = TextChatService:WaitForChild("TextChannels", 2)
		if channels then
			local general = channels:FindFirstChild("RBXGeneral")
			if general then
				general:SendAsync(message)
				return
			end
		end
		local chatEvents = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 2)
		if chatEvents then
			local sayMessage = chatEvents:WaitForChild("SayMessageRequest", 2)
			if sayMessage then
				sayMessage:FireServer(message, "All")
			end
		end
	end)
end

task.spawn(function()
	while true do
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildWhichIsA("Humanoid")
		if hum and hum.Health > 0 and not isProcessingDelete and not isProcessingPaint and not isProcessingArkenstone then
			local currentlyEquipped = char:FindFirstChildOfClass("Tool")
			for _, obj in ipairs(workspace:GetChildren()) do
				if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
					pcall(function()
						hum:EquipTool(obj)
						task.wait(0.05)
						for i = 1, 3 do
							if obj.Parent == char then
								obj.Parent = LocalPlayer.Backpack
							end
							task.wait(0.02)
						end
						if currentlyEquipped and currentlyEquipped.Parent == LocalPlayer.Backpack then
							task.wait(0.03)
							hum:EquipTool(currentlyEquipped)
						end
					end)
				end
			end
		end
		task.wait(0.1)
	end
end)

local processedDeleteTools = {}
local justPickedUpDelete = {}

task.spawn(function()
	while true do
		task.wait(0.1)
		for _, obj in ipairs(workspace:GetChildren()) do
			if obj:IsA("Tool") and obj.Name == "Delete" and obj:FindFirstChild("Handle") then
				justPickedUpDelete[obj] = true
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.1)

		local brick = ReplicatedStorage:FindFirstChild("Brick")
		if not brick then
			task.wait(0.5)
			continue
		end

		local deleteTool = LocalPlayer.Backpack:FindFirstChild("Delete")
		if deleteTool and not processedDeleteTools[deleteTool] then
			processedDeleteTools[deleteTool] = true

			if isProcessingPaint then
				cancelPaint = true
				while isProcessingPaint do
					task.wait(0.1)
				end
			end

			if justPickedUpDelete[deleteTool] then
				task.wait(0.5)
				justPickedUpDelete[deleteTool] = nil
			end

			isProcessingDelete = true

			task.spawn(function()
				pcall(function()
					local character = LocalPlayer.Character
					if not character then return end
					local humanoid = character:FindFirstChild("Humanoid")
					if not humanoid then return end

					local previousTool = character:FindFirstChildOfClass("Tool")
					if previousTool and previousTool.Name == "Delete" then
						previousTool = nil
					end

					humanoid:EquipTool(deleteTool)
					task.wait(0.1)

					local event = deleteTool:WaitForChild("Script"):WaitForChild("Event")

					local startTime = tick()
					while tick() - startTime < 1 do
						event:FireServer(brick, character.HumanoidRootPart.Position)
						task.wait(0.05)
					end

					task.wait(0.1)

					humanoid:UnequipTools()

					task.wait(0.2)

					sendChat("EZ BKIT HACK")

					isProcessingDelete = false

					if previousTool and previousTool.Parent == LocalPlayer.Backpack then
						humanoid:EquipTool(previousTool)
					end
				end)
			end)
		end

		for tool, _ in pairs(processedDeleteTools) do
			if not tool or not tool.Parent then
				processedDeleteTools[tool] = nil
			end
		end
	end
end)

