local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- AUTO PICKUP
--------------------------------------------------
task.spawn(function()
	while true do
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildWhichIsA("Humanoid")
		if hum and hum.Health > 0 then
			local currentlyEquipped = char:FindFirstChildOfClass("Tool")
			for _, obj in ipairs(workspace:GetChildren()) do
				if obj:IsA("Tool") and obj:FindFirstChild("Handle") and obj.Name ~= "Delete" then
					pcall(function()
						hum:EquipTool(obj)
						task.wait(0.05)
						for i = 1, 3 do
							if obj.Parent == char then
								obj.Parent = LocalPlayer.Backpack
							end
							task.wait(0.02)
						end
						if currentlyEquipped and currentlyEquipped.Parent == LocalPlayer.Backpack then
							task.wait(0.03)
							hum:EquipTool(currentlyEquipped)
						end
					end)
				end
			end
		end
		task.wait(0.1)
	end
end)

--------------------------------------------------
-- AUTO BKIT BREAK (WHEN DELETE TOOL DETECTED)
--------------------------------------------------
local processedTools = {}

task.spawn(function()
	while true do
		task.wait(0.1)
		
		-- Check if Delete tool exists in backpack
		local deleteTool = LocalPlayer.Backpack:FindFirstChild("Delete")
		if deleteTool and not processedTools[deleteTool] then
			processedTools[deleteTool] = true
			
			task.spawn(function()
				pcall(function()
					local character = LocalPlayer.Character
					if not character then return end
					local humanoid = character:FindFirstChild("Humanoid")
					if not humanoid then return end
					
					-- Save currently equipped tool
					local previousTool = character:FindFirstChildOfClass("Tool")
					
					-- Equip Delete tool
					humanoid:EquipTool(deleteTool)
					task.wait(0.1)
					
					-- Get the event from the equipped tool
					local event = deleteTool:WaitForChild("Script"):WaitForChild("Event")
					
					-- Get Brick from ReplicatedStorage
					local rs = game:GetService("ReplicatedStorage")
					local brick = rs:FindFirstChild("Brick")
					if not brick then 
						humanoid:UnequipTools()
						return 
					end
					
					-- Spam fire delete event for 1 second
					local startTime = tick()
					while tick() - startTime < 1 do
						event:FireServer(brick, character.HumanoidRootPart.Position)
						task.wait(0.05)
					end
					
					task.wait(0.1)
					
					-- Unequip Delete tool
					humanoid:UnequipTools()
					
					task.wait(0.1)
					
					-- Re-equip previous tool if there was one
					if previousTool and previousTool.Parent == LocalPlayer.Backpack and previousTool.Name ~= "Delete" then
						humanoid:EquipTool(previousTool)
					end
				end)
			end)
		end
		
		-- Clean up table for tools that no longer exist
		for tool, _ in pairs(processedTools) do
			if not tool or not tool.Parent then
				processedTools[tool] = nil
			end
		end
	end
end)
